From de0e70f6c592783c9b59db047d3c5ea2ba4c9211 Mon Sep 17 00:00:00 2001
From: Dong Chenchen <superdcc97@163.com>
Date: Fri, 24 Jul 2026 16:00:24 +0800
Subject: [PATCH 06/18] mm: account file VMAs independently of i_mmap layout

A sharding conversion removes the last VMA from the central interval tree
before it can publish the new roots. A lockless mapping_mapped() query in
that window must not conclude that the mapping has no users.

Maintain a VMA count from the first regular i_mmap insertion and consult
it before the central tree. Temporary remove and reinsert operations leave
the count unchanged, as will a later tree migration. Configurations without
i_mmap sharding retain the existing tree-only check.

Signed-off-by: Dong Chenchen <superdcc97@163.com>
---
 include/linux/fs.h | 24 ++++++++++++++++++++++++
 mm/mmap.c          |  1 +
 mm/vma.c           |  2 ++
 3 files changed, 27 insertions(+)

diff --git a/include/linux/fs.h b/include/linux/fs.h
index c284c8029dd4..42210d6a9c55 100644
--- a/include/linux/fs.h
+++ b/include/linux/fs.h
@@ -616,11 +616,35 @@ static inline void i_mmap_assert_write_locked(struct address_space *mapping)
 	lockdep_assert_held_write(&mapping->i_mmap_rwsem);
 }
 
+#ifdef CONFIG_I_MMAP_SHARDS
+static inline void i_mmap_vma_count_add(struct address_space *mapping)
+{
+	atomic_inc(&mapping->i_mmap_nr_vmas);
+}
+
+static inline void i_mmap_vma_count_sub(struct address_space *mapping)
+{
+	atomic_dec(&mapping->i_mmap_nr_vmas);
+}
+#else
+static inline void i_mmap_vma_count_add(struct address_space *mapping)
+{
+}
+
+static inline void i_mmap_vma_count_sub(struct address_space *mapping)
+{
+}
+#endif
+
 /*
  * Might pages of this file be mapped into userspace?
  */
 static inline int mapping_mapped(const struct address_space *mapping)
 {
+#ifdef CONFIG_I_MMAP_SHARDS
+	if (atomic_read(&mapping->i_mmap_nr_vmas) > 0)
+		return true;
+#endif
 	return	!RB_EMPTY_ROOT(&mapping->i_mmap.rb_root);
 }
 
diff --git a/mm/mmap.c b/mm/mmap.c
index 721af82b5fa4..866fa476bac4 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -1795,6 +1795,7 @@ static void dup_mmap_file_batch_flush(struct dup_mmap_file_batch *batch)
 			mapping_allow_writable(mapping);
 		vma_interval_tree_insert_after(batch->vmas[i], batch->prev[i],
 					       &mapping->i_mmap);
+		i_mmap_vma_count_add(mapping);
 	}
 	flush_dcache_mmap_unlock(mapping);
 	i_mmap_unlock_write(mapping);
diff --git a/mm/vma.c b/mm/vma.c
index 2bf0545c507d..0981c10633ab 100644
--- a/mm/vma.c
+++ b/mm/vma.c
@@ -225,6 +225,7 @@ static void __vma_link_file(struct vm_area_struct *vma,
 
 	flush_dcache_mmap_lock(mapping);
 	vma_interval_tree_insert(vma, &mapping->i_mmap);
+	i_mmap_vma_count_add(mapping);
 	flush_dcache_mmap_unlock(mapping);
 }
 
@@ -239,6 +240,7 @@ static void __remove_shared_vm_struct(struct vm_area_struct *vma,
 
 	flush_dcache_mmap_lock(mapping);
 	vma_interval_tree_remove(vma, &mapping->i_mmap);
+	i_mmap_vma_count_sub(mapping);
 	flush_dcache_mmap_unlock(mapping);
 }
 
