From fce87945677ecebb7c025ec754ec80fd57399645 Mon Sep 17 00:00:00 2001
From: Dong Chenchen <superdcc97@163.com>
Date: Fri, 24 Jul 2026 16:12:37 +0800
Subject: [PATCH 12/18] mm/khugepaged: find retractable mappings in all shards

Page-table retraction searches mapping->i_mmap for other VMAs that map
the collapsed file offset. Once the mapping is sharded, a central-only
search can leave stale PTE tables behind.

Move the per-VMA retraction work into the common i_mmap iterator. Preserve
the existing userfaultfd and private-mapping checks while covering every
NUMA-local root under its read lock.

Signed-off-by: Dong Chenchen <superdcc97@163.com>
---
 mm/khugepaged.c | 135 ++++++++++++++++++++++++------------------------
 1 file changed, 67 insertions(+), 68 deletions(-)

diff --git a/mm/khugepaged.c b/mm/khugepaged.c
index 01a5d443ffc5..b88d93989a4c 100644
--- a/mm/khugepaged.c
+++ b/mm/khugepaged.c
@@ -1752,87 +1752,86 @@ static bool file_backed_vma_is_retractable(struct vm_area_struct *vma)
 	return true;
 }
 
-static void retract_page_tables(struct address_space *mapping, pgoff_t pgoff)
+static int retract_page_tables_vma(struct vm_area_struct *vma, void *arg)
 {
-	struct vm_area_struct *vma;
+	pgoff_t pgoff = *(pgoff_t *)arg;
+	struct mmu_notifier_range range;
+	struct mm_struct *mm;
+	unsigned long addr;
+	pmd_t *pmd, pgt_pmd;
+	spinlock_t *pml;
+	spinlock_t *ptl;
+	bool success = false;
 
-	i_mmap_lock_read(mapping);
-	vma_interval_tree_foreach(vma, &mapping->i_mmap, pgoff, pgoff) {
-		struct mmu_notifier_range range;
-		struct mm_struct *mm;
-		unsigned long addr;
-		pmd_t *pmd, pgt_pmd;
-		spinlock_t *pml;
-		spinlock_t *ptl;
-		bool success = false;
-
-		addr = vma->vm_start + ((pgoff - vma->vm_pgoff) << PAGE_SHIFT);
-		if (addr & ~HPAGE_PMD_MASK ||
-		    vma->vm_end < addr + HPAGE_PMD_SIZE)
-			continue;
+	addr = vma->vm_start + ((pgoff - vma->vm_pgoff) << PAGE_SHIFT);
+	if (addr & ~HPAGE_PMD_MASK || vma->vm_end < addr + HPAGE_PMD_SIZE)
+		return 0;
 
-		mm = vma->vm_mm;
-		if (find_pmd_or_thp_or_none(mm, addr, &pmd) != SCAN_SUCCEED)
-			continue;
+	mm = vma->vm_mm;
+	if (find_pmd_or_thp_or_none(mm, addr, &pmd) != SCAN_SUCCEED)
+		return 0;
 
-		if (hpage_collapse_test_exit(mm))
-			continue;
+	if (hpage_collapse_test_exit(mm))
+		return 0;
 
-		if (!file_backed_vma_is_retractable(vma))
-			continue;
+	if (!file_backed_vma_is_retractable(vma))
+		return 0;
 
-		/* PTEs were notified when unmapped; but now for the PMD? */
-		mmu_notifier_range_init(&range, MMU_NOTIFY_CLEAR, 0, mm,
-					addr, addr + HPAGE_PMD_SIZE);
-		mmu_notifier_invalidate_range_start(&range);
+	/* PTEs were notified when unmapped; but now for the PMD? */
+	mmu_notifier_range_init(&range, MMU_NOTIFY_CLEAR, 0, mm, addr,
+				addr + HPAGE_PMD_SIZE);
+	mmu_notifier_invalidate_range_start(&range);
 
-		pml = pmd_lock(mm, pmd);
-		/*
-		 * The lock of new_folio is still held, we will be blocked in
-		 * the page fault path, which prevents the pte entries from
-		 * being set again. So even though the old empty PTE page may be
-		 * concurrently freed and a new PTE page is filled into the pmd
-		 * entry, it is still empty and can be removed.
-		 *
-		 * So here we only need to recheck if the state of pmd entry
-		 * still meets our requirements, rather than checking pmd_same()
-		 * like elsewhere.
-		 */
-		if (check_pmd_state(pmd) != SCAN_SUCCEED)
-			goto drop_pml;
-		ptl = pte_lockptr(mm, pmd);
-		if (ptl != pml)
-			spin_lock_nested(ptl, SINGLE_DEPTH_NESTING);
+	pml = pmd_lock(mm, pmd);
+	/*
+	 * The lock of new_folio is still held, we will be blocked in the page
+	 * fault path, which prevents the pte entries from being set again. So
+	 * even though the old empty PTE page may be concurrently freed and a
+	 * new PTE page is filled into the pmd entry, it is still empty and can
+	 * be removed.
+	 *
+	 * So here we only need to recheck if the state of pmd entry still meets
+	 * our requirements, rather than checking pmd_same() like elsewhere.
+	 */
+	if (check_pmd_state(pmd) != SCAN_SUCCEED)
+		goto drop_pml;
+	ptl = pte_lockptr(mm, pmd);
+	if (ptl != pml)
+		spin_lock_nested(ptl, SINGLE_DEPTH_NESTING);
 
-		/*
-		 * Huge page lock is still held, so normally the page table must
-		 * remain empty; and we have already skipped anon_vma and
-		 * userfaultfd_wp() vmas.  But since the mmap_lock is not held,
-		 * it is still possible for a racing userfaultfd_ioctl() or
-		 * madvise() to have inserted ptes or markers.  Now that we hold
-		 * ptlock, repeating the retractable checks protects us from
-		 * races against the prior checks.
-		 */
-		if (likely(file_backed_vma_is_retractable(vma))) {
-			pgt_pmd = pmdp_collapse_flush(vma, addr, pmd);
-			pmdp_get_lockless_sync();
-			success = true;
-		}
+	/*
+	 * Huge page lock is still held, so normally the page table must remain
+	 * empty; and we have already skipped anon_vma and userfaultfd_wp()
+	 * vmas. But since the mmap_lock is not held, it is still possible for a
+	 * racing userfaultfd_ioctl() or madvise() to have inserted ptes or
+	 * markers. Now that we hold ptlock, repeating the retractable checks
+	 * protects us from races against the prior checks.
+	 */
+	if (likely(file_backed_vma_is_retractable(vma))) {
+		pgt_pmd = pmdp_collapse_flush(vma, addr, pmd);
+		pmdp_get_lockless_sync();
+		success = true;
+	}
 
-		if (ptl != pml)
-			spin_unlock(ptl);
+	if (ptl != pml)
+		spin_unlock(ptl);
 drop_pml:
-		spin_unlock(pml);
+	spin_unlock(pml);
 
-		mmu_notifier_invalidate_range_end(&range);
+	mmu_notifier_invalidate_range_end(&range);
 
-		if (success) {
-			mm_dec_nr_ptes(mm);
-			page_table_check_pte_clear_range(mm, addr, pgt_pmd);
-			pte_free_defer(mm, pmd_pgtable(pgt_pmd));
-		}
+	if (success) {
+		mm_dec_nr_ptes(mm);
+		page_table_check_pte_clear_range(mm, addr, pgt_pmd);
+		pte_free_defer(mm, pmd_pgtable(pgt_pmd));
 	}
-	i_mmap_unlock_read(mapping);
+	return 0;
+}
+
+static void retract_page_tables(struct address_space *mapping, pgoff_t pgoff)
+{
+	i_mmap_read_walk(mapping, pgoff, pgoff, false,
+			 retract_page_tables_vma, &pgoff);
 }
 
 /**
