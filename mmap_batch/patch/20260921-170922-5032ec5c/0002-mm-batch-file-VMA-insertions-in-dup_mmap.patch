Message-ID: <3eeda67fd48d4cb35346436b3ddbb85bbe6034d4.1789981795.git.superdcc97@163.com>
In-Reply-To: <cover.1789981795.git.superdcc97@163.com>
References: <cover.1789981795.git.superdcc97@163.com>
From: Dong Chenchen <dongchenchen2@huawei.com>
Date: Mon, 21 Sep 2026 17:09:22 +0800
Subject: [PATCH 2/3] mm: batch file VMA insertions in dup_mmap
To: linux-mm@kvack.org
Cc: linux-kernel@vger.kernel.org,
    linux-kselftest@vger.kernel.org,
    Andrew Morton <akpm@linux-foundation.org>,
    David Hildenbrand <david@kernel.org>,
    Liam R. Howlett <liam@infradead.org>,
    Lorenzo Stoakes <ljs@kernel.org>,
    Shuah Khan <shuah@kernel.org>

dup_mmap() acquires mapping->i_mmap_rwsem for every file-backed VMA copied
into the child mm. Processes with multiple regions backed by the same
address_space repeatedly acquire the same lock, even when the child's
page tables can be populated on demand.

Batch up to eight file VMA insertions for the same address_space under
one acquisition of i_mmap_rwsem and the architecture's dcache mmap lock.
Group by address_space so separate file descriptors for the same inode
can share a batch. Preserve the existing shared-writable accounting and
insert each child VMA immediately after its parent in the interval tree.

Both mmap write locks keep the queued VMAs alive, and each child VMA owns
a file reference before it is queued. Use vma_needs_copy() to flush before
copying page tables so reverse mapping walks can find the child as soon
as it has PTEs. Flush around open callbacks and retain immediate insertion
for VMAs with such callbacks.

Flush remaining entries before arch_dup_mmap() and before failed-fork
teardown, which expects the child VMAs to be linked into their file
mapping trees. A full batch reduces eight insertion lock acquisitions
to one at the cost of a bounded stack buffer. Mappings that require page
table copying or an open callback retain immediate insertion.

Signed-off-by: Dong Chenchen <dongchenchen2@huawei.com>
Assisted-by: LLM
Signed-off-by: Dong Chenchen <superdcc97@163.com>
---
 mm/mmap.c | 84 +++++++++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 72 insertions(+), 12 deletions(-)

diff --git a/mm/mmap.c b/mm/mmap.c
index 4bf26b0f1e6e..a9a6eeed7795 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -1705,8 +1705,64 @@ bool mmap_read_lock_maybe_expand(struct mm_struct *mm,
 	return true;
 }
 
+/*
+ * File VMAs without copied page tables can be linked into the rmap tree in
+ * batches. Both mmap write locks keep the parent and child VMAs alive, and
+ * each child VMA already owns a file reference. Flush before installing page
+ * tables or exposing the child mm, including to the failed-fork teardown.
+ */
+struct dup_mmap_file_batch {
+	struct address_space *mapping;
+	unsigned int count;
+	struct {
+		struct vm_area_struct *vma;
+		struct vm_area_struct *prev;
+	} entries[8];
+};
+
+static void dup_mmap_file_batch_flush(struct dup_mmap_file_batch *batch)
+{
+	struct address_space *mapping = batch->mapping;
+	unsigned int i;
+
+	if (!batch->count)
+		return;
+
+	i_mmap_lock_write(mapping);
+	flush_dcache_mmap_lock(mapping);
+	for (i = 0; i < batch->count; i++) {
+		struct vm_area_struct *vma = batch->entries[i].vma;
+
+		if (vma_is_shared_maywrite(vma))
+			mapping_allow_writable(mapping);
+		mapping_rmap_tree_insert_after(vma, batch->entries[i].prev,
+					       mapping);
+	}
+	flush_dcache_mmap_unlock(mapping);
+	i_mmap_unlock_write(mapping);
+	batch->count = 0;
+}
+
+static void dup_mmap_file_batch_add(struct dup_mmap_file_batch *batch,
+				    struct vm_area_struct *vma,
+				    struct vm_area_struct *prev)
+{
+	struct address_space *mapping = vma->vm_file->f_mapping;
+
+	if (batch->count && batch->mapping != mapping)
+		dup_mmap_file_batch_flush(batch);
+
+	batch->mapping = mapping;
+	batch->entries[batch->count].vma = vma;
+	batch->entries[batch->count].prev = prev;
+	batch->count++;
+	if (batch->count == ARRAY_SIZE(batch->entries))
+		dup_mmap_file_batch_flush(batch);
+}
+
 __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 {
+	struct dup_mmap_file_batch file_batch = {};
 	struct vm_area_struct *mpnt, *tmp;
 	int retval;
 	unsigned long charge = 0;
@@ -1738,6 +1794,7 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 	mt_clear_in_rcu(vmi.mas.tree);
 	for_each_vma(vmi, mpnt) {
 		struct file *file;
+		bool has_open;
 
 		retval = vma_start_write_killable(mpnt);
 		if (retval < 0)
@@ -1797,35 +1854,38 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 
 		mm->map_count++;
 
-		if (tmp->vm_ops && tmp->vm_ops->open)
+		has_open = tmp->vm_ops && tmp->vm_ops->open;
+		if (has_open) {
+			dup_mmap_file_batch_flush(&file_batch);
 			tmp->vm_ops->open(tmp);
+		}
 
 		file = tmp->vm_file;
 		if (file) {
-			struct address_space *mapping = file->f_mapping;
-
 			get_file(file);
-			i_mmap_lock_write(mapping);
-			if (vma_is_shared_maywrite(tmp))
-				mapping_allow_writable(mapping);
-			flush_dcache_mmap_lock(mapping);
-			/* insert tmp into the share list, just after mpnt */
-			mapping_rmap_tree_insert_after(tmp, mpnt, mapping);
-			flush_dcache_mmap_unlock(mapping);
-			i_mmap_unlock_write(mapping);
+			dup_mmap_file_batch_add(&file_batch, tmp, mpnt);
+			/* Preserve immediate linking for callback-managed VMAs. */
+			if (has_open)
+				dup_mmap_file_batch_flush(&file_batch);
 		}
 
-		if (!vma_test(tmp, VMA_WIPEONFORK_BIT))
+		if (!vma_test(tmp, VMA_WIPEONFORK_BIT) &&
+		    vma_needs_copy(tmp, mpnt)) {
+			/* Rmap must find the child before it gains page tables. */
+			dup_mmap_file_batch_flush(&file_batch);
 			retval = copy_page_range(tmp, mpnt);
+		}
 
 		if (retval) {
 			mpnt = vma_next(&vmi);
 			goto loop_out;
 		}
 	}
+	dup_mmap_file_batch_flush(&file_batch);
 	/* a new mm has just been created */
 	retval = arch_dup_mmap(oldmm, mm);
 loop_out:
+	dup_mmap_file_batch_flush(&file_batch);
 	vma_iter_free(&vmi);
 	if (!retval) {
 		mt_set_in_rcu(vmi.mas.tree);
-- 
