From aeb884f315c6d69a5ba9995bafb9ce8604357efc Mon Sep 17 00:00:00 2001
From: Dong Chenchen <dongchenchen2@huawei.com>
Date: Tue, 22 Sep 2026 11:47:25 +0800
Subject: [PATCH 1/2] mm: batch file VMA insertion and page table copying in
 dup_mmap

dup_mmap() acquires mapping->i_mmap_rwsem separately for each file VMA.
Regions of the same executable or shared library repeatedly acquire the
same lock. Flushing a pending insertion batch whenever a VMA needs page
table copying also separates adjacent COW mappings into small batches.

Queue up to eight destination/source VMA pairs for one address_space.
Insert the whole batch under one i_mmap write lock and dcache mmap lock,
then release both locks before copying any of its page tables. A local
copy_page_range_batch() entry iterates over the saved pairs, preserves
WIPEONFORK and delegates all per-VMA copying to copy_page_range(). This
keeps every child discoverable through file rmap before it gains PTEs,
without flushing merely because the current VMA needs a page table copy.

Follow the init/add/process/final pattern introduced by commit
3577dbb19241 ("mm: batch unlink_file_vma calls in free_pgd_range"). Share
the counted VMA array and capacity as vma_file_batch, while keeping the
source pointers in the insertion-specific link_vma_file_batch. Group by
address_space, preserve shared-writable accounting and insert each child
immediately after its parent. The unlink grouping rules are unchanged.

The parent and child mmap write locks protect the queued VMAs, and each
child owns a file reference before queueing. Keep the existing open
callback before queueing. VMAs without vm_file retain their immediate
page table copy path. Finish the last file batch before arch_dup_mmap().

Propagate copy failures from batch processing. When add flushes a prior
batch, its new destination VMA is already in the child maple tree. Queue
that VMA even if copying the prior batch failed; loop_out must link it
before the ordinary teardown can remove it. On any earlier failure,
link remaining entries without attempting more page table copies.

Keep the teardown boundary at the first VMA not installed in the child,
not at the VMA whose deferred copy failed. This includes all installed
VMAs with no copied page tables. Clear the insertion count before copying
so a partially copied batch is never linked a second time on failure.
The bounded batch continues to use 136 bytes on x86_64.

Signed-off-by: Dong Chenchen <dongchenchen2@huawei.com>
Assisted-by: LLM
Signed-off-by: Dong Chenchen <superdcc97@163.com>
---
 mm/memory.c |   2 +-
 mm/mmap.c   | 117 +++++++++++++++++++++++++++++++++++++++++++++-------
 mm/vma.c    |   8 ++--
 mm/vma.h    |  12 +++---
 4 files changed, 115 insertions(+), 24 deletions(-)

diff --git a/mm/memory.c b/mm/memory.c
index 8b0c2c735d3d..221e44a36f2e 100644
--- a/mm/memory.c
+++ b/mm/memory.c
@@ -372,7 +372,7 @@ void free_pgd_range(struct mmu_gather *tlb,
  */
 void free_pgtables(struct mmu_gather *tlb, struct unmap_desc *unmap)
 {
-	struct unlink_vma_file_batch vb;
+	struct vma_file_batch vb;
 	struct ma_state *mas = unmap->mas;
 	struct vm_area_struct *vma = unmap->first;
 
diff --git a/mm/mmap.c b/mm/mmap.c
index 4bf26b0f1e6e..d068668182b6 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -1705,8 +1705,103 @@ bool mmap_read_lock_maybe_expand(struct mm_struct *mm,
 	return true;
 }
 
+/*
+ * Delay copying file page tables until the whole batch is linked into the
+ * rmap tree. Both mmap write locks keep the parent and child VMAs alive, and
+ * each child VMA already owns a file reference. On failure, link any remaining
+ * entries without copying their page tables before tearing down the child.
+ */
+struct link_vma_file_batch {
+	struct vma_file_batch batch;
+	struct vm_area_struct *src_vmas[VMA_FILE_BATCH_SIZE];
+};
+
+static void link_file_vma_batch_init(struct link_vma_file_batch *lvb)
+{
+	lvb->batch.count = 0;
+}
+
+static void link_file_vma_batch_process(struct link_vma_file_batch *lvb)
+{
+	struct vma_file_batch *vb = &lvb->batch;
+	struct address_space *mapping;
+	int i;
+
+	mapping = vb->vmas[0]->vm_file->f_mapping;
+	i_mmap_lock_write(mapping);
+	flush_dcache_mmap_lock(mapping);
+	for (i = 0; i < vb->count; i++) {
+		struct vm_area_struct *dst_vma = vb->vmas[i];
+
+		if (vma_is_shared_maywrite(dst_vma))
+			mapping_allow_writable(mapping);
+		mapping_rmap_tree_insert_after(dst_vma, lvb->src_vmas[i], mapping);
+	}
+	flush_dcache_mmap_unlock(mapping);
+	i_mmap_unlock_write(mapping);
+
+	link_file_vma_batch_init(lvb);
+}
+
+static int copy_page_range_batch(struct link_vma_file_batch *lvb, int count)
+{
+	int i, ret;
+
+	for (i = 0; i < count; i++) {
+		struct vm_area_struct *dst_vma = lvb->batch.vmas[i];
+
+		if (vma_test(dst_vma, VMA_WIPEONFORK_BIT))
+			continue;
+		ret = copy_page_range(dst_vma, lvb->src_vmas[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int dup_file_vma_batch(struct link_vma_file_batch *lvb)
+{
+	int count = lvb->batch.count;
+
+	if (!count)
+		return 0;
+
+	/* Link the whole batch before copying any of its page tables. */
+	link_file_vma_batch_process(lvb);
+	/* The arrays remain valid after process resets the count. */
+	return copy_page_range_batch(lvb, count);
+}
+
+static int link_file_vma_batch_add(struct link_vma_file_batch *lvb,
+				   struct vm_area_struct *dst_vma,
+				   struct vm_area_struct *src_vma)
+{
+	struct vma_file_batch *vb = &lvb->batch;
+	int ret = 0;
+
+	if ((vb->count > 0 && vb->vmas[0]->vm_file->f_mapping !=
+	     dst_vma->vm_file->f_mapping) || vb->count == ARRAY_SIZE(vb->vmas))
+		ret = dup_file_vma_batch(lvb);
+
+	/*
+	 * dst_vma is already in the child's maple tree. Queue it even if the
+	 * previous batch failed to copy, so error cleanup can link it first.
+	 */
+	vb->vmas[vb->count] = dst_vma;
+	lvb->src_vmas[vb->count] = src_vma;
+	vb->count++;
+	return ret;
+}
+
+static void link_file_vma_batch_final(struct link_vma_file_batch *lvb)
+{
+	if (lvb->batch.count > 0)
+		link_file_vma_batch_process(lvb);
+}
+
 __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 {
+	struct link_vma_file_batch vb;
 	struct vm_area_struct *mpnt, *tmp;
 	int retval;
 	unsigned long charge = 0;
@@ -1735,6 +1830,7 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 	if (unlikely(retval))
 		goto out;
 
+	link_file_vma_batch_init(&vb);
 	mt_clear_in_rcu(vmi.mas.tree);
 	for_each_vma(vmi, mpnt) {
 		struct file *file;
@@ -1802,21 +1898,11 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 
 		file = tmp->vm_file;
 		if (file) {
-			struct address_space *mapping = file->f_mapping;
-
 			get_file(file);
-			i_mmap_lock_write(mapping);
-			if (vma_is_shared_maywrite(tmp))
-				mapping_allow_writable(mapping);
-			flush_dcache_mmap_lock(mapping);
-			/* insert tmp into the share list, just after mpnt */
-			mapping_rmap_tree_insert_after(tmp, mpnt, mapping);
-			flush_dcache_mmap_unlock(mapping);
-			i_mmap_unlock_write(mapping);
-		}
-
-		if (!vma_test(tmp, VMA_WIPEONFORK_BIT))
+			retval = link_file_vma_batch_add(&vb, tmp, mpnt);
+		} else if (!vma_test(tmp, VMA_WIPEONFORK_BIT)) {
 			retval = copy_page_range(tmp, mpnt);
+		}
 
 		if (retval) {
 			mpnt = vma_next(&vmi);
@@ -1824,8 +1910,11 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 		}
 	}
 	/* a new mm has just been created */
-	retval = arch_dup_mmap(oldmm, mm);
+	retval = dup_file_vma_batch(&vb);
+	if (!retval)
+		retval = arch_dup_mmap(oldmm, mm);
 loop_out:
+	link_file_vma_batch_final(&vb);
 	vma_iter_free(&vmi);
 	if (!retval) {
 		mt_set_in_rcu(vmi.mas.tree);
diff --git a/mm/vma.c b/mm/vma.c
index f29abb30956b..0c39055cff84 100644
--- a/mm/vma.c
+++ b/mm/vma.c
@@ -1866,12 +1866,12 @@ struct vm_area_struct *vma_merge_extend(struct vma_iterator *vmi,
 	return vma_merge_new_range(&vmg);
 }
 
-void unlink_file_vma_batch_init(struct unlink_vma_file_batch *vb)
+void unlink_file_vma_batch_init(struct vma_file_batch *vb)
 {
 	vb->count = 0;
 }
 
-static void unlink_file_vma_batch_process(struct unlink_vma_file_batch *vb)
+static void unlink_file_vma_batch_process(struct vma_file_batch *vb)
 {
 	struct address_space *mapping;
 	int i;
@@ -1887,7 +1887,7 @@ static void unlink_file_vma_batch_process(struct unlink_vma_file_batch *vb)
 	unlink_file_vma_batch_init(vb);
 }
 
-void unlink_file_vma_batch_add(struct unlink_vma_file_batch *vb,
+void unlink_file_vma_batch_add(struct vma_file_batch *vb,
 			       struct vm_area_struct *vma)
 {
 	if (vma->vm_file == NULL)
@@ -1901,7 +1901,7 @@ void unlink_file_vma_batch_add(struct unlink_vma_file_batch *vb,
 	vb->count++;
 }
 
-void unlink_file_vma_batch_final(struct unlink_vma_file_batch *vb)
+void unlink_file_vma_batch_final(struct vma_file_batch *vb)
 {
 	if (vb->count > 0)
 		unlink_file_vma_batch_process(vb);
diff --git a/mm/vma.h b/mm/vma.h
index 024fabe63560..2fd9e1555299 100644
--- a/mm/vma.h
+++ b/mm/vma.h
@@ -30,9 +30,11 @@ struct vma_prepare {
 	bool skip_vma_uprobe :1;
 };
 
-struct unlink_vma_file_batch {
+#define VMA_FILE_BATCH_SIZE 8
+
+struct vma_file_batch {
 	int count;
-	struct vm_area_struct *vmas[8];
+	struct vm_area_struct *vmas[VMA_FILE_BATCH_SIZE];
 };
 
 /*
@@ -526,11 +528,11 @@ __must_check struct vm_area_struct *vma_merge_new_range(struct vma_merge_struct
 __must_check struct vm_area_struct *vma_merge_extend(struct vma_iterator *vmi,
 		  struct vm_area_struct *vma, unsigned long delta);
 
-void unlink_file_vma_batch_init(struct unlink_vma_file_batch *vb);
+void unlink_file_vma_batch_init(struct vma_file_batch *vb);
 
-void unlink_file_vma_batch_final(struct unlink_vma_file_batch *vb);
+void unlink_file_vma_batch_final(struct vma_file_batch *vb);
 
-void unlink_file_vma_batch_add(struct unlink_vma_file_batch *vb,
+void unlink_file_vma_batch_add(struct vma_file_batch *vb,
 			       struct vm_area_struct *vma);
 
 struct vm_area_struct *copy_vma(struct vm_area_struct **vmap,
-- 
