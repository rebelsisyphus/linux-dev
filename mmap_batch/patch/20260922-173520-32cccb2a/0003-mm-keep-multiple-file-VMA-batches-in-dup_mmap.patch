From 9ed28899f15dd4538d94e48e0526176731a320a5 Mon Sep 17 00:00:00 2001
From: Dong Chenchen <dongchenchen2@huawei.com>
Date: Tue, 22 Sep 2026 17:29:39 +0800
Subject: [PATCH 3/3] mm: keep multiple file VMA batches in dup_mmap

A single pending file VMA batch is drained whenever the next VMA has a
different address_space. Interleaved mappings of a few files therefore
lose batching even when their page tables need not be copied during fork.

Keep four batches of eight VMA pairs in dup_mmap(). Prefer an existing
batch for the same address_space, otherwise use an empty slot. Drain and
reuse the first slot when all four mappings have pending entries. Keep
the existing rule of processing a full batch before adding its next VMA.
Derive the mapping from the first queued VMA, as in the unlink helpers.

Drain every nonempty batch at the existing copy and loop_out boundaries.
Keep file page-table copies synchronous, including the requirement to
link the child VMA before copying its page tables. Pending entries are
also linked before failed-fork teardown. Process one mapping at a time,
without holding locks for multiple mappings together.

The VMA-pair buffers grow from 136 to 544 bytes on x86_64, with no new
allocation or changes to the shared unlink batch. Contiguous mappings
retain their existing batching; the extra slots target interleaved files.

Extend the fork_file selftests to cover four and five interleaved files,
plus private COW mappings across four files. Check inherited contents,
truncate invalidation and writable mapping accounting for these layouts.

Signed-off-by: Dong Chenchen <dongchenchen2@huawei.com>
Assisted-by: LLM
---
 mm/mmap.c                         | 56 ++++++++++++++----
 tools/testing/selftests/mm/rmap.c | 95 +++++++++++++++++++------------
 2 files changed, 103 insertions(+), 48 deletions(-)

diff --git a/mm/mmap.c b/mm/mmap.c
index 70c4ca685702..ed0ced5e1a9e 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -1705,6 +1705,8 @@ bool mmap_read_lock_maybe_expand(struct mm_struct *mm,
 	return true;
 }
 
+#define LINK_FILE_VMA_BATCH_NR 4
+
 /*
  * File VMAs without copied page tables can be linked into the rmap tree in
  * batches. Both mmap write locks keep the parent and child VMAs alive, and
@@ -1744,14 +1746,41 @@ static void link_file_vma_batch_process(struct link_vma_file_batch *lvb)
 	link_file_vma_batch_init(lvb);
 }
 
+static struct link_vma_file_batch *
+link_file_vma_batch_get(struct link_vma_file_batch *lvb,
+			struct address_space *mapping)
+{
+	struct link_vma_file_batch *empty = NULL;
+	int i;
+
+	/* Prefer a matching batch even if an earlier slot is empty. */
+	for (i = 0; i < LINK_FILE_VMA_BATCH_NR; i++) {
+		struct vma_file_batch *vb = &lvb[i].batch;
+
+		if (!vb->count) {
+			if (!empty)
+				empty = &lvb[i];
+		} else if (vb->vmas[0]->vm_file->f_mapping == mapping) {
+			return &lvb[i];
+		}
+	}
+	if (empty)
+		return empty;
+
+	/* Reuse the first slot when all mappings have pending entries. */
+	link_file_vma_batch_process(lvb);
+	return lvb;
+}
+
 static void link_file_vma_batch_add(struct link_vma_file_batch *lvb,
 				    struct vm_area_struct *dst_vma,
 				    struct vm_area_struct *src_vma)
 {
-	struct vma_file_batch *vb = &lvb->batch;
+	struct vma_file_batch *vb;
 
-	if ((vb->count > 0 && vb->vmas[0]->vm_file->f_mapping !=
-	     dst_vma->vm_file->f_mapping) || vb->count == ARRAY_SIZE(vb->vmas))
+	lvb = link_file_vma_batch_get(lvb, dst_vma->vm_file->f_mapping);
+	vb = &lvb->batch;
+	if (vb->count == ARRAY_SIZE(vb->vmas))
 		link_file_vma_batch_process(lvb);
 
 	vb->vmas[vb->count] = dst_vma;
@@ -1761,15 +1790,19 @@ static void link_file_vma_batch_add(struct link_vma_file_batch *lvb,
 
 static void link_file_vma_batch_final(struct link_vma_file_batch *lvb)
 {
-	if (lvb->batch.count > 0)
-		link_file_vma_batch_process(lvb);
+	int i;
+
+	for (i = 0; i < LINK_FILE_VMA_BATCH_NR; i++) {
+		if (lvb[i].batch.count > 0)
+			link_file_vma_batch_process(&lvb[i]);
+	}
 }
 
 __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 {
-	struct link_vma_file_batch vb;
+	struct link_vma_file_batch vb[LINK_FILE_VMA_BATCH_NR];
 	struct vm_area_struct *mpnt, *tmp;
-	int retval;
+	int retval, i;
 	unsigned long charge = 0;
 	LIST_HEAD(uf);
 	VMA_ITERATOR(vmi, mm, 0);
@@ -1796,7 +1829,8 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 	if (unlikely(retval))
 		goto out;
 
-	link_file_vma_batch_init(&vb);
+	for (i = 0; i < ARRAY_SIZE(vb); i++)
+		link_file_vma_batch_init(&vb[i]);
 	mt_clear_in_rcu(vmi.mas.tree);
 	for_each_vma(vmi, mpnt) {
 		struct file *file;
@@ -1865,13 +1899,13 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 		file = tmp->vm_file;
 		if (file) {
 			get_file(file);
-			link_file_vma_batch_add(&vb, tmp, mpnt);
+			link_file_vma_batch_add(vb, tmp, mpnt);
 		}
 
 		if (!vma_test(tmp, VMA_WIPEONFORK_BIT)) {
 			/* Rmap must find the child before it gains page tables. */
 			if (file && vma_needs_copy(tmp, mpnt))
-				link_file_vma_batch_final(&vb);
+				link_file_vma_batch_final(vb);
 			retval = copy_page_range(tmp, mpnt);
 		}
 
@@ -1883,7 +1917,7 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 	/* a new mm has just been created */
 	retval = arch_dup_mmap(oldmm, mm);
 loop_out:
-	link_file_vma_batch_final(&vb);
+	link_file_vma_batch_final(vb);
 	vma_iter_free(&vmi);
 	if (!retval) {
 		mt_set_in_rcu(vmi.mas.tree);
diff --git a/tools/testing/selftests/mm/rmap.c b/tools/testing/selftests/mm/rmap.c
index d6c308cf5614..8efd495f9d5b 100644
--- a/tools/testing/selftests/mm/rmap.c
+++ b/tools/testing/selftests/mm/rmap.c
@@ -513,10 +513,11 @@ TEST_F(migrate, ksm_and_mremap)
 
 /* Forked file VMAs must remain visible to truncate and write sealing. */
 #define FORK_FILE_VMAS 33
+#define FORK_FILE_FDS 5
 
 FIXTURE(fork_file)
 {
-	int fd[2];
+	int fd[FORK_FILE_FDS];
 	char *region;
 	size_t page_size;
 	size_t vma_size;
@@ -526,35 +527,57 @@ FIXTURE(fork_file)
 FIXTURE_VARIANT(fork_file)
 {
 	bool shared;
-	bool cow;
-	bool separate_files;
+	unsigned int cow_every;
+	unsigned int nr_files;
 	bool readonly;
 };
 
 FIXTURE_VARIANT_ADD(fork_file, shared)
 {
 	.shared = true,
+	.nr_files = 1,
 };
 
 FIXTURE_VARIANT_ADD(fork_file, private)
 {
+	.nr_files = 1,
 };
 
 FIXTURE_VARIANT_ADD(fork_file, private_cow)
 {
-	.cow = true,
+	.cow_every = 3,
+	.nr_files = 1,
 };
 
 FIXTURE_VARIANT_ADD(fork_file, different_files)
 {
 	.shared = true,
-	.separate_files = true,
+	.nr_files = 2,
+};
+
+FIXTURE_VARIANT_ADD(fork_file, four_files)
+{
+	.shared = true,
+	.nr_files = 4,
+};
+
+FIXTURE_VARIANT_ADD(fork_file, five_files)
+{
+	.shared = true,
+	.nr_files = 5,
+};
+
+FIXTURE_VARIANT_ADD(fork_file, four_files_cow)
+{
+	.cow_every = 5,
+	.nr_files = 4,
 };
 
 FIXTURE_VARIANT_ADD(fork_file, readonly)
 {
 	.shared = true,
 	.readonly = true,
+	.nr_files = 1,
 };
 
 FIXTURE_SETUP(fork_file)
@@ -562,29 +585,25 @@ FIXTURE_SETUP(fork_file)
 	int prot = PROT_READ | (variant->readonly ? 0 : PROT_WRITE);
 	int flags = MAP_FIXED | (variant->shared ? MAP_SHARED : MAP_PRIVATE);
 	char path[64];
-	char value = 'a';
+	unsigned int nr_fds = variant->nr_files == 1 ? 2 : variant->nr_files;
 	int i;
 
-	self->fd[0] = -1;
-	self->fd[1] = -1;
+	for (i = 0; i < ARRAY_SIZE(self->fd); i++)
+		self->fd[i] = -1;
 	self->region = MAP_FAILED;
 	self->page_size = getpagesize();
 	self->vma_size = 2 * self->page_size;
 	self->region_size = FORK_FILE_VMAS * (self->vma_size + self->page_size);
-	self->fd[0] = memfd_create("fork-file", MFD_ALLOW_SEALING);
-	ASSERT_GE(self->fd[0], 0);
-	ASSERT_EQ(ftruncate(self->fd[0], self->vma_size), 0);
-	ASSERT_EQ(pwrite(self->fd[0], &value, 1, 0), 1);
-	ASSERT_EQ(pwrite(self->fd[0], &value, 1, self->page_size), 1);
-
-	if (variant->separate_files) {
-		self->fd[1] = memfd_create("fork-file-other", MFD_ALLOW_SEALING);
-		ASSERT_GE(self->fd[1], 0);
-		ASSERT_EQ(ftruncate(self->fd[1], self->vma_size), 0);
-		value = 'b';
-		ASSERT_EQ(pwrite(self->fd[1], &value, 1, 0), 1);
-		ASSERT_EQ(pwrite(self->fd[1], &value, 1, self->page_size), 1);
-	} else {
+	for (i = 0; i < variant->nr_files; i++) {
+		char value = 'a' + i;
+
+		self->fd[i] = memfd_create("fork-file", MFD_ALLOW_SEALING);
+		ASSERT_GE(self->fd[i], 0);
+		ASSERT_EQ(ftruncate(self->fd[i], self->vma_size), 0);
+		ASSERT_EQ(pwrite(self->fd[i], &value, 1, 0), 1);
+		ASSERT_EQ(pwrite(self->fd[i], &value, 1, self->page_size), 1);
+	}
+	if (variant->nr_files == 1) {
 		/* Different struct files, but the same address_space. */
 		snprintf(path, sizeof(path), "/proc/self/fd/%d", self->fd[0]);
 		self->fd[1] = open(path, variant->readonly ? O_RDONLY : O_RDWR);
@@ -597,24 +616,26 @@ FIXTURE_SETUP(fork_file)
 	ASSERT_NE(self->region, MAP_FAILED);
 	for (i = 0; i < FORK_FILE_VMAS; i++) {
 		char *addr = self->region + i * (self->vma_size + self->page_size);
-		int fd = self->fd[variant->readonly ? 1 : i % 2];
+		int fd = self->fd[variant->readonly ? 1 : i % nr_fds];
 
 		ASSERT_EQ(mmap(addr, self->vma_size, prot, flags, fd, 0), addr);
 		/* Keep a file PTE alongside the first page when it becomes COW. */
 		FORCE_READ(addr[self->page_size]);
-		if (variant->cow && i % 3 == 1)
-			*addr = 'c';
+		if (variant->cow_every && i % variant->cow_every == 0)
+			*addr = 'C';
 	}
 }
 
 FIXTURE_TEARDOWN(fork_file)
 {
+	int i;
+
 	if (self->region != MAP_FAILED)
 		munmap(self->region, self->region_size);
-	if (self->fd[0] >= 0)
-		close(self->fd[0]);
-	if (self->fd[1] >= 0)
-		close(self->fd[1]);
+	for (i = 0; i < ARRAY_SIZE(self->fd); i++) {
+		if (self->fd[i] >= 0)
+			close(self->fd[i]);
+	}
 }
 
 TEST_F(fork_file, truncate)
@@ -632,18 +653,18 @@ TEST_F(fork_file, truncate)
 		close(resume[1]);
 		alarm(10);
 		for (i = 0; i < FORK_FILE_VMAS; i++) {
-			char expected = variant->separate_files && i % 2 ? 'b' : 'a';
+			char expected = 'a' + i % variant->nr_files;
 			char *addr = self->region + i * (self->vma_size + self->page_size);
 
 			ASSERT_EQ(addr[self->page_size], expected);
-			if (variant->cow && i % 3 == 1)
-				expected = 'c';
+			if (variant->cow_every && i % variant->cow_every == 0)
+				expected = 'C';
 			ASSERT_EQ(*addr, expected);
 		}
 		ASSERT_EQ(write(ready[1], &byte, 1), 1);
 		ASSERT_EQ(read(resume[0], &byte, 1), 1);
 		for (i = 0; i < FORK_FILE_VMAS; i++) {
-			char expected = variant->separate_files && i % 2 ? 'y' : 'x';
+			char expected = 'x' + i % variant->nr_files;
 			char *addr = self->region + i * (self->vma_size + self->page_size);
 
 			ASSERT_EQ(*addr, expected);
@@ -655,8 +676,8 @@ TEST_F(fork_file, truncate)
 	close(resume[0]);
 	ASSERT_EQ(read(ready[0], &byte, 1), 1);
 	/* Truncation must zap even the child's private COW pages. */
-	for (i = 0; i < (variant->separate_files ? 2 : 1); i++) {
-		byte = i ? 'y' : 'x';
+	for (i = 0; i < variant->nr_files; i++) {
+		byte = 'x' + i;
 		ASSERT_EQ(ftruncate(self->fd[i], 0), 0);
 		ASSERT_EQ(ftruncate(self->fd[i], self->vma_size), 0);
 		ASSERT_EQ(pwrite(self->fd[i], &byte, 1, 0), 1);
@@ -688,7 +709,7 @@ TEST_F(fork_file, write_seal)
 	close(resume[0]);
 	ASSERT_EQ(munmap(self->region, self->region_size), 0);
 	self->region = MAP_FAILED;
-	for (i = 0; i < (variant->separate_files ? 2 : 1); i++) {
+	for (i = 0; i < variant->nr_files; i++) {
 		ret = fcntl(self->fd[i], F_ADD_SEALS, F_SEAL_WRITE);
 		if (variant->shared && !variant->readonly) {
 			ASSERT_EQ(ret, -1);
@@ -701,7 +722,7 @@ TEST_F(fork_file, write_seal)
 	ASSERT_EQ(waitpid(pid, &status, 0), pid);
 	ASSERT_TRUE(WIFEXITED(status));
 	ASSERT_EQ(WEXITSTATUS(status), EXIT_SUCCESS);
-	for (i = 0; i < (variant->separate_files ? 2 : 1); i++)
+	for (i = 0; i < variant->nr_files; i++)
 		ASSERT_EQ(fcntl(self->fd[i], F_ADD_SEALS, F_SEAL_WRITE), 0);
 	close(resume[1]);
 }
