From 76132fdd930c3cc2ea0ed6d4e6ad11c349452187 Mon Sep 17 00:00:00 2001
From: Dong Chenchen <superdcc97@163.com>
Date: Mon, 27 Apr 2026 21:04:16 +0800
Subject: [PATCH 1/9] mm: batch vma insertions in dup_mmap

In the fork path, dup_mmap() acquires and releases i_mmap_rwsem for each
VMA that has a file mapping. When a process maps many segments from the
same file (e.g., libc.so text/data/bss), each VMA independently acquires
the same lock.

Batch the i_mmap lock acquisitions: collect VMAs sharing the same
address_space, hold the lock once for the entire group, insert all
VMAs into the interval tree, then release.  This reduces the number of
lock operations from N per-file to ~1 per-file in the common case.

This is safe because within dup_mmap() we already hold mmap_write_lock
on both the parent and child mm_structs, so no concurrent modification
of the same mapping's i_mmap can occur from this context.
---
 mm/mmap.c | 60 ++++++++++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 51 insertions(+), 9 deletions(-)

diff --git a/mm/mmap.c b/mm/mmap.c
index 843160946aa5..98a11867e4f2 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -1729,6 +1729,43 @@ bool mmap_read_lock_maybe_expand(struct mm_struct *mm,
 	return true;
 }
 
+struct dup_mmap_file_batch {
+	int count;
+	struct address_space *mapping;
+	bool locked;
+	struct vm_area_struct *tmp[8];
+	struct vm_area_struct *prev[8];
+};
+
+static void dup_mmap_file_batch_flush(struct dup_mmap_file_batch *batch)
+{
+	struct address_space *mapping = batch->mapping;
+	int i;
+
+	if (batch->count == 0)
+		return;
+
+	flush_dcache_mmap_lock(mapping);
+	for (i = 0; i < batch->count; i++) {
+		if (vma_is_shared_maywrite(batch->tmp[i]))
+			mapping_allow_writable(mapping);
+		vma_interval_tree_insert_after(batch->tmp[i], batch->prev[i],
+					       &mapping->i_mmap);
+	}
+	flush_dcache_mmap_unlock(mapping);
+	batch->count = 0;
+}
+
+static void dup_mmap_file_batch_unlock(struct dup_mmap_file_batch *batch)
+{
+	if (!batch->locked)
+		return;
+	dup_mmap_file_batch_flush(batch);
+	i_mmap_unlock_write(batch->mapping);
+	batch->locked = false;
+	batch->mapping = NULL;
+}
+
 __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 {
 	struct vm_area_struct *mpnt, *tmp;
@@ -1736,6 +1773,7 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 	unsigned long charge = 0;
 	LIST_HEAD(uf);
 	VMA_ITERATOR(vmi, mm, 0);
+	struct dup_mmap_file_batch batch = { .count = 0, .mapping = NULL, .locked = false };
 
 	if (mmap_write_lock_killable(oldmm))
 		return -EINTR;
@@ -1826,15 +1864,18 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 			struct address_space *mapping = file->f_mapping;
 
 			get_file(file);
-			i_mmap_lock_write(mapping);
-			if (vma_is_shared_maywrite(tmp))
-				mapping_allow_writable(mapping);
-			flush_dcache_mmap_lock(mapping);
-			/* insert tmp into the share list, just after mpnt */
-			vma_interval_tree_insert_after(tmp, mpnt,
-					&mapping->i_mmap);
-			flush_dcache_mmap_unlock(mapping);
-			i_mmap_unlock_write(mapping);
+			if (batch.locked && batch.mapping != mapping)
+				dup_mmap_file_batch_unlock(&batch);
+			if (!batch.locked) {
+				batch.mapping = mapping;
+				i_mmap_lock_write(mapping);
+				batch.locked = true;
+			}
+			batch.tmp[batch.count] = tmp;
+			batch.prev[batch.count] = mpnt;
+			batch.count++;
+			if (batch.count == ARRAY_SIZE(batch.tmp))
+				dup_mmap_file_batch_unlock(&batch);
 		}
 
 		if (!(tmp->vm_flags & VM_WIPEONFORK))
@@ -1848,6 +1889,7 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 	/* a new mm has just been created */
 	retval = arch_dup_mmap(oldmm, mm);
 loop_out:
+	dup_mmap_file_batch_unlock(&batch);
 	vma_iter_free(&vmi);
 	if (!retval) {
 		mt_set_in_rcu(vmi.mas.tree);
-- 
