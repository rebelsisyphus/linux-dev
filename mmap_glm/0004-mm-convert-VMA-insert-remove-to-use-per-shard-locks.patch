+		int nr_shards = 0;
+
+		for (i = 0; i < batch->count; i++) {
+			unsigned int idx;
+			int j;
+
+			idx = vma_shard_idx(batch->tmp[i]) % shards_ptr->nr_shards;
+			for (j = 0; j < nr_shards; j++) {
+				if (shard_idx[j] == idx)
+					break;
+			}
+			if (j < nr_shards)
+				continue;
+
+			shard_idx[nr_shards] = idx;
+			shards[nr_shards] = &shards_ptr->shards[idx];
+			nr_shards++;
+		}
+
+		for (i = 1; i < nr_shards; i++) {
+			unsigned int tmp_idx = shard_idx[i];
+			struct i_mmap_shard *tmp_shard = shards[i];
+			int j = i;
+
+			while (j > 0 && shard_idx[j - 1] > tmp_idx) {
+				shard_idx[j] = shard_idx[j - 1];
+				shards[j] = shards[j - 1];
+				j--;
+			}
+			shard_idx[j] = tmp_idx;
+			shards[j] = tmp_shard;
+		}
+
+		for (i = 0; i < nr_shards; i++)
+			down_write(&shards[i]->rwsem);
+
+		flush_dcache_mmap_lock(mapping);
+		for (i = 0; i < batch->count; i++) {
+			unsigned int idx;
+			struct i_mmap_shard *shard;
+
+			if (vma_is_shared_maywrite(batch->tmp[i]))
+				mapping_allow_writable(mapping);
+			idx = vma_shard_idx(batch->tmp[i]) % shards_ptr->nr_shards;
+			shard = &shards_ptr->shards[idx];
+			vma_interval_tree_insert(batch->tmp[i], &shard->tree);
+			atomic_inc(&shards_ptr->vma_count);
+		}
+		flush_dcache_mmap_unlock(mapping);
+
+		for (i = nr_shards - 1; i >= 0; i--)
+			up_write(&shards[i]->rwsem);
+	} else {
+		flush_dcache_mmap_lock(mapping);
+		for (i = 0; i < batch->count; i++) {
+			if (vma_is_shared_maywrite(batch->tmp[i]))
+				mapping_allow_writable(mapping);
+			vma_interval_tree_insert_after(batch->tmp[i], batch->prev[i],
+						       &mapping->i_mmap);
