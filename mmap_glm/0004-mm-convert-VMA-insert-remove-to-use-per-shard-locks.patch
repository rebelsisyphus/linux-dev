diff --git a/mm/i_mmap_shards.c b/mm/i_mmap_shards.c
index f5add9003232..4e2bc23a5608 100644
--- a/mm/i_mmap_shards.c
+++ b/mm/i_mmap_shards.c
@@ -70,4 +70,66 @@ int mapping_convert_to_shards(struct address_space *mapping)
 	smp_store_release(&mapping->i_mmap_shards_ptr, shards);
 
 	return 0;
+}
+
+int i_mmap_lock_shards_write(struct address_space *mapping,
+			     struct i_mmap_shard *shards[],
+			     struct vm_area_struct *vmas[],
+			     int nr_vmas)
+{
+	struct i_mmap_shards *shards_ptr;
+	unsigned int shard_idx[I_MMAP_NR_SHARDS];
+	int nr_shards = 0;
+	int i, j;
+
+	shards_ptr = READ_ONCE(mapping->i_mmap_shards_ptr);
+	if (!shards_ptr)
+		return 0;
+
+	for (i = 0; i < nr_vmas; i++) {
+		unsigned int idx;
+
+		if (!vmas[i])
+			continue;
+
+		idx = vma_shard_idx(vmas[i]) % shards_ptr->nr_shards;
+
+		for (j = 0; j < nr_shards; j++) {
+			if (shard_idx[j] == idx)
+				break;
+		}
+		if (j < nr_shards)
+			continue;
+
+		shard_idx[nr_shards] = idx;
+		shards[nr_shards] = &shards_ptr->shards[idx];
+		nr_shards++;
+	}
+
+	for (i = 1; i < nr_shards; i++) {
+		unsigned int tmp_idx = shard_idx[i];
+		struct i_mmap_shard *tmp_shard = shards[i];
+
+		j = i;
+		while (j > 0 && shard_idx[j - 1] > tmp_idx) {
+			shard_idx[j] = shard_idx[j - 1];
+			shards[j] = shards[j - 1];
+			j--;
+		}
+		shard_idx[j] = tmp_idx;
+		shards[j] = tmp_shard;
+	}
+
+	for (i = 0; i < nr_shards; i++)
+		down_write(&shards[i]->rwsem);
+
+	return nr_shards;
+}
+
+void i_mmap_unlock_shards_write(struct i_mmap_shard *shards[], int nr_shards)
+{
+	int i;
+
+	for (i = nr_shards - 1; i >= 0; i--)
+		up_write(&shards[i]->rwsem);
 }
\ No newline at end of file
