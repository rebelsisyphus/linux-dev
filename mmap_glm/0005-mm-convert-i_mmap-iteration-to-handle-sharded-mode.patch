index 5c35ce1ed882..7e8b9a2f091c 100644
--- a/fs/dax.c
+++ b/fs/dax.c
@@ -1163,12 +1163,27 @@ static int dax_writeback_one(struct xa_state *xas, struct dax_device *dax_dev,
 	end = index + count - 1;
 
 	/* Walk all mappings of a given index of a file and writeprotect them */
-	i_mmap_lock_read(mapping);
-	vma_interval_tree_foreach(vma, get_i_mmap_root(mapping), index, end) {
-		pfn_mkclean_range(pfn, count, index, vma);
-		cond_resched();
+	if (mapping_sharded(mapping)) {
+		struct i_mmap_shards *shards = mapping->i_mmap_shards_ptr;
+		unsigned int s;
+
+		for (s = 0; s < shards->nr_shards; s++) {
+			down_read(&shards->shards[s].rwsem);
+			vma_interval_tree_foreach(vma, &shards->shards[s].tree,
+						  index, end) {
+				pfn_mkclean_range(pfn, count, index, vma);
+				cond_resched();
+			}
+			up_read(&shards->shards[s].rwsem);
+		}
+	} else {
+		i_mmap_lock_read(mapping);
+		vma_interval_tree_foreach(vma, &mapping->i_mmap, index, end) {
+			pfn_mkclean_range(pfn, count, index, vma);
+			cond_resched();
+		}
+		i_mmap_unlock_read(mapping);
 	}
-	i_mmap_unlock_read(mapping);
 
