 		}
 		if (vp->insert && vp->insert->vm_file) {
 			/*
@@ -340,15 +361,10 @@ static void vma_prepare(struct vma_prepare *vp)
 	if (vp->file) {
 		flush_dcache_mmap_lock(vp->mapping);
