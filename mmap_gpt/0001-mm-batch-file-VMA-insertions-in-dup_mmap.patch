From 309d768c7f35ecf8f6e8dad4761f8f51f100af57 Mon Sep 17 00:00:00 2001
From: Dong Chenchen <superdcc97@163.com>
Date: Tue, 12 May 2026 21:58:49 +0800
Subject: [PATCH 01/14] mm: batch file VMA insertions in dup_mmap

dup_mmap() currently takes mapping->i_mmap_rwsem for every file-backed
VMA copied into the child mm.  Large dynamically linked processes
can contain several adjacent VMAs backed by the same address_space,
so fork-heavy exec workloads repeatedly acquire the same lock while
building the child mapping tree.

Batch consecutive file-backed VMA insertions for the same
address_space.  The batch holds i_mmap_rwsem once, updates writable
accounting, and inserts the copied VMAs into the interval tree
together.

Flush the batch before copying page tables for VMAs that require
copy_page_range(), preserving the original ordering for VM_COPY_ON_FORK
and anon_vma-backed mappings.

Signed-off-by: Dong Chenchen <superdcc97@163.com>
---
 mm/mmap.c | 82 +++++++++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 70 insertions(+), 12 deletions(-)

diff --git a/mm/mmap.c b/mm/mmap.c
index 5754d1c36462..62a48b22a09b 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -1728,6 +1728,68 @@ bool mmap_read_lock_maybe_expand(struct mm_struct *mm,
 	return true;
 }
 
+struct dup_mmap_file_batch {
+	struct address_space *mapping;
+	unsigned int count;
+	struct vm_area_struct *vmas[8];
+	struct vm_area_struct *prev[8];
+};
+
+static void dup_mmap_file_batch_init(struct dup_mmap_file_batch *batch)
+{
+	batch->mapping = NULL;
+	batch->count = 0;
+}
+
+static void dup_mmap_file_batch_flush(struct dup_mmap_file_batch *batch)
+{
+	struct address_space *mapping = batch->mapping;
+	unsigned int i;
+
+	if (!batch->count)
+		return;
+
+	i_mmap_lock_write(mapping);
+	flush_dcache_mmap_lock(mapping);
+	for (i = 0; i < batch->count; i++) {
+		if (vma_is_shared_maywrite(batch->vmas[i]))
+			mapping_allow_writable(mapping);
+		vma_interval_tree_insert_after(batch->vmas[i], batch->prev[i],
+					       &mapping->i_mmap);
+	}
+	flush_dcache_mmap_unlock(mapping);
+	i_mmap_unlock_write(mapping);
+
+	dup_mmap_file_batch_init(batch);
+}
+
+static void dup_mmap_file_batch_add(struct dup_mmap_file_batch *batch,
+				    struct vm_area_struct *vma,
+				    struct vm_area_struct *prev)
+{
+	struct address_space *mapping = vma->vm_file->f_mapping;
+
+	if (batch->count && batch->mapping != mapping)
+		dup_mmap_file_batch_flush(batch);
+
+	batch->mapping = mapping;
+	batch->vmas[batch->count] = vma;
+	batch->prev[batch->count] = prev;
+	batch->count++;
+
+	if (batch->count == ARRAY_SIZE(batch->vmas))
+		dup_mmap_file_batch_flush(batch);
+}
+
+static bool dup_mmap_needs_page_copy(struct vm_area_struct *dst_vma,
+				     struct vm_area_struct *src_vma)
+{
+	if (dst_vma->vm_flags & VM_COPY_ON_FORK)
+		return true;
+
+	return src_vma->anon_vma;
+}
+
 __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 {
 	struct vm_area_struct *mpnt, *tmp;
@@ -1735,9 +1797,11 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 	unsigned long charge = 0;
 	LIST_HEAD(uf);
 	VMA_ITERATOR(vmi, mm, 0);
+	struct dup_mmap_file_batch file_batch;
 
 	if (mmap_write_lock_killable(oldmm))
 		return -EINTR;
+	dup_mmap_file_batch_init(&file_batch);
 	flush_cache_dup_mm(oldmm);
 	uprobe_dup_mmap(oldmm, mm);
 	/*
@@ -1822,22 +1886,15 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 
 		file = tmp->vm_file;
 		if (file) {
-			struct address_space *mapping = file->f_mapping;
-
 			get_file(file);
-			i_mmap_lock_write(mapping);
-			if (vma_is_shared_maywrite(tmp))
-				mapping_allow_writable(mapping);
-			flush_dcache_mmap_lock(mapping);
-			/* insert tmp into the share list, just after mpnt */
-			vma_interval_tree_insert_after(tmp, mpnt,
-					&mapping->i_mmap);
-			flush_dcache_mmap_unlock(mapping);
-			i_mmap_unlock_write(mapping);
+			dup_mmap_file_batch_add(&file_batch, tmp, mpnt);
 		}
 
-		if (!(tmp->vm_flags & VM_WIPEONFORK))
+		if (!(tmp->vm_flags & VM_WIPEONFORK)) {
+			if (dup_mmap_needs_page_copy(tmp, mpnt))
+				dup_mmap_file_batch_flush(&file_batch);
 			retval = copy_page_range(tmp, mpnt);
+		}
 
 		if (retval) {
 			mpnt = vma_next(&vmi);
@@ -1847,6 +1904,7 @@ __latent_entropy int dup_mmap(struct mm_struct *mm, struct mm_struct *oldmm)
 	/* a new mm has just been created */
 	retval = arch_dup_mmap(oldmm, mm);
 loop_out:
+	dup_mmap_file_batch_flush(&file_batch);
 	vma_iter_free(&vmi);
 	if (!retval) {
 		mt_set_in_rcu(vmi.mas.tree);
-- 
