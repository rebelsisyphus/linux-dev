From c4010ab5d26405f888531427bbaffaf92d350d22 Mon Sep 17 00:00:00 2001
From: Dong Chenchen <superdcc97@163.com>
Date: Wed, 13 May 2026 10:38:30 +0800
Subject: [PATCH 13/16] mm: enable i_mmap shards after write contention

Dynamic i_mmap sharding needs a safe trigger point after the
preparatory sharded tree and reader support is in place. Try the
central i_mmap write lock first; repeated trylock failures on
regular-file mappings allocate and publish sharded i_mmap state, then
retry the update through the shard locking path.

Make the hot file VMA update paths use the same state-aware lock
helpers. dup_mmap() keeps its insert_after() fast path while the
mapping is central and falls back to normal interval-tree insertion
once sharded. vma_prepare() locks all file VMAs touched by the
prepare/complete operation, so split and merge updates do not modify a
shard without holding its lock.

Signed-off-by: Dong Chenchen <superdcc97@163.com>
---
 include/linux/fs.h |  13 +++++
 kernel/fork.c      |  16 ++++--
 mm/internal.h      |   2 +
 mm/mmap.c          | 120 +++++++++++++++++++++++++++++++++++++++------
 4 files changed, 131 insertions(+), 20 deletions(-)

diff --git a/include/linux/fs.h b/include/linux/fs.h
index 7ecf8dab9e96..51ce4487f30c 100644
--- a/include/linux/fs.h
+++ b/include/linux/fs.h
@@ -473,6 +473,7 @@ extern const struct address_space_operations empty_aops;
 
 #define I_MMAP_SHARD_SHIFT	3
 #define I_MMAP_NR_SHARDS	BIT(I_MMAP_SHARD_SHIFT)
+#define I_MMAP_LOCKED_CENTRAL	(-1)
 
 struct i_mmap_shard {
 	struct rb_root_cached	tree;
@@ -489,6 +490,18 @@ struct i_mmap_shards *i_mmap_shards_alloc(gfp_t gfp);
 bool i_mmap_shards_install_locked(struct address_space *mapping,
 				  struct i_mmap_shards *shards);
 void i_mmap_shards_free(struct i_mmap_shards *shards);
+int i_mmap_lock_vmas_write(struct address_space *mapping,
+			   struct i_mmap_shard *locked[],
+			   struct vm_area_struct **vmas, int count);
+int i_mmap_lock_vmas_write_contended(struct address_space *mapping,
+				     struct i_mmap_shard *locked[],
+				     struct vm_area_struct **vmas, int count);
+void i_mmap_unlock_vmas_write(struct address_space *mapping,
+			      struct i_mmap_shard *locked[], int nr_locked);
+void i_mmap_insert_vma(struct address_space *mapping,
+		       struct vm_area_struct *vma);
+void i_mmap_remove_vma(struct address_space *mapping,
+		       struct vm_area_struct *vma);
 
 /**
  * struct address_space - Contents of a cacheable, mappable object.
diff --git a/kernel/fork.c b/kernel/fork.c
index f63b264bd32d..8bbb40d8cc19 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -687,21 +687,29 @@ static void dup_mmap_file_batch_init(struct dup_mmap_file_batch *batch)
 static void dup_mmap_file_batch_flush(struct dup_mmap_file_batch *batch)
 {
 	struct address_space *mapping = batch->mapping;
+	struct i_mmap_shard *locked[I_MMAP_NR_SHARDS];
+	int nr_locked;
 	unsigned int i;
 
 	if (!batch->count)
 		return;
 
-	i_mmap_lock_write(mapping);
+	nr_locked = i_mmap_lock_vmas_write_contended(mapping, locked,
+						     batch->vmas,
+						     batch->count);
 	flush_dcache_mmap_lock(mapping);
 	for (i = 0; i < batch->count; i++) {
 		if (batch->vmas[i]->vm_flags & VM_SHARED)
 			mapping_allow_writable(mapping);
-		vma_interval_tree_insert_after(batch->vmas[i], batch->prev[i],
-					       &mapping->i_mmap);
+		if (nr_locked == I_MMAP_LOCKED_CENTRAL)
+			vma_interval_tree_insert_after(batch->vmas[i],
+						       batch->prev[i],
+						       &mapping->i_mmap);
+		else
+			i_mmap_insert_vma(mapping, batch->vmas[i]);
 	}
 	flush_dcache_mmap_unlock(mapping);
-	i_mmap_unlock_write(mapping);
+	i_mmap_unlock_vmas_write(mapping, locked, nr_locked);
 
 	dup_mmap_file_batch_init(batch);
 }
diff --git a/mm/internal.h b/mm/internal.h
index f3d42a0c3bad..468da4ade8d9 100644
--- a/mm/internal.h
+++ b/mm/internal.h
@@ -1484,6 +1484,8 @@ struct vma_prepare {
 	struct vm_area_struct *insert;
 	struct vm_area_struct *remove;
 	struct vm_area_struct *remove2;
+	struct i_mmap_shard *i_mmap_locked[I_MMAP_NR_SHARDS];
+	int i_mmap_nr_locked;
 
 	bool skip_vma_uprobe;
 };
diff --git a/mm/mmap.c b/mm/mmap.c
index 0cf850b9fe09..72f73a4146a1 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -67,7 +67,7 @@
 #define arch_mmap_check(addr, len, flags)	(0)
 #endif
 
-#define I_MMAP_LOCKED_CENTRAL	(-1)
+#define I_MMAP_SHARD_FAILS	4
 
 struct i_mmap_shards *i_mmap_shards_alloc(gfp_t gfp)
 {
@@ -115,7 +115,7 @@ bool i_mmap_shards_install_locked(struct address_space *mapping,
 
 	i_mmap_assert_write_locked(mapping);
 
-	if (WARN_ON_ONCE(READ_ONCE(mapping->i_mmap_shards)))
+	if (READ_ONCE(mapping->i_mmap_shards))
 		return false;
 
 	while ((vma = vma_interval_tree_iter_first(root, 0, ULONG_MAX))) {
@@ -134,8 +134,8 @@ bool i_mmap_shards_install_locked(struct address_space *mapping,
 	return true;
 }
 
-static void i_mmap_insert_vma(struct address_space *mapping,
-			      struct vm_area_struct *vma)
+void i_mmap_insert_vma(struct address_space *mapping,
+		       struct vm_area_struct *vma)
 {
 	struct i_mmap_shards *shards = i_mmap_shards_load(mapping);
 
@@ -151,8 +151,8 @@ static void i_mmap_insert_vma(struct address_space *mapping,
 	vma_interval_tree_insert(vma, &mapping->i_mmap);
 }
 
-static void i_mmap_remove_vma(struct address_space *mapping,
-			      struct vm_area_struct *vma)
+void i_mmap_remove_vma(struct address_space *mapping,
+		       struct vm_area_struct *vma)
 {
 	struct i_mmap_shards *shards = i_mmap_shards_load(mapping);
 
@@ -168,9 +168,9 @@ static void i_mmap_remove_vma(struct address_space *mapping,
 	vma_interval_tree_remove(vma, &mapping->i_mmap);
 }
 
-static int i_mmap_lock_vmas_write(struct address_space *mapping,
-				  struct i_mmap_shard *locked[],
-				  struct vm_area_struct **vmas, int count)
+int i_mmap_lock_vmas_write(struct address_space *mapping,
+			   struct i_mmap_shard *locked[],
+			   struct vm_area_struct **vmas, int count)
 {
 	struct i_mmap_shards *shards = i_mmap_shards_load(mapping);
 	unsigned int shard_idx[I_MMAP_NR_SHARDS];
@@ -207,9 +207,62 @@ static int i_mmap_lock_vmas_write(struct address_space *mapping,
 	return nr_locked;
 }
 
-static void i_mmap_unlock_vmas_write(struct address_space *mapping,
+static bool i_mmap_shards_allowed(struct address_space *mapping)
+{
+	struct inode *inode = mapping->host;
+
+	return inode && S_ISREG(inode->i_mode);
+}
+
+static void i_mmap_maybe_install_shards(struct address_space *mapping)
+{
+	struct i_mmap_shards *shards;
+
+	if (i_mmap_shards_load(mapping))
+		return;
+	if (!i_mmap_shards_allowed(mapping))
+		return;
+	if (atomic_inc_return(&mapping->i_mmap_trylock_fails) <
+	    I_MMAP_SHARD_FAILS)
+		return;
+
+	shards = i_mmap_shards_alloc(GFP_KERNEL);
+	if (!shards)
+		return;
+
+	i_mmap_lock_write(mapping);
+	if (i_mmap_shards_install_locked(mapping, shards)) {
+		atomic_set(&mapping->i_mmap_trylock_fails, 0);
+		shards = NULL;
+	}
+	i_mmap_unlock_write(mapping);
+	i_mmap_shards_free(shards);
+}
+
+int i_mmap_lock_vmas_write_contended(struct address_space *mapping,
 				     struct i_mmap_shard *locked[],
-				     int nr_locked)
+				     struct vm_area_struct **vmas, int count)
+{
+	if (i_mmap_shards_load(mapping))
+		return i_mmap_lock_vmas_write(mapping, locked, vmas, count);
+
+	if (i_mmap_trylock_write(mapping)) {
+		if (likely(!i_mmap_shards_load(mapping)))
+			return I_MMAP_LOCKED_CENTRAL;
+
+		i_mmap_unlock_write(mapping);
+		return i_mmap_lock_vmas_write(mapping, locked, vmas, count);
+	}
+
+	if (i_mmap_shards_load(mapping))
+		return i_mmap_lock_vmas_write(mapping, locked, vmas, count);
+
+	i_mmap_maybe_install_shards(mapping);
+	return i_mmap_lock_vmas_write(mapping, locked, vmas, count);
+}
+
+void i_mmap_unlock_vmas_write(struct address_space *mapping,
+			      struct i_mmap_shard *locked[], int nr_locked)
 {
 	int i;
 
@@ -304,7 +357,8 @@ static void unlink_file_vma_batch_process(struct unlink_vma_file_batch *vb)
 	int nr_locked;
 	int i;
 
-	nr_locked = i_mmap_lock_vmas_write(mapping, locked, vb->vmas, vb->count);
+	nr_locked = i_mmap_lock_vmas_write_contended(mapping, locked,
+						     vb->vmas, vb->count);
 	for (i = 0; i < vb->count; i++) {
 		VM_WARN_ON_ONCE(vb->vmas[i]->vm_file->f_mapping != mapping);
 		__remove_shared_vm_struct(vb->vmas[i], mapping);
@@ -602,13 +656,16 @@ static void __vma_link_file(struct vm_area_struct *vma,
 static void vma_link_file(struct vm_area_struct *vma)
 {
 	struct file *file = vma->vm_file;
+	struct i_mmap_shard *locked[I_MMAP_NR_SHARDS];
 	struct address_space *mapping;
+	int nr_locked;
 
 	if (file) {
 		mapping = file->f_mapping;
-		i_mmap_lock_write(mapping);
+		nr_locked = i_mmap_lock_vmas_write_contended(mapping, locked,
+							      &vma, 1);
 		__vma_link_file(vma, mapping);
-		i_mmap_unlock_write(mapping);
+		i_mmap_unlock_vmas_write(mapping, locked, nr_locked);
 	}
 }
 
@@ -666,6 +723,37 @@ static inline void init_vma_prep(struct vma_prepare *vp,
 	init_multi_vma_prep(vp, vma, NULL, NULL, NULL);
 }
 
+static void vma_prepare_add_file_vma(struct vma_prepare *vp,
+				     struct vm_area_struct **vmas,
+				     int *count, struct vm_area_struct *vma)
+{
+	if (vma && vma->vm_file && vma->vm_file->f_mapping == vp->mapping)
+		vmas[(*count)++] = vma;
+}
+
+static void vma_prepare_lock_file(struct vma_prepare *vp)
+{
+	struct vm_area_struct *vmas[5];
+	int count = 0;
+	int nr_locked;
+
+	vma_prepare_add_file_vma(vp, vmas, &count, vp->vma);
+	vma_prepare_add_file_vma(vp, vmas, &count, vp->adj_next);
+	vma_prepare_add_file_vma(vp, vmas, &count, vp->insert);
+	vma_prepare_add_file_vma(vp, vmas, &count, vp->remove);
+	vma_prepare_add_file_vma(vp, vmas, &count, vp->remove2);
+
+	nr_locked = i_mmap_lock_vmas_write_contended(vp->mapping,
+						     vp->i_mmap_locked,
+						     vmas, count);
+	vp->i_mmap_nr_locked = nr_locked;
+}
+
+static void vma_prepare_unlock_file(struct vma_prepare *vp)
+{
+	i_mmap_unlock_vmas_write(vp->mapping, vp->i_mmap_locked,
+				 vp->i_mmap_nr_locked);
+}
 
 /*
  * vma_prepare() - Helper function for handling locking VMAs prior to altering
@@ -680,7 +768,7 @@ static inline void vma_prepare(struct vma_prepare *vp)
 			uprobe_munmap(vp->adj_next, vp->adj_next->vm_start,
 				      vp->adj_next->vm_end);
 
-		i_mmap_lock_write(vp->mapping);
+		vma_prepare_lock_file(vp);
 		if (vp->insert && vp->insert->vm_file) {
 			/*
 			 * Put into interval tree now, so instantiated pages
@@ -749,7 +837,7 @@ static inline void vma_complete(struct vma_prepare *vp,
 	}
 
 	if (vp->file) {
-		i_mmap_unlock_write(vp->mapping);
+		vma_prepare_unlock_file(vp);
 
 		if (!vp->skip_vma_uprobe) {
 			uprobe_mmap(vp->vma);
-- 
