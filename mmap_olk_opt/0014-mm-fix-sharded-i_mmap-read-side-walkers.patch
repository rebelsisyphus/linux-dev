+static int i_mmap_read_walk_shards(struct i_mmap_shards *shards,
+				   pgoff_t start, pgoff_t last,
+				   bool try_lock, i_mmap_walk_fn fn,
+				   void *arg)
+{
+	struct vm_area_struct *vma;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < shards->nr_shards; i++) {
+		struct i_mmap_shard *shard = &shards->shard[i];
+
+		if (try_lock) {
+			if (!down_read_trylock(&shard->rwsem))
+				return -EAGAIN;
+		} else {
+			down_read(&shard->rwsem);
+		}
+
+		vma_interval_tree_foreach(vma, &shard->tree, start, last) {
+			ret = fn(vma, arg);
+			if (ret) {
+				up_read(&shard->rwsem);
+				return ret;
+			}
+		}
+		up_read(&shard->rwsem);
+	}
+
+	return 0;
+}
+
+int i_mmap_read_walk(struct address_space *mapping, pgoff_t start,
+		     pgoff_t last, bool try_lock, i_mmap_walk_fn fn,
+		     void *arg)
+{
+	struct i_mmap_shards *shards;
+	struct vm_area_struct *vma;
+	int ret;
+
+	shards = i_mmap_shards_load(mapping);
+	if (shards)
+		return i_mmap_read_walk_shards(shards, start, last, try_lock,
+					       fn, arg);
+
+	if (try_lock) {
+		if (!i_mmap_trylock_read(mapping))
+			return -EAGAIN;
+	} else {
+		i_mmap_lock_read(mapping);
+	}
+
+	shards = i_mmap_shards_load(mapping);
+	if (shards) {
+		i_mmap_unlock_read(mapping);
+		return i_mmap_read_walk_shards(shards, start, last, try_lock,
+					       fn, arg);
+	}
+
+	vma_interval_tree_foreach(vma, &mapping->i_mmap, start, last) {
+		ret = fn(vma, arg);
+		if (ret) {
+			i_mmap_unlock_read(mapping);
+			return ret;
+		}
+	}
+
+	i_mmap_unlock_read(mapping);
+	return 0;
+}
