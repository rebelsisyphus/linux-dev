 include/linux/fs.h       |  28 ++-
 include/linux/mm_types.h |   3 +
 kernel/fork.c            |  17 +-
 mm/Kconfig               |  10 +
 mm/khugepaged.c          | 170 ++++++++------
 mm/memory-failure.c      |  68 ++++--
 mm/memory.c              |  53 ++++-
 mm/mmap.c                |  16 +-
 mm/pagewalk.c            |  59 +++--
 mm/rmap.c                |  59 +++--
 mm/vma.c                 | 494 +++++++++++++++++++++++++++++++++++++--
 mm/vma.h                 |  87 +++++++
 13 files changed, 896 insertions(+), 176 deletions(-)

diff --git a/fs/inode.c b/fs/inode.c
index cc12b68e021b..874354b74ca5 100644
--- a/fs/inode.c
+++ b/fs/inode.c
@@ -487,6 +487,10 @@ static void __address_space_init_once(struct address_space *mapping)
 	INIT_LIST_HEAD(&mapping->i_private_list);
 	spin_lock_init(&mapping->i_private_lock);
 	mapping->i_mmap = RB_ROOT_CACHED;
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+	mapping->i_mmap_shards = NULL;
+	atomic_long_set(&mapping->i_mmap_count, 0);
+#endif
 }
 
 void address_space_init_once(struct address_space *mapping)
@@ -798,6 +802,10 @@ void clear_inode(struct inode *inode)
 	 * nor even WARN_ON(!mapping_empty).
 	 */
 	xa_unlock_irq(&inode->i_data.i_pages);
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+	kfree(inode->i_data.i_mmap_shards);
+	inode->i_data.i_mmap_shards = NULL;
+#endif
 	BUG_ON(!list_empty(&inode->i_data.i_private_list));
 	BUG_ON(!(inode_state_read_once(inode) & I_FREEING));
 	BUG_ON(inode_state_read_once(inode) & I_CLEAR);
diff --git a/include/linux/fs.h b/include/linux/fs.h
index 8b3dd145b25e..23dc942ff419 100644
--- a/include/linux/fs.h
+++ b/include/linux/fs.h
@@ -456,8 +456,10 @@ extern const struct address_space_operations empty_aops;
  * @gfp_mask: Memory allocation flags to use for allocating pages.
  * @i_mmap_writable: Number of VM_SHARED, VM_MAYWRITE mappings.
  * @nr_thps: Number of THPs in the pagecache (non-shmem only).
- * @i_mmap: Tree of private and shared mappings.
- * @i_mmap_rwsem: Protects @i_mmap and @i_mmap_writable.
+ * @i_mmap: Legacy tree of private and shared mappings.
+ * @i_mmap_shards: Optional per-NUMA trees for ordinary file mappings.
+ * @i_mmap_count: Number of mapped VMAs when sharding is enabled.
+ * @i_mmap_rwsem: Protects @i_mmap and shard publication/migration.
  * @nrpages: Number of page entries, protected by the i_pages lock.
  * @writeback_index: Writeback starts here.
  * @a_ops: Methods.
@@ -467,6 +469,20 @@ extern const struct address_space_operations empty_aops;
  * @i_private_list: For use by the owner of the address_space.
  * @i_private_data: For use by the owner of the address_space.
  */
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+#define I_MMAP_DOMAIN_MAX_SHARDS	8
+
+struct i_mmap_shard {
+	struct rb_root_cached	root;
+	struct rw_semaphore	rwsem;
+};
+
+struct i_mmap_shards {
+	unsigned int		nr;
+	struct i_mmap_shard	shard[];
+};
+#endif
+
 struct address_space {
 	struct inode		*host;
 	struct xarray		i_pages;
@@ -478,6 +494,10 @@ struct address_space {
 	atomic_t		nr_thps;
 #endif
 	struct rb_root_cached	i_mmap;
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+	struct i_mmap_shards	*i_mmap_shards;
+	atomic_long_t		i_mmap_count;
+#endif
 	unsigned long		nrpages;
 	pgoff_t			writeback_index;
 	const struct address_space_operations *a_ops;
@@ -552,6 +572,10 @@ static inline void i_mmap_assert_write_locked(struct address_space *mapping)
  */
 static inline int mapping_mapped(const struct address_space *mapping)
 {
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+	if (atomic_long_read(&mapping->i_mmap_count) > 0)
+		return true;
+#endif
 	return	!RB_EMPTY_ROOT(&mapping->i_mmap.rb_root);
 }
 
