diff --git a/kernel/fork.c b/kernel/fork.c
index 0ad0bfac6512..b472388769ad 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -407,6 +407,16 @@ struct task_struct *next_task(struct task_struct *p)
 }
 EXPORT_SYMBOL_GPL(next_task);
 
+
+static int task_domain_select_nid(struct task_struct *p)
+{
+	int nid = cpu_to_node(task_cpu(p));
+
+	if (unlikely(nid == NUMA_NO_NODE || nid >= nr_node_ids))
+		nid = 0;
+	return nid;
+}
+
 #ifdef CONFIG_DEBUG_FS
 static int task_domain_nr_tasks_show(struct seq_file *m, void *v)
 {
@@ -1422,6 +1432,7 @@ static struct mm_struct *mm_init(struct mm_struct *mm, struct task_struct *p,
 	mm->locked_vm = 0;
 	atomic64_set(&mm->pinned_vm, 0);
 	memset(&mm->rss_stat, 0, sizeof(mm->rss_stat));
+	mm->i_mmap_domain_nid = p ? READ_ONCE(p->task_domain_nid) : 0;
 	spin_lock_init(&mm->page_table_lock);
 	spin_lock_init(&mm->arg_lock);
 	mm_init_cpumask(mm);
@@ -2532,6 +2543,7 @@ __latent_entropy struct task_struct *copy_process(
 	retval = sched_fork(clone_flags, p);
 	if (retval)
 		goto bad_fork_cleanup_policy;
+	p->task_domain_nid = task_domain_select_nid(p);
 
 	retval = perf_event_init_task(p, clone_flags);
 	if (retval)
@@ -2722,10 +2734,7 @@ __latent_entropy struct task_struct *copy_process(
 	 * Lock order: shard -> {pid->lock, task_lock(parent/tracer)}
 	 * -> sighand->siglock.  IRQs are disabled by the shard lock.
 	 */
-	nid = cpu_to_node(task_cpu(p));
-	if (unlikely(nid == NUMA_NO_NODE || nid >= nr_node_ids))
-		nid = 0;
-	p->task_domain_nid = nid;
+	nid = READ_ONCE(p->task_domain_nid);
 	write_lock_irq_task_domain(nid);
 
 	/* CLONE_PARENT re-uses the old parent */
diff --git a/mm/Kconfig b/mm/Kconfig
index ebd8ea353687..c8b13dc50161 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -2,6 +2,16 @@
 
 menu "Memory Management options"
 
+config NUMA_DOMAIN_I_MMAP_SHARDS
+	bool "Experimental per-NUMA i_mmap shards"
+	depends on MMU && SMP && NUMA && EXPERT
+	default n
+	help
+	  Split ordinary file reverse mapping interval trees across NUMA
+	  domains to reduce i_mmap_rwsem contention in high-concurrency
+	  fork/exit workloads. This is experimental and disabled by default.
+
+
 #
 # For some reason microblaze and nios2 hard code SWAP=n.  Hopefully we can
