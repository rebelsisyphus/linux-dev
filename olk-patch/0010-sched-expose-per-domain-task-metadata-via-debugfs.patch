From bc4df4e62fe6a9ded86dbbbd609e78c6ab23e9f2 Mon Sep 17 00:00:00 2001
From: robin <robin800601@gmail.com>
Date: Thu, 23 Apr 2026 20:19:56 +0800
Subject: [PATCH 10/30] sched: expose per-domain task metadata via debugfs

---
 kernel/fork.c | 49 +++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/kernel/fork.c b/kernel/fork.c
index 3f498148a055..dbbbc616c706 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -13,6 +13,7 @@
  */
 
 #include <linux/anon_inodes.h>
+#include <linux/debugfs.h>
 #include <linux/slab.h>
 #include <linux/sched/autogroup.h>
 #include <linux/sched/mm.h>
@@ -221,6 +222,54 @@ struct task_struct *next_task(struct task_struct *p)
 }
 EXPORT_SYMBOL_GPL(next_task);
 
+#ifdef CONFIG_DEBUG_FS
+static int task_domain_nr_tasks_show(struct seq_file *m, void *v)
+{
+	struct task_domain *td = m->private;
+
+	seq_printf(m, "%lu\n", READ_ONCE(td->nr_tasks));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(task_domain_nr_tasks);
+
+static int task_domain_addr_show(struct seq_file *m, void *v)
+{
+	struct task_domain *td = m->private;
+
+	seq_printf(m, "%px\n", td);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(task_domain_addr);
+
+static int __init task_domains_debugfs_init(void)
+{
+	struct dentry *root;
+	int nid;
+
+	root = debugfs_create_dir("task_domains", NULL);
+	if (IS_ERR_OR_NULL(root))
+		return 0;
+
+	for (nid = 0; nid < nr_node_ids; nid++) {
+		struct dentry *dir;
+		char name[16];
+
+		snprintf(name, sizeof(name), "%d", nid);
+		dir = debugfs_create_dir(name, root);
+		if (IS_ERR_OR_NULL(dir))
+			continue;
+
+		debugfs_create_file("nr_tasks", 0444, dir, task_domains[nid],
+				    &task_domain_nr_tasks_fops);
+		debugfs_create_file("addr", 0444, dir, task_domains[nid],
+				    &task_domain_addr_fops);
+	}
+
+	return 0;
+}
+late_initcall(task_domains_debugfs_init);
+#endif
+
 static void __init init_task_domains(void)
 {
 	int nid;
-- 
2.43.0

