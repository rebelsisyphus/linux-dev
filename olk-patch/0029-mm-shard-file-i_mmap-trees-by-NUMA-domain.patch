+#if defined(CONFIG_SMP) && defined(CONFIG_DEBUG_FS)
+#define I_MMAP_DOMAIN_STAT_BITS		8
+#define I_MMAP_DOMAIN_STAT_SLOTS	(1U << I_MMAP_DOMAIN_STAT_BITS)
+#define I_MMAP_DOMAIN_STAT_MAX_NODES	64
+
+struct i_mmap_domain_stat_slot {
+	struct address_space *mapping;
+	atomic_long_t inserts[I_MMAP_DOMAIN_STAT_MAX_NODES];
+	atomic_long_t removes[I_MMAP_DOMAIN_STAT_MAX_NODES];
+	atomic_long_t collisions;
+};
+
+static struct i_mmap_domain_stat_slot i_mmap_domain_stats[I_MMAP_DOMAIN_STAT_SLOTS];
+
+static int i_mmap_domain_stat_nid(struct vm_area_struct *vma)
+{
+	int nid;
+
+	if (!vma->vm_mm)
+		return 0;
+
+	nid = READ_ONCE(vma->vm_mm->i_mmap_domain_nid);
+	if (unlikely(nid < 0 || nid >= nr_node_ids ||
+		     nid >= I_MMAP_DOMAIN_STAT_MAX_NODES))
+		return 0;
+	return nid;
+}
+
+static void i_mmap_domain_stat_account(struct address_space *mapping,
+				       struct vm_area_struct *vma,
+				       bool insert)
+{
+	struct i_mmap_domain_stat_slot *slot;
+	struct address_space *old;
+	unsigned int idx;
+	int nid;
+
+	if (!mapping || !vma)
+		return;
+
+	idx = hash_ptr(mapping, I_MMAP_DOMAIN_STAT_BITS);
+	slot = &i_mmap_domain_stats[idx];
+	old = READ_ONCE(slot->mapping);
+	if (!old) {
+		old = cmpxchg(&slot->mapping, NULL, mapping);
+		if (!old)
+			old = mapping;
+	}
+	if (old != mapping) {
+		atomic_long_inc(&slot->collisions);
+		return;
+	}
+
+	nid = i_mmap_domain_stat_nid(vma);
+	if (insert)
+		atomic_long_inc(&slot->inserts[nid]);
+	else
+		atomic_long_inc(&slot->removes[nid]);
+}
+
+void i_mmap_domain_stat_insert(struct address_space *mapping,
+			       struct vm_area_struct *vma)
+{
+	i_mmap_domain_stat_account(mapping, vma, true);
+}
+
+void i_mmap_domain_stat_remove(struct address_space *mapping,
+			       struct vm_area_struct *vma)
+{
+	i_mmap_domain_stat_account(mapping, vma, false);
+}
+
+static int i_mmap_domain_stats_show(struct seq_file *m, void *v)
+{
+	unsigned int i;
+
+	seq_puts(m, "slot mapping nid inserts removes collisions\n");
+	for (i = 0; i < I_MMAP_DOMAIN_STAT_SLOTS; i++) {
+		struct i_mmap_domain_stat_slot *slot = &i_mmap_domain_stats[i];
+		struct address_space *mapping = READ_ONCE(slot->mapping);
+		long collisions = atomic_long_read(&slot->collisions);
+		int nid, max_nid = min(nr_node_ids, I_MMAP_DOMAIN_STAT_MAX_NODES);
+		bool printed = false;
+
+		for (nid = 0; nid < max_nid; nid++) {
+			long inserts = atomic_long_read(&slot->inserts[nid]);
+			long removes = atomic_long_read(&slot->removes[nid]);
+
+			if (!inserts && !removes)
+				continue;
+			seq_printf(m, "%u %px %d %ld %ld %ld\n",
+				   i, mapping, nid, inserts, removes, collisions);
+			printed = true;
+		}
+		if (!printed && collisions)
+			seq_printf(m, "%u %px -1 0 0 %ld\n",
+				   i, mapping, collisions);
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(i_mmap_domain_stats);
+
+static int __init i_mmap_domain_stats_debugfs_init(void)
+{
+	debugfs_create_file("mm_i_mmap_domain_stats", 0444, NULL, NULL,
+			    &i_mmap_domain_stats_fops);
+	return 0;
+}
+late_initcall(i_mmap_domain_stats_debugfs_init);
+#else
+void i_mmap_domain_stat_insert(struct address_space *mapping,
+			       struct vm_area_struct *vma) { }
+void i_mmap_domain_stat_remove(struct address_space *mapping,
+			       struct vm_area_struct *vma) { }
+#endif
+
+
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+static int i_mmap_vma_nid(struct vm_area_struct *vma)
+{
+	int nid;
+
+	if (!vma || !vma->vm_mm)
+		return 0;
+
+	nid = READ_ONCE(vma->vm_mm->i_mmap_domain_nid);
+	if (unlikely(nid < 0 || nid >= nr_node_ids))
+		return 0;
+	return nid;
+}
+
+static bool i_mmap_can_shard(struct address_space *mapping,
+			     struct vm_area_struct *vma)
+{
+	if (!mapping || !mapping->host || !vma || !vma->vm_file)
+		return false;
+	if (vma_is_dax(vma))
+		return false;
+	if (is_vm_hugetlb_page(vma) || is_file_hugepages(vma->vm_file))
+		return false;
+	return true;
+}
+
+bool i_mmap_mapping_sharded(struct address_space *mapping)
+{
+	return smp_load_acquire(&mapping->i_mmap_shards) != NULL;
+}
+
+static struct i_mmap_shards *i_mmap_shards_alloc(void)
+{
+	struct i_mmap_shards *shards;
+	unsigned int i, nr = max_t(unsigned int, nr_node_ids, 1);
+	size_t size;
+
+	if (nr > I_MMAP_DOMAIN_MAX_SHARDS)
+		return NULL;
+
+	size = struct_size(shards, shard, nr);
+	shards = kzalloc(size, GFP_KERNEL);
+	if (!shards)
+		return NULL;
+	shards->nr = nr;
+	for (i = 0; i < nr; i++) {
+		shards->shard[i].root = RB_ROOT_CACHED;
+		init_rwsem(&shards->shard[i].rwsem);
+	}
+	return shards;
+}
+
+bool i_mmap_try_shard_mapping(struct address_space *mapping,
+			      struct vm_area_struct *vma)
+{
+	struct i_mmap_shards *new, *shards;
+	struct vm_area_struct *iter;
+	long migrated = 0;
+
+	if (!i_mmap_can_shard(mapping, vma))
+		return false;
+	if (i_mmap_mapping_sharded(mapping))
+		return true;
+
+	new = i_mmap_shards_alloc();
+	if (!new)
+		return false;
+
+	i_mmap_lock_write(mapping);
+	shards = smp_load_acquire(&mapping->i_mmap_shards);
+	if (!shards) {
+		while ((iter = vma_interval_tree_iter_first(&mapping->i_mmap,
+							   0, ULONG_MAX))) {
+			int nid = i_mmap_vma_nid(iter);
+
+			if ((unsigned int)nid >= new->nr)
+				nid = 0;
+			vma_interval_tree_remove(iter, &mapping->i_mmap);
+			vma_interval_tree_insert(iter, &new->shard[nid].root);
+			migrated++;
+		}
+		atomic_long_set(&mapping->i_mmap_count, migrated);
+		smp_store_release(&mapping->i_mmap_shards, new);
+		new = NULL;
+	}
+	i_mmap_unlock_write(mapping);
+
+	kfree(new);
+	return i_mmap_mapping_sharded(mapping);
+}
+
+static struct i_mmap_shard *i_mmap_shard_for_vma(struct address_space *mapping,
+						 struct vm_area_struct *vma)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+	int nid = i_mmap_vma_nid(vma);
+
+	if (WARN_ON_ONCE(!shards))
+		return NULL;
+	if ((unsigned int)nid >= shards->nr)
+		nid = 0;
+	return &shards->shard[nid];
+}
+
+unsigned int i_mmap_nr_roots(struct address_space *mapping)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+
+	return shards ? shards->nr : 1;
+}
+
+struct rb_root_cached *i_mmap_root(struct address_space *mapping,
+				   unsigned int index)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+
+	if (!shards)
+		return &mapping->i_mmap;
+	if (WARN_ON_ONCE(index >= shards->nr))
+		index = 0;
+	return &shards->shard[index].root;
+}
+
+bool i_mmap_trylock_read_root(struct address_space *mapping, unsigned int index)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+
+	if (!shards)
+		return i_mmap_trylock_read(mapping);
+	if (WARN_ON_ONCE(index >= shards->nr))
+		index = 0;
+	return down_read_trylock(&shards->shard[index].rwsem);
+}
+
+void i_mmap_lock_read_root(struct address_space *mapping, unsigned int index)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+
+	if (!shards) {
+		i_mmap_lock_read(mapping);
+		return;
+	}
+	if (WARN_ON_ONCE(index >= shards->nr))
+		index = 0;
+	down_read(&shards->shard[index].rwsem);
+}
+
+void i_mmap_unlock_read_root(struct address_space *mapping, unsigned int index)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+
+	if (!shards) {
+		i_mmap_unlock_read(mapping);
+		return;
+	}
+	if (WARN_ON_ONCE(index >= shards->nr))
+		index = 0;
+	up_read(&shards->shard[index].rwsem);
+}
+
+void i_mmap_lock_write_vma(struct address_space *mapping,
+			   struct vm_area_struct *vma)
+{
+	struct i_mmap_shard *shard;
+
+	for (;;) {
+		if (i_mmap_mapping_sharded(mapping)) {
+			shard = i_mmap_shard_for_vma(mapping, vma);
+			if (shard)
+				down_write(&shard->rwsem);
+			return;
+		}
+
+		i_mmap_lock_write(mapping);
+		if (!i_mmap_mapping_sharded(mapping))
+			return;
+		i_mmap_unlock_write(mapping);
+	}
+}
+
+void i_mmap_unlock_write_vma(struct address_space *mapping,
+			     struct vm_area_struct *vma)
+{
+	struct i_mmap_shard *shard;
+
+	if (!i_mmap_mapping_sharded(mapping)) {
+		i_mmap_unlock_write(mapping);
+		return;
+	}
+	shard = i_mmap_shard_for_vma(mapping, vma);
+	if (shard)
+		up_write(&shard->rwsem);
+}
+
+void i_mmap_lock_write_all(struct mm_struct *mm, struct address_space *mapping)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+	unsigned int i;
+
+	if (!shards) {
+		down_write_nest_lock(&mapping->i_mmap_rwsem, &mm->mmap_lock);
+		return;
+	}
+	for (i = 0; i < shards->nr; i++)
+		down_write_nest_lock(&shards->shard[i].rwsem, &mm->mmap_lock);
+}
+
+void i_mmap_unlock_write_all(struct address_space *mapping)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+	unsigned int i;
+
+	if (!shards) {
+		i_mmap_unlock_write(mapping);
+		return;
+	}
+	for (i = shards->nr; i > 0; i--)
+		up_write(&shards->shard[i - 1].rwsem);
+}
+
+void i_mmap_insert_vma(struct address_space *mapping, struct vm_area_struct *vma)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+	struct rb_root_cached *root = &mapping->i_mmap;
+	int nid;
+
+	if (shards) {
+		nid = i_mmap_vma_nid(vma);
+		if ((unsigned int)nid >= shards->nr)
+			nid = 0;
+		root = &shards->shard[nid].root;
+	}
+	vma_interval_tree_insert(vma, root);
+	atomic_long_inc(&mapping->i_mmap_count);
+	i_mmap_domain_stat_insert(mapping, vma);
+}
+
+void i_mmap_insert_vma_after(struct address_space *mapping,
+			     struct vm_area_struct *vma,
+			     struct vm_area_struct *prev)
+{
+	struct i_mmap_shards *shards = smp_load_acquire(&mapping->i_mmap_shards);
+	struct rb_root_cached *root = &mapping->i_mmap;
+	int nid;
+
+	if (shards) {
+		nid = i_mmap_vma_nid(vma);
+		if ((unsigned int)nid >= shards->nr)
+			nid = 0;
+		root = &shards->shard[nid].root;
+		if (prev && i_mmap_vma_nid(prev) == nid)
+			vma_interval_tree_insert_after(vma, prev, root);
+		else
+			vma_interval_tree_insert(vma, root);
+	} else {
+		vma_interval_tree_insert_after(vma, prev, root);
+	}
+	atomic_long_inc(&mapping->i_mmap_count);
+	i_mmap_domain_stat_insert(mapping, vma);
+}
+
