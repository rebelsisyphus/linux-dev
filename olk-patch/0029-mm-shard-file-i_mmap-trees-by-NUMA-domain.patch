@@ -1027,19 +1037,25 @@ static void file_vma_link_batch_flush(struct file_vma_link_batch *fb)
 	if (!fb->count)
 		return;
 
-	i_mmap_lock_write(mapping);
+	i_mmap_try_shard_mapping(mapping, fb->children[0]);
+	i_mmap_lock_write_vma(mapping, fb->children[0]);
 	for (i = 0; i < fb->count; i++) {
 		if (fb->children[i]->vm_flags & VM_SHARED)
 			mapping_allow_writable(mapping);
 	}
 	flush_dcache_mmap_lock(mapping);
 	for (i = 0; i < fb->count; i++) {
-		/* insert child into the share list, just after parent */
-		vma_interval_tree_insert_after(fb->children[i], fb->parents[i],
-					       &mapping->i_mmap);
+		if (i_mmap_mapping_sharded(mapping)) {
+			i_mmap_insert_vma_after(mapping, fb->children[i], fb->parents[i]);
+		} else {
+			/* insert child into the share list, just after parent */
+			vma_interval_tree_insert_after(fb->children[i], fb->parents[i],
+						       &mapping->i_mmap);
+			i_mmap_insert_vma_account(mapping, fb->children[i]);
+		}
 	}
 	flush_dcache_mmap_unlock(mapping);
-	i_mmap_unlock_write(mapping);
+	i_mmap_unlock_write_vma(mapping, fb->children[0]);
 
 	file_vma_link_batch_init(fb);
 }
