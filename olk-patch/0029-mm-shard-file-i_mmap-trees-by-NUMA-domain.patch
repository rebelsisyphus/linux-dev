 }
 EXPORT_SYMBOL_GPL(next_task);
 
+static int task_domain_select_nid(struct task_struct *p)
+{
+	int nid = cpu_to_node(task_cpu(p));
+
+	if (unlikely(nid == NUMA_NO_NODE || nid >= nr_node_ids))
+		nid = 0;
+	return nid;
+}
