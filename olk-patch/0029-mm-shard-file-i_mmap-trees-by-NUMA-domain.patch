  */
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+#define I_MMAP_DOMAIN_MAX_SHARDS	8
+
+struct i_mmap_shard {
+	struct rb_root_cached	root;
+	struct rw_semaphore	rwsem;
+};
+
+struct i_mmap_shards {
+	unsigned int		nr;
+	struct i_mmap_shard	shard[];
+};
+#endif
+
 struct address_space {
 	struct inode		*host;
 	struct xarray		i_pages;
@@ -504,6 +520,10 @@ struct address_space {
 	atomic_t		nr_thps;
 #endif
 	struct rb_root_cached	i_mmap;
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+	struct i_mmap_shards	*i_mmap_shards;
+	atomic_long_t		i_mmap_count;
+#endif
 	unsigned long		nrpages;
 	pgoff_t			writeback_index;
 	const struct address_space_operations *a_ops;
@@ -586,6 +606,10 @@ static inline void i_mmap_assert_write_locked(struct address_space *mapping)
  */
 static inline int mapping_mapped(struct address_space *mapping)
 {
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+	if (atomic_long_read(&mapping->i_mmap_count) > 0)
+		return true;
+#endif
 	return	!RB_EMPTY_ROOT(&mapping->i_mmap.rb_root);
 }
 
