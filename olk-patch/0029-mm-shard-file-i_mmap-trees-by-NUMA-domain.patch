diff --git a/mm/Kconfig b/mm/Kconfig
index 123ac31913c7..cd6a95ebbc2e 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -2,6 +2,15 @@
 
 menu "Memory Management options"
 
+config NUMA_DOMAIN_I_MMAP_SHARDS
+	bool "Experimental per-NUMA i_mmap shards"
+	depends on MMU && SMP && NUMA && EXPERT
+	default n
+	help
+	  Split ordinary file reverse mapping interval trees across NUMA
+	  domains to reduce i_mmap_rwsem contention in high-concurrency
+	  fork/exit workloads. This is experimental and disabled by default.
+
 #
 # For some reason microblaze and nios2 hard code SWAP=n.  Hopefully we can
 # add proper SWAP support to them, in which case this can be remove.
diff --git a/mm/internal.h b/mm/internal.h
index 99bf12fdbdda..e582b1863a2b 100644
--- a/mm/internal.h
+++ b/mm/internal.h
@@ -1504,6 +1504,91 @@ void unlink_file_vma_batch_init(struct unlink_vma_file_batch *);
 void unlink_file_vma_batch_add(struct unlink_vma_file_batch *, struct vm_area_struct *);
 void unlink_file_vma_batch_final(struct unlink_vma_file_batch *);
 
+void i_mmap_domain_stat_insert(struct address_space *mapping,
+			       struct vm_area_struct *vma);
+void i_mmap_domain_stat_remove(struct address_space *mapping,
+			       struct vm_area_struct *vma);
+
+static inline void i_mmap_insert_vma_account(struct address_space *mapping,
+					     struct vm_area_struct *vma)
+{
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+	atomic_long_inc(&mapping->i_mmap_count);
+#endif
+	i_mmap_domain_stat_insert(mapping, vma);
+}
+
+#ifdef CONFIG_NUMA_DOMAIN_I_MMAP_SHARDS
+bool i_mmap_try_shard_mapping(struct address_space *mapping,
+			      struct vm_area_struct *vma);
+bool i_mmap_mapping_sharded(struct address_space *mapping);
+unsigned int i_mmap_nr_roots(struct address_space *mapping);
+struct rb_root_cached *i_mmap_root(struct address_space *mapping,
+				   unsigned int index);
+bool i_mmap_trylock_read_root(struct address_space *mapping,
+			      unsigned int index);
+void i_mmap_lock_read_root(struct address_space *mapping, unsigned int index);
+void i_mmap_unlock_read_root(struct address_space *mapping, unsigned int index);
+void i_mmap_lock_write_vma(struct address_space *mapping,
+			   struct vm_area_struct *vma);
+void i_mmap_unlock_write_vma(struct address_space *mapping,
+			     struct vm_area_struct *vma);
+void i_mmap_lock_write_all(struct mm_struct *mm, struct address_space *mapping);
+void i_mmap_unlock_write_all(struct address_space *mapping);
+void i_mmap_insert_vma(struct address_space *mapping,
+		       struct vm_area_struct *vma);
+void i_mmap_insert_vma_after(struct address_space *mapping,
+			     struct vm_area_struct *vma,
+			     struct vm_area_struct *prev);
+void i_mmap_remove_vma(struct address_space *mapping,
+		       struct vm_area_struct *vma);
+#else
+static inline bool i_mmap_try_shard_mapping(struct address_space *mapping,
+					    struct vm_area_struct *vma) { return false; }
+static inline bool i_mmap_mapping_sharded(struct address_space *mapping) { return false; }
+static inline unsigned int i_mmap_nr_roots(struct address_space *mapping) { return 1; }
+static inline struct rb_root_cached *i_mmap_root(struct address_space *mapping,
+						 unsigned int index) { return &mapping->i_mmap; }
+static inline bool i_mmap_trylock_read_root(struct address_space *mapping,
+					    unsigned int index) { return i_mmap_trylock_read(mapping); }
+static inline void i_mmap_lock_read_root(struct address_space *mapping,
+					 unsigned int index) { i_mmap_lock_read(mapping); }
+static inline void i_mmap_unlock_read_root(struct address_space *mapping,
+					   unsigned int index) { i_mmap_unlock_read(mapping); }
+static inline void i_mmap_lock_write_vma(struct address_space *mapping,
+					 struct vm_area_struct *vma) { i_mmap_lock_write(mapping); }
+static inline void i_mmap_unlock_write_vma(struct address_space *mapping,
+					   struct vm_area_struct *vma) { i_mmap_unlock_write(mapping); }
+static inline void i_mmap_lock_write_all(struct mm_struct *mm,
+					 struct address_space *mapping)
+{
+	down_write_nest_lock(&mapping->i_mmap_rwsem, &mm->mmap_lock);
+}
+static inline void i_mmap_unlock_write_all(struct address_space *mapping)
+{
+	i_mmap_unlock_write(mapping);
+}
+static inline void i_mmap_insert_vma(struct address_space *mapping,
+				     struct vm_area_struct *vma)
+{
+	vma_interval_tree_insert(vma, &mapping->i_mmap);
+	i_mmap_domain_stat_insert(mapping, vma);
+}
+static inline void i_mmap_insert_vma_after(struct address_space *mapping,
+					   struct vm_area_struct *vma,
+					   struct vm_area_struct *prev)
+{
+	vma_interval_tree_insert_after(vma, prev, &mapping->i_mmap);
+	i_mmap_domain_stat_insert(mapping, vma);
+}
+static inline void i_mmap_remove_vma(struct address_space *mapping,
+				     struct vm_area_struct *vma)
+{
+	vma_interval_tree_remove(vma, &mapping->i_mmap);
+	i_mmap_domain_stat_remove(mapping, vma);
+}
+#endif
+
 /* Only track the nodes of mappings with shadow entries */
 void workingset_update_node(struct xa_node *node);
 extern struct list_lru shadow_nodes;
