+	return 0;
+}
+
+int i_mmap_read_walk(struct address_space *mapping, pgoff_t start,
+		     pgoff_t last, bool try_lock, i_mmap_walk_fn fn,
+		     void *arg)
+{
+	struct i_mmap_shards *shards;
+	struct vm_area_struct *vma;
+	int ret;
+
+	shards = i_mmap_shards_load(mapping);
