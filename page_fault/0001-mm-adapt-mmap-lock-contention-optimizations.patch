+		return i_mmap_read_walk_shards(shards, start, last, try_lock,
+					       fn, arg);
+	}
+
+	vma_interval_tree_foreach(vma, &mapping->i_mmap, start, last) {
+		ret = fn(vma, arg);
+		if (ret) {
+			i_mmap_unlock_read(mapping);
+			return ret;
+		}
+	}
+
+	i_mmap_unlock_read(mapping);
+	return 0;
+}
