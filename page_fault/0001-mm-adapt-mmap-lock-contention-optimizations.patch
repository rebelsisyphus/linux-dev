+static int dax_mkclean_vma(struct vm_area_struct *vma, void *arg)
+{
+	struct dax_mkclean_walk *walk = arg;
+
+	pfn_mkclean_range(walk->pfn, walk->count, walk->index, vma);
+	cond_resched();
+	return 0;
