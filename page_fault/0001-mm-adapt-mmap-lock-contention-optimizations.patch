+	KABI_USE(1, struct i_mmap_shards *i_mmap_shards)
+	KABI_USE(2, atomic_t i_mmap_trylock_fails)
 	KABI_RESERVE(3)
 	KABI_RESERVE(4)
 	KABI_RESERVE(5)
@@ -586,6 +625,11 @@ static inline void i_mmap_assert_write_locked(struct address_space *mapping)
  */
 static inline int mapping_mapped(struct address_space *mapping)
 {
+	struct i_mmap_shards *shards = READ_ONCE(mapping->i_mmap_shards);
+
+	if (shards)
+		return atomic_read(&shards->nr_vmas) > 0;
+
 	return	!RB_EMPTY_ROOT(&mapping->i_mmap.rb_root);
 }
 
