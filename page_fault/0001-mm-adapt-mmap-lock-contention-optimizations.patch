@@ -483,6 +520,8 @@ extern const struct address_space_operations empty_aops;
  * @i_mmap_writable: Number of VM_SHARED mappings.
  * @nr_thps: Number of THPs in the pagecache (non-shmem only).
  * @i_mmap: Tree of private and shared mappings.
+ * @i_mmap_shards: Optional distributed i_mmap trees and locks.
+ * @i_mmap_trylock_fails: Contention counter for dynamic i_mmap sharding.
  * @i_mmap_rwsem: Protects @i_mmap and @i_mmap_writable.
  * @nrpages: Number of page entries, protected by the i_pages lock.
  * @writeback_index: Writeback starts here.
@@ -514,8 +553,8 @@ struct address_space {
 	struct rw_semaphore	i_mmap_rwsem;
 	void			*private_data;
 
