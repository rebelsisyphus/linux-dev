+{
+	struct i_mmap_shards *shards;
+	unsigned int i;
+
+	shards = kzalloc(struct_size(shards, shard, I_MMAP_NR_SHARDS), gfp);
+	if (!shards)
+		return NULL;
+
+	shards->nr_shards = I_MMAP_NR_SHARDS;
