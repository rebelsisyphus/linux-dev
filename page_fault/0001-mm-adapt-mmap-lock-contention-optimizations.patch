+	if (i_mmap_shards_load(mapping))
+		return i_mmap_lock_vmas_write(mapping, locked, vmas, count);
+
+	i_mmap_maybe_install_shards(mapping);
+	return i_mmap_lock_vmas_write(mapping, locked, vmas, count);
