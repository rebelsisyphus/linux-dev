+bool i_mmap_shards_install_locked(struct address_space *mapping,
+				  struct i_mmap_shards *shards)
+{
+	struct rb_root_cached *root = &mapping->i_mmap;
+	struct vm_area_struct *vma;
+	unsigned int nr_vmas = 0;
+
+	i_mmap_assert_write_locked(mapping);
+
+	if (READ_ONCE(mapping->i_mmap_shards))
+		return false;
+
+	while ((vma = vma_interval_tree_iter_first(root, 0, ULONG_MAX))) {
+		struct i_mmap_shard *shard;
+
+		vma_interval_tree_remove(vma, root);
+		shard = &shards->shard[i_mmap_shard_index(shards, vma)];
+		vma_interval_tree_insert(vma, &shard->tree);
+		nr_vmas++;
+	}
+
+	atomic_set(&shards->nr_vmas, nr_vmas);
+	/* Publish only after all moved VMAs and counters are visible. */
+	smp_store_release(&mapping->i_mmap_shards, shards);
