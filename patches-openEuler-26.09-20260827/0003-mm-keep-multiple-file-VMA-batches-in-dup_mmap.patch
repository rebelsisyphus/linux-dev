From 6362fe188a2d4289a21f5cc02d2486d8e55d053a Mon Sep 17 00:00:00 2001
Message-ID: <6362fe188a2d4289a21f5cc02d2486d8e55d053a.1787813260.git.dongchenchen2@huawei.com>
In-Reply-To: <cover.1787813260.git.dongchenchen2@huawei.com>
References: <cover.1787813260.git.dongchenchen2@huawei.com>
From: Dong Chenchen <dongchenchen2@huawei.com>
Date: Tue, 12 May 2026 23:25:09 +0800
Subject: [PATCH openEuler-26.09 03/25] mm: keep multiple file VMA batches in
 dup_mmap

hulk inclusion
category: feature
bugzilla: https://atomgit.com/openeuler/kernel/issues/9771

--------------------------------

The dup_mmap() file VMA batching path only keeps one active
address_space batch.  It has to flush whenever the next file-backed
VMA belongs to a different mapping, even if both mappings can be
safely deferred until the next page-table-copy boundary.

Keep a small fixed set of active batches so fork can continue
coalescing insertions for several mappings at once.  Flush all
pending file VMA insertions before copy_page_range() when the VMA
requires page-table copying, and before arch_dup_mmap(), preserving
the original ordering at those boundaries.

Signed-off-by: Dong Chenchen <dongchenchen2@huawei.com>
---
 kernel/fork.c | 74 ++++++++++++++++++++++++++++++++++-----------------
 1 file changed, 50 insertions(+), 24 deletions(-)

diff --git a/kernel/fork.c b/kernel/fork.c
index 0d3f37ea2cd6..971cbdf21a85 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -670,6 +670,8 @@ static void dup_mm_exe_file(struct mm_struct *mm, struct mm_struct *oldmm)
 }
 
 #ifdef CONFIG_MMU
+#define DUP_MMAP_FILE_BATCH_NR	4
+
 struct dup_mmap_file_batch {
 	struct address_space *mapping;
 	unsigned int count;
@@ -705,24 +707,6 @@ static void dup_mmap_file_batch_flush(struct dup_mmap_file_batch *batch)
 	dup_mmap_file_batch_init(batch);
 }
 
-static void dup_mmap_file_batch_add(struct dup_mmap_file_batch *batch,
-				    struct vm_area_struct *vma,
-				    struct vm_area_struct *prev)
-{
-	struct address_space *mapping = vma->vm_file->f_mapping;
-
-	if (batch->count && batch->mapping != mapping)
-		dup_mmap_file_batch_flush(batch);
-
-	batch->mapping = mapping;
-	batch->vmas[batch->count] = vma;
-	batch->prev[batch->count] = prev;
-	batch->count++;
-
-	if (batch->count == ARRAY_SIZE(batch->vmas))
-		dup_mmap_file_batch_flush(batch);
-}
-
 static bool dup_mmap_needs_page_copy(struct vm_area_struct *dst_vma,
 				     struct vm_area_struct *src_vma)
 {
@@ -743,14 +727,16 @@ static __latent_entropy int dup_mmap(struct mm_struct *mm,
 	unsigned long charge = 0;
 	LIST_HEAD(uf);
 	VMA_ITERATOR(vmi, mm, 0);
-	struct dup_mmap_file_batch file_batch;
+	struct dup_mmap_file_batch file_batches[DUP_MMAP_FILE_BATCH_NR];
+	unsigned int batch_idx;
 
 	uprobe_start_dup_mmap();
 	if (mmap_write_lock_killable(oldmm)) {
 		retval = -EINTR;
 		goto fail_uprobe_end;
 	}
-	dup_mmap_file_batch_init(&file_batch);
+	for (batch_idx = 0; batch_idx < DUP_MMAP_FILE_BATCH_NR; batch_idx++)
+		dup_mmap_file_batch_init(&file_batches[batch_idx]);
 	flush_cache_dup_mm(oldmm);
 	uprobe_dup_mmap(oldmm, mm);
 	/*
@@ -840,13 +826,50 @@ static __latent_entropy int dup_mmap(struct mm_struct *mm,
 
 		file = tmp->vm_file;
 		if (file) {
+			struct address_space *mapping = file->f_mapping;
+			struct dup_mmap_file_batch *batch = NULL;
+
 			get_file(file);
-			dup_mmap_file_batch_add(&file_batch, tmp, mpnt);
+			for (batch_idx = 0;
+			     batch_idx < DUP_MMAP_FILE_BATCH_NR; batch_idx++) {
+				if (file_batches[batch_idx].count &&
+				    file_batches[batch_idx].mapping == mapping) {
+					batch = &file_batches[batch_idx];
+					break;
+				}
+			}
+			if (!batch) {
+				for (batch_idx = 0;
+				     batch_idx < DUP_MMAP_FILE_BATCH_NR;
+				     batch_idx++) {
+					if (!file_batches[batch_idx].count) {
+						batch = &file_batches[batch_idx];
+						break;
+					}
+				}
+			}
+			if (!batch) {
+				batch = &file_batches[0];
+				dup_mmap_file_batch_flush(batch);
+			}
+
+			batch->mapping = mapping;
+			batch->vmas[batch->count] = tmp;
+			batch->prev[batch->count] = mpnt;
+			batch->count++;
+
+			if (batch->count == ARRAY_SIZE(batch->vmas))
+				dup_mmap_file_batch_flush(batch);
 		}
 
 		if (!(tmp->vm_flags & VM_WIPEONFORK)) {
-			if (dup_mmap_needs_page_copy(tmp, mpnt))
-				dup_mmap_file_batch_flush(&file_batch);
+			if (dup_mmap_needs_page_copy(tmp, mpnt)) {
+				for (batch_idx = 0;
+				     batch_idx < DUP_MMAP_FILE_BATCH_NR;
+				     batch_idx++)
+					dup_mmap_file_batch_flush(
+						&file_batches[batch_idx]);
+			}
 			retval = copy_page_range(tmp, mpnt);
 		}
 
@@ -856,9 +879,12 @@ static __latent_entropy int dup_mmap(struct mm_struct *mm,
 		}
 	}
 	/* a new mm has just been created */
+	for (batch_idx = 0; batch_idx < DUP_MMAP_FILE_BATCH_NR; batch_idx++)
+		dup_mmap_file_batch_flush(&file_batches[batch_idx]);
 	retval = arch_dup_mmap(oldmm, mm);
 loop_out:
-	dup_mmap_file_batch_flush(&file_batch);
+	for (batch_idx = 0; batch_idx < DUP_MMAP_FILE_BATCH_NR; batch_idx++)
+		dup_mmap_file_batch_flush(&file_batches[batch_idx]);
 	vma_iter_free(&vmi);
 	if (!retval) {
 		mt_set_in_rcu(vmi.mas.tree);
-- 
