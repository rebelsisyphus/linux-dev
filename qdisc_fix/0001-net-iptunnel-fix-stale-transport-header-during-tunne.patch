 drivers/net/bareudp.c          | 2 ++
 drivers/net/geneve.c           | 6 ++++--
 drivers/net/gtp.c              | 1 +
 drivers/net/pfcp.c             | 1 +
 drivers/net/vxlan/vxlan_core.c | 1 +
 include/linux/skbuff.h         | 5 +++++
 net/ipv4/ip_tunnel.c           | 2 ++
