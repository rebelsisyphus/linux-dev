+// SPDX-License-Identifier: GPL-2.0
+#include <linux/bpf.h>
+#include <linux/if_link.h>
+#include <linux/limits.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <libgen.h>
+#include <net/if.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <bpf/bpf.h>
+#include <bpf/libbpf.h>
+
+#define MAX_CPUS 64
+#define FLOW_FAMILY_V4 2
+#define FLOW_FAMILY_V6 10
+
+enum rfs_strategy {
+	RFS_STRATEGY_PROCESS_CPU,
+	RFS_STRATEGY_CLUSTER_OTHER,
+	RFS_STRATEGY_NUMA_OTHER,
+};
+
+struct flow_key {
+	__u8 family;
+	__u8 proto;
+	__u16 sport;
+	__u16 dport;
+	union {
+		struct {
+			__u32 saddr;
+			__u32 daddr;
+		} v4;
+		struct {
+			__u32 saddr[4];
+			__u32 daddr[4];
+		} v6;
+	};
+};
+
+struct rps_config {
+	__u32 nr_cpus;
+	__u32 rfs_strategy;
+};
+
+struct flow_state {
+	__u32 active_cpu;
+	__u32 desired_cpu;
+	__u32 last_qtail;
+};
+
+struct cpu_group {
+	__u32 nr_cpus;
+	__u32 cpus[MAX_CPUS];
+};
+
+enum {
+	STAT_PASS,
+	STAT_RPS_REDIRECT,
+	STAT_RFS_REDIRECT,
+	STAT_FALLBACK_PASS,
+	STAT_DROP,
+	STAT_SOCKOPS_UPDATE,
+	STAT_RECV_ENTER,
+	STAT_RECV_BAD_FAMILY,
+	STAT_RECV_UPDATE,
+	STAT_MAX,
+};
+
+static const char *stat_names[STAT_MAX] = {
+	"pass",
+	"rps_redirect",
+	"rfs_redirect",
+	"fallback_pass",
+	"drop",
+	"sockops_update",
+	"recv_enter",
+	"recv_bad_family",
+	"recv_update",
+};
+
+static __u32 xdp_flags = XDP_FLAGS_UPDATE_IF_NOEXIST;
+static int ifindex;
+static sig_atomic_t exiting;
+
+static void int_exit(int sig)
+{
+	exiting = true;
+}
+
+static int bump_memlock_rlimit(void)
+{
+	struct rlimit rlim = {
+		.rlim_cur = RLIM_INFINITY,
+		.rlim_max = RLIM_INFINITY,
+	};
+
+	return setrlimit(RLIMIT_MEMLOCK, &rlim);
+}
+
+static int parse_cpu_list(const char *arg, __u32 *cpus, __u32 *nr_cpus)
+{
+	char *list, *p, *tok;
+	__u32 nr = 0;
+
+	list = strdup(arg);
+	if (!list)
+		return -ENOMEM;
+
+	p = list;
+	while ((tok = strsep(&p, ",")) != NULL) {
+		char *dash, *end;
+		unsigned long first, last, cpu;
+
+		if (!*tok)
+			continue;
+
+		dash = strchr(tok, '-');
+		if (dash)
+			*dash = '\0';
+
+		errno = 0;
+		first = strtoul(tok, &end, 10);
+		if (errno || *end)
+			goto invalid;
+
+		if (dash) {
+			last = strtoul(dash + 1, &end, 10);
+			if (errno || *end || last < first)
+				goto invalid;
+		} else {
+			last = first;
+		}
+
+		for (cpu = first; cpu <= last; cpu++) {
+			if (nr == MAX_CPUS || cpu >= MAX_CPUS)
+				goto invalid;
+			cpus[nr++] = cpu;
+		}
+	}
+
+	free(list);
+	if (!nr)
+		return -EINVAL;
+
+	*nr_cpus = nr;
+	return 0;
+
+invalid:
+	free(list);
+	return -EINVAL;
+}
+
+static int read_cpu_list_file(const char *path, __u32 *cpus, __u32 *nr_cpus)
+{
+	char buf[4096];
+	FILE *file;
+	int err;
+
+	file = fopen(path, "r");
+	if (!file)
+		return -errno;
+
+	if (!fgets(buf, sizeof(buf), file)) {
+		err = ferror(file) ? -errno : -EINVAL;
+		fclose(file);
+		return err;
+	}
+	fclose(file);
+
+	buf[strcspn(buf, "\n")] = '\0';
+	return parse_cpu_list(buf, cpus, nr_cpus);
+}
+
+static bool cpu_in_list(__u32 cpu, const __u32 *cpus, __u32 nr_cpus)
+{
+	__u32 i;
+
+	for (i = 0; i < nr_cpus; i++) {
+		if (cpus[i] == cpu)
+			return true;
+	}
+
+	return false;
+}
+
+static int parse_strategy(const char *arg, __u32 *strategy)
+{
+	if (!strcmp(arg, "process")) {
+		*strategy = RFS_STRATEGY_PROCESS_CPU;
+		return 0;
+	}
+	if (!strcmp(arg, "cluster")) {
+		*strategy = RFS_STRATEGY_CLUSTER_OTHER;
+		return 0;
+	}
+	if (!strcmp(arg, "numa")) {
+		*strategy = RFS_STRATEGY_NUMA_OTHER;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static void build_group(struct cpu_group *group, __u32 app_cpu,
+			const __u32 *topo_cpus, __u32 nr_topo_cpus,
+			const __u32 *allowed_cpus, __u32 nr_allowed_cpus)
+{
+	__u32 i;
+
+	memset(group, 0, sizeof(*group));
+	for (i = 0; i < nr_topo_cpus; i++) {
+		__u32 cpu = topo_cpus[i];
+
+		if (cpu == app_cpu || cpu >= MAX_CPUS)
+			continue;
+		if (!cpu_in_list(cpu, allowed_cpus, nr_allowed_cpus))
+			continue;
+		group->cpus[group->nr_cpus++] = cpu;
+	}
+}
+
+static int read_cluster_group(__u32 cpu, __u32 *cpus, __u32 *nr_cpus)
+{
+	char path[PATH_MAX];
+
+	snprintf(path, sizeof(path),
+		 "/sys/devices/system/cpu/cpu%u/topology/cluster_cpus_list",
+		 cpu);
+	if (!read_cpu_list_file(path, cpus, nr_cpus))
+		return 0;
+
+	snprintf(path, sizeof(path),
+		 "/sys/devices/system/cpu/cpu%u/topology/package_cpus_list",
+		 cpu);
+	return read_cpu_list_file(path, cpus, nr_cpus);
+}
+
+static int read_numa_group(__u32 cpu, __u32 *cpus, __u32 *nr_cpus)
+{
+	char path[PATH_MAX];
+	struct stat st;
+	__u32 node;
+
+	for (node = 0; node < 1024; node++) {
+		snprintf(path, sizeof(path),
+			 "/sys/devices/system/node/node%u/cpulist", node);
+		if (stat(path, &st))
+			continue;
+		if (read_cpu_list_file(path, cpus, nr_cpus))
+			continue;
+		if (cpu_in_list(cpu, cpus, *nr_cpus))
+			return 0;
+	}
+
+	return -ENOENT;
+}
+
+static int parse_flow(const char *arg, struct flow_key *key)
+{
+	char *copy, *p, *proto, *src, *dst, *sport, *dport, *end;
+	unsigned long port;
+	int family;
+
+	copy = strdup(arg);
+	if (!copy)
+		return -ENOMEM;
+
+	p = copy;
+	proto = strsep(&p, ",");
+	src = strsep(&p, ",");
+	dst = strsep(&p, ",");
+	sport = strsep(&p, ",");
+	dport = strsep(&p, ",");
+	if (!proto || !src || !dst || !sport || !dport || strsep(&p, ","))
+		goto invalid;
+
+	memset(key, 0, sizeof(*key));
+	if (!strcmp(proto, "tcp4")) {
+		key->family = FLOW_FAMILY_V4;
+		key->proto = IPPROTO_TCP;
+		family = AF_INET;
+	} else if (!strcmp(proto, "udp4")) {
+		key->family = FLOW_FAMILY_V4;
+		key->proto = IPPROTO_UDP;
+		family = AF_INET;
+	} else if (!strcmp(proto, "tcp6")) {
+		key->family = FLOW_FAMILY_V6;
+		key->proto = IPPROTO_TCP;
+		family = AF_INET6;
+	} else if (!strcmp(proto, "udp6")) {
+		key->family = FLOW_FAMILY_V6;
+		key->proto = IPPROTO_UDP;
+		family = AF_INET6;
+	} else {
+		goto invalid;
+	}
+
+	if (family == AF_INET) {
+		if (inet_pton(family, src, &key->v4.saddr) != 1 ||
+		    inet_pton(family, dst, &key->v4.daddr) != 1)
+			goto invalid;
+	} else {
+		if (inet_pton(family, src, key->v6.saddr) != 1 ||
+		    inet_pton(family, dst, key->v6.daddr) != 1)
+			goto invalid;
+	}
+
+	errno = 0;
+	port = strtoul(sport, &end, 10);
+	if (errno || *end || port > 65535)
+		goto invalid;
+	key->sport = htons(port);
+
+	port = strtoul(dport, &end, 10);
+	if (errno || *end || port > 65535)
+		goto invalid;
+	key->dport = htons(port);
+
+	free(copy);
+	return 0;
+
+invalid:
+	free(copy);
+	return -EINVAL;
+}
+
+static int pinned_map_fd(const char *pin_dir, const char *name)
+{
+	char path[PATH_MAX];
+	int fd;
+
+	if (snprintf(path, sizeof(path), "%s/%s", pin_dir, name) >= sizeof(path))
+		return -ENAMETOOLONG;
+
+	fd = bpf_obj_get(path);
+	return fd < 0 ? -errno : fd;
+}
+
+static int update_rfs_flow(const char *pin_dir, const char *flow, __u32 cpu)
+{
+	struct flow_state old_state, state = {};
+	struct flow_key key;
+	int fd, err;
+
+	err = parse_flow(flow, &key);
+	if (err)
+		return err;
+
+	fd = pinned_map_fd(pin_dir, "flow_state");
+	if (fd < 0)
+		return fd;
+
+	if (!bpf_map_lookup_elem(fd, &key, &old_state))
+		state = old_state;
+	else
+		state.active_cpu = cpu;
+	state.desired_cpu = cpu;
+	err = bpf_map_update_elem(fd, &key, &state, BPF_ANY);
+	if (err)
+		err = -errno;
+	close(fd);
+	return err;
+}
+
+static int delete_rfs_flow(const char *pin_dir, const char *flow)
+{
+	struct flow_key key;
+	int fd, err;
+
+	err = parse_flow(flow, &key);
+	if (err)
+		return err;
+
+	fd = pinned_map_fd(pin_dir, "flow_state");
+	if (fd < 0)
+		return fd;
+
+	err = bpf_map_delete_elem(fd, &key);
+	if (err)
+		err = -errno;
+	close(fd);
+	return err;
+}
+
+static int print_stats(const char *pin_dir)
+{
+	__u64 values[STAT_MAX] = {}, *percpu;
+	int fd, nr_cpus, i, cpu;
+
+	fd = pinned_map_fd(pin_dir, "stats");
+	if (fd < 0)
+		return fd;
+
+	nr_cpus = libbpf_num_possible_cpus();
+	if (nr_cpus < 0) {
+		close(fd);
+		return nr_cpus;
+	}
+
+	percpu = calloc(nr_cpus, sizeof(*percpu));
+	if (!percpu) {
+		close(fd);
+		return -ENOMEM;
+	}
+
+	for (i = 0; i < STAT_MAX; i++) {
+		__u32 key = i;
+
+		if (bpf_map_lookup_elem(fd, &key, percpu))
+			continue;
+		for (cpu = 0; cpu < nr_cpus; cpu++)
+			values[i] += percpu[cpu];
+	}
+
+	for (i = 0; i < STAT_MAX; i++)
+		printf("%-16s %llu\n", stat_names[i], values[i]);
+
+	free(percpu);
+	close(fd);
+	return 0;
+}
+
+static int list_rfs_flows(const char *pin_dir)
+{
+	struct flow_key key, next_key;
+	struct flow_state state;
+	void *prev_key = NULL;
+	int fd, err;
+
+	fd = pinned_map_fd(pin_dir, "flow_state");
+	if (fd < 0)
+		return fd;
+
+	while (!bpf_map_get_next_key(fd, prev_key, &next_key)) {
+		if (!bpf_map_lookup_elem(fd, &next_key, &state)) {
+			printf("family %u proto %u sport %u dport %u",
+			       next_key.family, next_key.proto, ntohs(next_key.sport),
+			       ntohs(next_key.dport));
+			printf(" active_cpu %u desired_cpu %u last_qtail %u\n",
+			       state.active_cpu, state.desired_cpu,
+			       state.last_qtail);
+		}
+		key = next_key;
+		prev_key = &key;
+	}
+
+	err = errno == ENOENT ? 0 : -errno;
+	close(fd);
+	return err;
+}
+
+static int pin_maps_replace(struct bpf_object *obj, const char *pin_dir)
+{
+	struct bpf_map *map;
+	int err;
+
+	if (mkdir(pin_dir, 0755) && errno != EEXIST)
+		return -errno;
+
+	bpf_object__for_each_map(map, obj) {
+		const char *name = bpf_map__name(map);
+		char path[PATH_MAX];
+
+		if (snprintf(path, sizeof(path), "%s/%s", pin_dir, name) >=
+		    sizeof(path))
+			return -ENAMETOOLONG;
+
+		err = bpf_map__pin(map, path);
+		if (err == -EEXIST) {
+			if (unlink(path))
+				return -errno;
+			err = bpf_map__pin(map, path);
+		}
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
+static int populate_group_maps(int count_fd, int slot_fd, __u32 app_cpu,
+			       const struct cpu_group *group)
+{
+	__u32 i, zero = 0;
+	int err;
+
+	err = bpf_map_update_elem(count_fd, &app_cpu, &group->nr_cpus, 0);
+	if (err)
+		return err;
+
+	for (i = 0; i < MAX_CPUS; i++) {
+		__u32 key = app_cpu * MAX_CPUS + i;
+		__u32 value = i < group->nr_cpus ? group->cpus[i] : 0;
+
+		err = bpf_map_update_elem(slot_fd, &key, &value, 0);
+		if (err)
+			return err;
+	}
+
+	if (!group->nr_cpus)
+		return bpf_map_update_elem(count_fd, &app_cpu, &zero, 0);
+
+	return 0;
+}
+
+static int populate_topology_maps(struct bpf_object *obj, const __u32 *cpus,
+				  __u32 nr_cpus)
+{
+	int allowed_fd, cluster_count_fd, cluster_slot_fd;
+	int numa_count_fd, numa_slot_fd;
+	__u32 cpu;
+	int err;
+
+	allowed_fd = bpf_map__fd(bpf_object__find_map_by_name(obj, "allowed_cpus"));
+	cluster_count_fd = bpf_map__fd(bpf_object__find_map_by_name(obj,
+								    "cluster_cpu_counts"));
+	cluster_slot_fd = bpf_map__fd(bpf_object__find_map_by_name(obj,
+								   "cluster_cpu_slots"));
+	numa_count_fd = bpf_map__fd(bpf_object__find_map_by_name(obj,
+								 "numa_cpu_counts"));
+	numa_slot_fd = bpf_map__fd(bpf_object__find_map_by_name(obj,
+								"numa_cpu_slots"));
+	if (allowed_fd < 0 || cluster_count_fd < 0 || cluster_slot_fd < 0 ||
+	    numa_count_fd < 0 || numa_slot_fd < 0)
+		return -ENOENT;
+
+	for (cpu = 0; cpu < MAX_CPUS; cpu++) {
+		__u32 topo_cpus[MAX_CPUS], nr_topo_cpus = 0;
+		struct cpu_group group;
+		__u8 allowed;
+
+		allowed = cpu_in_list(cpu, cpus, nr_cpus);
+		err = bpf_map_update_elem(allowed_fd, &cpu, &allowed, 0);
+		if (err)
+			return err;
+
+		if (!read_cluster_group(cpu, topo_cpus, &nr_topo_cpus))
+			build_group(&group, cpu, topo_cpus, nr_topo_cpus,
+				    cpus, nr_cpus);
+		else
+			memset(&group, 0, sizeof(group));
+
+		err = populate_group_maps(cluster_count_fd, cluster_slot_fd,
+					  cpu, &group);
+		if (err)
+			return err;
+
+		if (!read_numa_group(cpu, topo_cpus, &nr_topo_cpus))
+			build_group(&group, cpu, topo_cpus, nr_topo_cpus,
+				    cpus, nr_cpus);
+		else
+			memset(&group, 0, sizeof(group));
+
+		err = populate_group_maps(numa_count_fd, numa_slot_fd,
+					  cpu, &group);
+		if (err)
+			return err;
+	}
+
+	return 0;
+}
+
+static int populate_maps(struct bpf_object *obj, __u32 *cpus, __u32 nr_cpus,
+			 __u32 qsize, __u32 rfs_strategy)
+{
+	int cpu_map_fd, cpu_slots_fd, config_fd;
+	struct bpf_cpumap_val cpu_val = {};
+	struct bpf_program *cpumap_prog;
+	struct rps_config cfg = {};
+	__u32 i, zero = 0;
+	int err;
+
+	cpu_map_fd = bpf_map__fd(bpf_object__find_map_by_name(obj, "cpu_map"));
+	cpu_slots_fd = bpf_map__fd(bpf_object__find_map_by_name(obj, "cpu_slots"));
+	config_fd = bpf_map__fd(bpf_object__find_map_by_name(obj, "config"));
+	if (cpu_map_fd < 0 || cpu_slots_fd < 0 || config_fd < 0)
+		return -ENOENT;
+
+	cpumap_prog = bpf_object__find_program_by_name(obj,
+						       "xdp_rps_rfs_cpumap");
+	if (!cpumap_prog)
+		return -ENOENT;
+
+	cpu_val.qsize = qsize;
+	cpu_val.bpf_prog.fd = bpf_program__fd(cpumap_prog);
+	for (i = 0; i < nr_cpus; i++) {
+		err = bpf_map_update_elem(cpu_map_fd, &cpus[i], &cpu_val, 0);
+		if (err)
+			return err;
+		err = bpf_map_update_elem(cpu_slots_fd, &i, &cpus[i], 0);
+		if (err)
+			return err;
+	}
+
+	cfg.nr_cpus = nr_cpus;
+	cfg.rfs_strategy = rfs_strategy;
+	err = bpf_map_update_elem(config_fd, &zero, &cfg, 0);
+	if (err)
+		return err;
+
+	return populate_topology_maps(obj, cpus, nr_cpus);
+}
+
+static int detach(void)
+{
+	if (!ifindex)
+		return -EINVAL;
+
+	return bpf_xdp_detach(ifindex, xdp_flags, NULL);
+}
+
+static struct bpf_link *attach_sockops(struct bpf_object *obj,
+				       const char *cgroup_path)
+{
+	struct bpf_program *prog;
+	struct bpf_link *link;
+	int cgroup_fd;
+
+	prog = bpf_object__find_program_by_name(obj, "xdp_rps_rfs_sockops");
+	if (!prog)
+		return NULL;
+
+	cgroup_fd = open(cgroup_path, O_RDONLY);
+	if (cgroup_fd < 0)
+		return NULL;
+
+	link = bpf_program__attach_cgroup(prog, cgroup_fd);
+	close(cgroup_fd);
+	if (libbpf_get_error(link))
+		return NULL;
+
+	return link;
+}
+
+static struct bpf_link *attach_recvmsg(struct bpf_object *obj)
+{
+	struct bpf_program *prog;
+	struct bpf_link *link;
+
+	prog = bpf_object__find_program_by_name(obj, "xdp_rps_rfs_tcp_recvmsg");
+	if (!prog)
+		return NULL;
+
+	link = bpf_program__attach_kprobe(prog, false, "tcp_recvmsg");
+	if (libbpf_get_error(link))
+		return NULL;
+
+	return link;
+}
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"Usage: %s -i <ifname|ifindex> -c <cpu-list> [OPTS]\n"
+		"       %s -p <dir> -r <flow> -t <cpu>\n"
+		"       %s -p <dir> -D <flow>\n"
+		"       %s -p <dir> -s\n"
+		"       %s -p <dir> -l\n"
+		"\nOPTS:\n"
+		"    -d           detach XDP program\n"
+		"    -S           use skb-mode\n"
+		"    -N           enforce native mode\n"
+		"    -F           force replacing existing XDP program\n"
+		"    -q <qsize>   CPUMAP queue size, default 2048\n"
+		"    -p <dir>     pin maps under directory for RFS updates\n"
+		"    -g <path>    attach sockops RFS updater to cgroup path\n"
+		"    -R           attach tcp_recvmsg hook for per-receive CPU updates\n"
+		"    -m <mode>    RFS CPU strategy: process, cluster, or numa\n"
+		"    -r <flow>    update RFS flow entry, format tcp4,src,dst,sport,dport\n"
+		"    -t <cpu>     target CPU for -r\n"
+		"    -D <flow>    delete RFS flow entry\n"
+		"    -s           print pinned map statistics\n"
+		"    -l           list pinned RFS flow states\n"
+		"\nExample:\n"
+		"    %s -i eth0 -c 0-3 -p /sys/fs/bpf/xdp_rps_rfs\n"
+		"    %s -i eth0 -c 0-3 -g /sys/fs/cgroup -m numa\n"
+		"    %s -p /sys/fs/bpf/xdp_rps_rfs -r tcp4,192.0.2.1,198.51.100.2,443,51514 -t 2\n",
+		prog, prog, prog, prog, prog, prog, prog, prog);
+}
+
+int main(int argc, char **argv)
+{
+	const char *pin_dir = NULL;
+	const char *cgroup_path = NULL;
+	const char *rfs_flow = NULL, *delete_flow = NULL;
+	struct bpf_link *sockops_link = NULL;
+	struct bpf_link *recvmsg_link = NULL;
+	struct bpf_program *prog;
+	struct bpf_object *obj;
+	__u32 cpus[MAX_CPUS];
+	__u32 nr_cpus = 0;
+	__u32 rfs_strategy = RFS_STRATEGY_PROCESS_CPU;
+	__u32 qsize = 2048;
+	char filename[256];
+	int prog_fd, opt;
+	__u32 rfs_cpu = 0;
+	bool have_rfs_cpu = false;
+	bool do_detach = false;
+	bool attach_recv = false;
+	bool show_stats = false;
+	bool list_flows = false;
+	int err;
+
+	while ((opt = getopt(argc, argv, "i:c:q:p:g:m:r:t:D:slRdSNFh")) != -1) {
+		switch (opt) {
+		case 'i':
+			ifindex = if_nametoindex(optarg);
+			if (!ifindex)
+				ifindex = atoi(optarg);
+			break;
+		case 'c':
+			err = parse_cpu_list(optarg, cpus, &nr_cpus);
+			if (err) {
+				fprintf(stderr, "invalid cpu list: %s\n", optarg);
+				return 1;
+			}
+			break;
+		case 'q':
+			qsize = atoi(optarg);
+			break;
+		case 'p':
+			pin_dir = optarg;
+			break;
+		case 'g':
+			cgroup_path = optarg;
+			break;
+		case 'm':
+			err = parse_strategy(optarg, &rfs_strategy);
+			if (err) {
+				fprintf(stderr, "invalid RFS strategy: %s\n",
+					optarg);
+				return 1;
+			}
+			break;
+		case 'r':
+			rfs_flow = optarg;
+			break;
+		case 't':
+			rfs_cpu = atoi(optarg);
+			have_rfs_cpu = true;
+			break;
+		case 'D':
+			delete_flow = optarg;
+			break;
+		case 's':
+			show_stats = true;
+			break;
+		case 'l':
+			list_flows = true;
+			break;
+		case 'R':
+			attach_recv = true;
+			break;
+		case 'd':
+			do_detach = true;
+			break;
+		case 'S':
+			xdp_flags |= XDP_FLAGS_SKB_MODE;
+			break;
+		case 'N':
+			xdp_flags |= XDP_FLAGS_DRV_MODE;
+			break;
+		case 'F':
+			xdp_flags &= ~XDP_FLAGS_UPDATE_IF_NOEXIST;
+			break;
+		default:
+			usage(basename(argv[0]));
+			return 1;
+		}
+	}
+
+	if (rfs_flow || delete_flow || show_stats || list_flows) {
+		if (!pin_dir || (rfs_flow && !have_rfs_cpu) ||
+		    (!!rfs_flow + !!delete_flow + !!show_stats + !!list_flows != 1)) {
+			usage(basename(argv[0]));
+			return 1;
+		}
+
+		if (rfs_flow)
+			err = update_rfs_flow(pin_dir, rfs_flow, rfs_cpu);
+		else if (delete_flow)
+			err = delete_rfs_flow(pin_dir, delete_flow);
+		else if (show_stats)
+			err = print_stats(pin_dir);
+		else
+			err = list_rfs_flows(pin_dir);
+
+		if (err) {
+			fprintf(stderr, "map operation failed: %s\n",
+				strerror(-err));
+			return 1;
+		}
+		return 0;
+	}
+
+	if (!ifindex || (!do_detach && !nr_cpus)) {
+		usage(basename(argv[0]));
+		return 1;
+	}
+
+	if (!(xdp_flags & (XDP_FLAGS_SKB_MODE | XDP_FLAGS_DRV_MODE)))
+		xdp_flags |= XDP_FLAGS_DRV_MODE;
+
+	if (do_detach)
+		return detach() ? 1 : 0;
+
+	if (bump_memlock_rlimit())
+		fprintf(stderr, "warning: failed to raise memlock rlimit: %s\n",
+			strerror(errno));
+
+	snprintf(filename, sizeof(filename), "%s_kern.o", argv[0]);
+	obj = bpf_object__open_file(filename, NULL);
+	if (libbpf_get_error(obj)) {
+		fprintf(stderr, "failed to open %s\n", filename);
+		return 1;
+	}
+
+	prog = bpf_object__find_program_by_name(obj, "xdp_rps_rfs_prog");
+	if (!prog) {
+		fprintf(stderr, "program xdp_rps_rfs_prog not found\n");
+		return 1;
+	}
+	bpf_program__set_type(prog, BPF_PROG_TYPE_XDP);
+
+	err = bpf_object__load(obj);
+	if (err) {
+		fprintf(stderr, "failed to load BPF object: %s\n", strerror(-err));
+		return 1;
+	}
+
+	err = populate_maps(obj, cpus, nr_cpus, qsize, rfs_strategy);
+	if (err) {
+		fprintf(stderr, "failed to populate maps: %s\n", strerror(errno));
+		return 1;
+	}
+
+	if (pin_dir) {
+		err = pin_maps_replace(obj, pin_dir);
+		if (err) {
+			fprintf(stderr, "failed to pin maps: %s\n", strerror(-err));
+			return 1;
+		}
+	}
+
+	prog_fd = bpf_program__fd(prog);
+	err = bpf_xdp_attach(ifindex, prog_fd, xdp_flags, NULL);
+	if (err) {
+		fprintf(stderr, "failed to attach XDP program: %s\n", strerror(errno));
+		return 1;
+	}
+
+	if (cgroup_path) {
+		sockops_link = attach_sockops(obj, cgroup_path);
+		if (!sockops_link) {
+			fprintf(stderr, "failed to attach sockops to %s\n",
+				cgroup_path);
+			detach();
+			return 1;
+		}
+	}
+
+	if (attach_recv) {
+		recvmsg_link = attach_recvmsg(obj);
+		if (!recvmsg_link) {
+			fprintf(stderr, "failed to attach tcp_recvmsg hook\n");
+			bpf_link__destroy(sockops_link);
+			detach();
+			return 1;
+		}
+	}
+
+	printf("attached xdp_rps_rfs to ifindex %d with %u CPUs\n",
+	       ifindex, nr_cpus);
+	if (cgroup_path)
+		printf("sockops RFS updater attached to %s\n", cgroup_path);
+	if (attach_recv)
+		printf("tcp_recvmsg RFS updater attached\n");
+	if (pin_dir)
+		printf("maps pinned at %s\n", pin_dir);
+	printf("press Ctrl-C to detach, or use `%s -d -i %d` later\n",
+	       basename(argv[0]), ifindex);
+
+	signal(SIGINT, int_exit);
+	signal(SIGTERM, int_exit);
+	while (!exiting)
+		pause();
+
+	bpf_link__destroy(sockops_link);
+	bpf_link__destroy(recvmsg_link);
+	return detach() ? 1 : 0;
+}
