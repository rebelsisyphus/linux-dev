diff --git a/samples/bpf/xdp_rps_rfs_kern.c b/samples/bpf/xdp_rps_rfs_kern.c
new file mode 100644
index 000000000000..705eaf613d62
--- /dev/null
+++ b/samples/bpf/xdp_rps_rfs_kern.c
@@ -0,0 +1,700 @@
+// SPDX-License-Identifier: GPL-2.0
+#define KBUILD_MODNAME "xdp_rps_rfs"
+
+#include <uapi/linux/bpf.h>
+#include <uapi/linux/if_ether.h>
+#include <uapi/linux/if_vlan.h>
+#include <uapi/linux/ip.h>
+#include <uapi/linux/ipv6.h>
+#include <uapi/asm/ptrace.h>
+#include <bpf/bpf_helpers.h>
+#include <bpf/bpf_tracing.h>
+#include <bpf/bpf_endian.h>
+
+#define MAX_CPUS 64
+#define MAX_FLOW_ENTRIES 65536
+#define FLOW_FAMILY_V4 2
+#define FLOW_FAMILY_V6 10
+#define IPPROTO_TCP 6
+#define IPPROTO_UDP 17
+#define SKC_DADDR_OFF 0
+#define SKC_RCV_SADDR_OFF 4
+#define SKC_DPORT_OFF 12
+#define SKC_NUM_OFF 14
+#define SKC_FAMILY_OFF 16
+
+struct rfs_in6_addr {
+	__u32 words[4];
+};
+
+struct rfs_hlist_node {
+	void *next;
+	void **pprev;
+};
+
+struct rfs_sock_common_prefix {
+	__u32 daddr;
+	__u32 rcv_saddr;
+	__u32 hash;
+	__u16 dport;
+	__u16 num;
+	__u16 family;
+	__u8 state;
+	__u8 flags;
+	int bound_dev_if;
+	struct rfs_hlist_node bind_node;
+	void *prot;
+	void *net;
+	struct rfs_in6_addr v6_daddr;
+	struct rfs_in6_addr v6_rcv_saddr;
+};
+
+#define SKC_V6_DADDR_OFF offsetof(struct rfs_sock_common_prefix, v6_daddr)
+#define SKC_V6_RCV_SADDR_OFF offsetof(struct rfs_sock_common_prefix, v6_rcv_saddr)
+
+struct pt_regs {
+	unsigned long r15;
+	unsigned long r14;
+	unsigned long r13;
+	unsigned long r12;
+	unsigned long rbp;
+	unsigned long rbx;
+	unsigned long r11;
+	unsigned long r10;
+	unsigned long r9;
+	unsigned long r8;
+	unsigned long rax;
+	unsigned long rcx;
+	unsigned long dx;
+	unsigned long si;
+	unsigned long di;
+	unsigned long orig_rax;
+	unsigned long rip;
+	unsigned long cs;
+	unsigned long eflags;
+	unsigned long rsp;
+	unsigned long ss;
+};
+
+enum rfs_strategy {
+	RFS_STRATEGY_PROCESS_CPU,
+	RFS_STRATEGY_CLUSTER_OTHER,
+	RFS_STRATEGY_NUMA_OTHER,
+};
+
+struct vlan_hdr {
+	__be16 h_vlan_TCI;
+	__be16 h_vlan_encapsulated_proto;
+};
+
+struct l4_ports {
+	__be16 source;
+	__be16 dest;
+};
+
+struct flow_key {
+	__u8 family;
+	__u8 proto;
+	__u16 sport;
+	__u16 dport;
+	union {
+		struct {
+			__u32 saddr;
+			__u32 daddr;
+		} v4;
+		struct {
+			__u32 saddr[4];
+			__u32 daddr[4];
+		} v6;
+	};
+};
+
+struct rps_config {
+	__u32 nr_cpus;
+	__u32 rfs_strategy;
+};
+
+struct flow_state {
+	__u32 active_cpu;
+	__u32 desired_cpu;
+	__u32 last_qtail;
+};
+
+enum {
+	STAT_PASS,
+	STAT_RPS_REDIRECT,
+	STAT_RFS_REDIRECT,
+	STAT_FALLBACK_PASS,
+	STAT_DROP,
+	STAT_SOCKOPS_UPDATE,
+	STAT_RECV_ENTER,
+	STAT_RECV_BAD_FAMILY,
+	STAT_RECV_UPDATE,
+	STAT_MAX,
+};
+
+struct {
+	__uint(type, BPF_MAP_TYPE_CPUMAP);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(struct bpf_cpumap_val));
+	__uint(max_entries, MAX_CPUS);
+} cpu_map SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(__u32));
+	__uint(max_entries, MAX_CPUS);
+} cpu_slots SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(struct rps_config));
+	__uint(max_entries, 1);
+} config SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(__u8));
+	__uint(max_entries, MAX_CPUS);
+} allowed_cpus SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(__u32));
+	__uint(max_entries, MAX_CPUS);
+} cluster_cpu_counts SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(__u32));
+	__uint(max_entries, MAX_CPUS * MAX_CPUS);
+} cluster_cpu_slots SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(max_entries, MAX_CPUS);
+	__uint(value_size, sizeof(__u32));
+} numa_cpu_counts SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(__u32));
+	__uint(max_entries, MAX_CPUS * MAX_CPUS);
+} numa_cpu_slots SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_LRU_HASH);
+	__uint(key_size, sizeof(struct flow_key));
+	__uint(value_size, sizeof(struct flow_state));
+	__uint(max_entries, MAX_FLOW_ENTRIES);
+} flow_state SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(__u32));
+	__uint(max_entries, MAX_CPUS);
+} cpu_queue_head SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(__u32));
+	__uint(max_entries, MAX_CPUS);
+} cpu_queue_tail SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_PERCPU_ARRAY);
+	__uint(key_size, sizeof(__u32));
+	__uint(value_size, sizeof(__u64));
+	__uint(max_entries, STAT_MAX);
+} stats SEC(".maps");
+
+static __always_inline void count(__u32 idx)
+{
+	__u64 *value;
+
+	value = bpf_map_lookup_elem(&stats, &idx);
+	if (value)
+		(*value)++;
+}
+
+static __always_inline __u32 hash_words(const __u32 *words)
+{
+	__u32 hash = 0x811c9dc5;
+	int i;
+
+#pragma unroll
+	for (i = 0; i < 12; i++) {
+		hash ^= words[i];
+		hash *= 0x01000193;
+		hash ^= hash >> 16;
+	}
+
+	return hash;
+}
+
+static __always_inline int parse_ports(void *data, void *data_end,
+				       __u8 proto, __u64 off,
+				       struct flow_key *key)
+{
+	struct l4_ports *ports;
+
+	if (proto != IPPROTO_TCP && proto != IPPROTO_UDP)
+		return 0;
+
+	ports = data + off;
+	if (ports + 1 > data_end)
+		return -1;
+
+	key->sport = ports->source;
+	key->dport = ports->dest;
+	return 0;
+}
+
+static __always_inline int parse_flow(struct xdp_md *ctx, struct flow_key *key,
+				      __u32 *hash)
+{
+	void *data_end = (void *)(long)ctx->data_end;
+	void *data = (void *)(long)ctx->data;
+	struct ethhdr *eth = data;
+	__u64 off = sizeof(*eth);
+	__u16 h_proto;
+
+	if (eth + 1 > data_end)
+		return -1;
+
+	h_proto = eth->h_proto;
+	if (h_proto == bpf_htons(ETH_P_8021Q) ||
+	    h_proto == bpf_htons(ETH_P_8021AD)) {
+		struct vlan_hdr *vh = data + off;
+
+		if (vh + 1 > data_end)
+			return -1;
+		h_proto = vh->h_vlan_encapsulated_proto;
+		off += sizeof(*vh);
+	}
+
+	if (h_proto == bpf_htons(ETH_P_IP)) {
+		struct iphdr *iph = data + off;
+		__u32 words[12] = {};
+
+		if (iph + 1 > data_end)
+			return -1;
+		if (iph->ihl < 5)
+			return -1;
+
+		key->family = FLOW_FAMILY_V4;
+		key->proto = iph->protocol;
+		key->v4.saddr = iph->saddr;
+		key->v4.daddr = iph->daddr;
+		off += iph->ihl * 4;
+		if (parse_ports(data, data_end, iph->protocol, off, key))
+			return -1;
+
+		words[0] = key->v4.saddr;
+		words[1] = key->v4.daddr;
+		words[2] = ((__u32)key->sport << 16) | key->dport;
+		words[3] = ((__u32)key->family << 24) | ((__u32)key->proto << 16);
+		*hash = hash_words(words);
+		return 0;
+	}
+
+	if (h_proto == bpf_htons(ETH_P_IPV6)) {
+		struct ipv6hdr *ip6h = data + off;
+		__u32 words[12];
+		int i;
+
+		if (ip6h + 1 > data_end)
+			return -1;
+
+		key->family = FLOW_FAMILY_V6;
+		key->proto = ip6h->nexthdr;
+#pragma unroll
+		for (i = 0; i < 4; i++) {
+			key->v6.saddr[i] = ip6h->saddr.s6_addr32[i];
+			key->v6.daddr[i] = ip6h->daddr.s6_addr32[i];
+			words[i] = key->v6.saddr[i];
+			words[i + 4] = key->v6.daddr[i];
+		}
+
+		off += sizeof(*ip6h);
+		if (parse_ports(data, data_end, ip6h->nexthdr, off, key))
+			return -1;
+
+		words[8] = ((__u32)key->sport << 16) | key->dport;
+		words[9] = ((__u32)key->family << 24) | ((__u32)key->proto << 16);
+		words[10] = 0;
+		words[11] = 0;
+		*hash = hash_words(words);
+		return 0;
+	}
+
+	return -1;
+}
+
+static __always_inline bool cpu_allowed(__u32 cpu)
+{
+	__u8 *allowed;
+
+	if (cpu >= MAX_CPUS)
+		return false;
+
+	allowed = bpf_map_lookup_elem(&allowed_cpus, &cpu);
+	return allowed && *allowed;
+}
+
+static __always_inline __u32 first_rps_cpu(void)
+{
+	__u32 zero = 0, *cpu;
+
+	cpu = bpf_map_lookup_elem(&cpu_slots, &zero);
+	if (cpu)
+		return *cpu;
+
+	return 0;
+}
+
+static __always_inline __u32 cluster_cpu(__u32 app_cpu, __u32 hash)
+{
+	__u32 *nr_cpus, *cpu, key, slot;
+
+	nr_cpus = bpf_map_lookup_elem(&cluster_cpu_counts, &app_cpu);
+	if (!nr_cpus || !*nr_cpus || *nr_cpus > MAX_CPUS)
+		return MAX_CPUS;
+
+	slot = hash % *nr_cpus;
+	key = app_cpu * MAX_CPUS + slot;
+	cpu = bpf_map_lookup_elem(&cluster_cpu_slots, &key);
+	if (!cpu)
+		return MAX_CPUS;
+
+	return *cpu;
+}
+
+static __always_inline __u32 numa_cpu(__u32 app_cpu, __u32 hash)
+{
+	__u32 *nr_cpus, *cpu, key, slot;
+
+	nr_cpus = bpf_map_lookup_elem(&numa_cpu_counts, &app_cpu);
+	if (!nr_cpus || !*nr_cpus || *nr_cpus > MAX_CPUS)
+		return MAX_CPUS;
+
+	slot = hash % *nr_cpus;
+	key = app_cpu * MAX_CPUS + slot;
+	cpu = bpf_map_lookup_elem(&numa_cpu_slots, &key);
+	if (!cpu)
+		return MAX_CPUS;
+
+	return *cpu;
+}
+
+static __always_inline __u32 choose_rfs_cpu(__u32 app_cpu, __u32 hash,
+					    struct rps_config *cfg)
+{
+	__u32 cpu;
+
+	if (!cfg)
+		return app_cpu;
+
+	if (cfg->rfs_strategy == RFS_STRATEGY_CLUSTER_OTHER) {
+		cpu = cluster_cpu(app_cpu, hash);
+		if (cpu < MAX_CPUS)
+			return cpu;
+	}
+
+	if (cfg->rfs_strategy == RFS_STRATEGY_NUMA_OTHER) {
+		cpu = numa_cpu(app_cpu, hash);
+		if (cpu < MAX_CPUS)
+			return cpu;
+	}
+
+	if (cpu_allowed(app_cpu))
+		return app_cpu;
+
+	return first_rps_cpu();
+}
+
+static __always_inline bool cpu_queue_drained(__u32 cpu, __u32 last_qtail)
+{
+	__u32 *head;
+
+	if (cpu >= MAX_CPUS)
+		return true;
+
+	head = bpf_map_lookup_elem(&cpu_queue_head, &cpu);
+	if (!head)
+		return false;
+
+	return (__s32)(*head - last_qtail) >= 0;
+}
+
+static __always_inline __u32 flow_active_cpu(struct flow_state *state)
+{
+	__u32 active_cpu = state->active_cpu;
+
+	if (active_cpu != state->desired_cpu &&
+	    cpu_queue_drained(active_cpu, state->last_qtail)) {
+		active_cpu = state->desired_cpu;
+		state->active_cpu = active_cpu;
+	}
+
+	return active_cpu;
+}
+
+static __always_inline void flow_save_qtail(struct flow_state *state, __u32 cpu)
+{
+	__u32 *tail;
+
+	if (cpu >= MAX_CPUS)
+		return;
+
+	tail = bpf_map_lookup_elem(&cpu_queue_tail, &cpu);
+	if (tail) {
+		*tail += 1;
+		state->last_qtail = *tail;
+	}
+}
+
+static __always_inline struct flow_state new_flow_state(__u32 cpu)
+{
+	struct flow_state state = {};
+
+	state.active_cpu = cpu;
+	state.desired_cpu = cpu;
+	return state;
+}
+
+static __always_inline void update_desired_cpu(struct flow_key *key, __u32 cpu)
+{
+	struct flow_state initial, *state;
+
+	state = bpf_map_lookup_elem(&flow_state, key);
+	if (state) {
+		if (state->desired_cpu != cpu)
+			state->desired_cpu = cpu;
+	} else {
+		initial = new_flow_state(cpu);
+		bpf_map_update_elem(&flow_state, key, &initial, BPF_NOEXIST);
+	}
+}
+
+SEC("xdp")
+int xdp_rps_rfs_prog(struct xdp_md *ctx)
+{
+	struct flow_state initial, *state;
+	struct flow_key key = {};
+	struct rps_config *cfg;
+	__u32 zero = 0, hash = 0;
+	__u32 slot, *cpu, target_cpu;
+	int ret;
+
+	if (parse_flow(ctx, &key, &hash)) {
+		count(STAT_PASS);
+		return XDP_PASS;
+	}
+
+	state = bpf_map_lookup_elem(&flow_state, &key);
+	if (state) {
+		target_cpu = flow_active_cpu(state);
+		flow_save_qtail(state, target_cpu);
+		ret = bpf_redirect_map(&cpu_map, target_cpu, XDP_PASS);
+		if (ret == XDP_REDIRECT)
+			count(STAT_RFS_REDIRECT);
+		else if (ret == XDP_PASS)
+			count(STAT_FALLBACK_PASS);
+		else
+			count(STAT_DROP);
+		return ret;
+	}
+
+	cfg = bpf_map_lookup_elem(&config, &zero);
+	if (!cfg || !cfg->nr_cpus || cfg->nr_cpus > MAX_CPUS) {
+		count(STAT_PASS);
+		return XDP_PASS;
+	}
+
+	slot = hash % cfg->nr_cpus;
+	cpu = bpf_map_lookup_elem(&cpu_slots, &slot);
+	if (!cpu) {
+		count(STAT_PASS);
+		return XDP_PASS;
+	}
+
+	initial = new_flow_state(*cpu);
+	if (!bpf_map_update_elem(&flow_state, &key, &initial, BPF_NOEXIST))
+		state = bpf_map_lookup_elem(&flow_state, &key);
+
+	if (state) {
+		target_cpu = flow_active_cpu(state);
+		flow_save_qtail(state, target_cpu);
+	} else {
+		target_cpu = *cpu;
+	}
+
+	ret = bpf_redirect_map(&cpu_map, target_cpu, XDP_PASS);
+	if (ret == XDP_REDIRECT)
+		count(STAT_RPS_REDIRECT);
+	else if (ret == XDP_PASS)
+		count(STAT_FALLBACK_PASS);
+	else
+		count(STAT_DROP);
+
+	return ret;
+}
+
+SEC("xdp/cpumap")
+int xdp_rps_rfs_cpumap(struct xdp_md *ctx)
+{
+	__u32 cpu = bpf_get_smp_processor_id();
+	__u32 *head;
+
+	if (cpu >= MAX_CPUS)
+		return XDP_PASS;
+
+	head = bpf_map_lookup_elem(&cpu_queue_head, &cpu);
+	if (head)
+		*head += 1;
+
+	return XDP_PASS;
+}
+
+SEC("sockops")
+int xdp_rps_rfs_sockops(struct bpf_sock_ops *skops)
+{
+	struct flow_key key = {};
+	struct rps_config *cfg;
+	__u32 zero = 0, cpu, hash;
+	__u32 words[12] = {};
+
+	if (skops->op != BPF_SOCK_OPS_ACTIVE_ESTABLISHED_CB &&
+	    skops->op != BPF_SOCK_OPS_PASSIVE_ESTABLISHED_CB)
+		return 1;
+
+	cpu = bpf_get_smp_processor_id();
+
+	if (skops->family == FLOW_FAMILY_V4) {
+		key.family = FLOW_FAMILY_V4;
+		key.proto = IPPROTO_TCP;
+		key.v4.saddr = skops->remote_ip4;
+		key.v4.daddr = skops->local_ip4;
+		words[0] = key.v4.saddr;
+		words[1] = key.v4.daddr;
+	} else if (skops->family == FLOW_FAMILY_V6) {
+		key.family = FLOW_FAMILY_V6;
+		key.proto = IPPROTO_TCP;
+		key.v6.saddr[0] = skops->remote_ip6[0];
+		key.v6.saddr[1] = skops->remote_ip6[1];
+		key.v6.saddr[2] = skops->remote_ip6[2];
+		key.v6.saddr[3] = skops->remote_ip6[3];
+		key.v6.daddr[0] = skops->local_ip6[0];
+		key.v6.daddr[1] = skops->local_ip6[1];
+		key.v6.daddr[2] = skops->local_ip6[2];
+		key.v6.daddr[3] = skops->local_ip6[3];
+		words[0] = key.v6.saddr[0];
+		words[1] = key.v6.saddr[1];
+		words[2] = key.v6.saddr[2];
+		words[3] = key.v6.saddr[3];
+		words[4] = key.v6.daddr[0];
+		words[5] = key.v6.daddr[1];
+		words[6] = key.v6.daddr[2];
+		words[7] = key.v6.daddr[3];
+	} else {
+		return 1;
+	}
+
+	key.sport = skops->remote_port >> 16;
+	key.dport = bpf_htons(skops->local_port);
+	words[8] = ((__u32)key.sport << 16) | key.dport;
+	words[9] = ((__u32)key.family << 24) | ((__u32)key.proto << 16);
+
+	hash = hash_words(words);
+	cfg = bpf_map_lookup_elem(&config, &zero);
+	cpu = choose_rfs_cpu(cpu, hash, cfg);
+	update_desired_cpu(&key, cpu);
+	count(STAT_SOCKOPS_UPDATE);
+
+	return 1;
+}
+
+SEC("kprobe/tcp_recvmsg")
+int xdp_rps_rfs_tcp_recvmsg(struct pt_regs *ctx)
+{
+	void *sk = (void *)PT_REGS_PARM1(ctx);
+	struct rfs_in6_addr v6_addr;
+	struct flow_key key = {};
+	struct rps_config *cfg;
+	__u32 zero = 0, cpu, hash;
+	__u32 words[12] = {};
+	__u16 family, num;
+	int i;
+
+	count(STAT_RECV_ENTER);
+
+	if (!sk)
+		return 0;
+
+	bpf_probe_read_kernel(&family, sizeof(family), sk + SKC_FAMILY_OFF);
+	if (family == FLOW_FAMILY_V4) {
+		key.family = FLOW_FAMILY_V4;
+		key.proto = IPPROTO_TCP;
+		bpf_probe_read_kernel(&key.v4.saddr, sizeof(key.v4.saddr),
+				      sk + SKC_DADDR_OFF);
+		bpf_probe_read_kernel(&key.v4.daddr, sizeof(key.v4.daddr),
+				      sk + SKC_RCV_SADDR_OFF);
+		words[0] = key.v4.saddr;
+		words[1] = key.v4.daddr;
+	} else if (family == FLOW_FAMILY_V6) {
+		key.family = FLOW_FAMILY_V6;
+		key.proto = IPPROTO_TCP;
+		bpf_probe_read_kernel(&v6_addr, sizeof(v6_addr),
+				      sk + SKC_V6_DADDR_OFF);
+#pragma unroll
+		for (i = 0; i < 4; i++) {
+			key.v6.saddr[i] = v6_addr.words[i];
+			words[i] = key.v6.saddr[i];
+		}
+		bpf_probe_read_kernel(&v6_addr, sizeof(v6_addr),
+				      sk + SKC_V6_RCV_SADDR_OFF);
+#pragma unroll
+		for (i = 0; i < 4; i++) {
+			key.v6.daddr[i] = v6_addr.words[i];
+			words[i + 4] = key.v6.daddr[i];
+		}
+		} else {
+			count(STAT_RECV_BAD_FAMILY);
+			return 0;
+		}
+
+	bpf_probe_read_kernel(&key.sport, sizeof(key.sport),
+			      sk + SKC_DPORT_OFF);
+	bpf_probe_read_kernel(&num, sizeof(num), sk + SKC_NUM_OFF);
+	key.dport = bpf_htons(num);
+
+	if (key.family == FLOW_FAMILY_V4) {
+		words[2] = ((__u32)key.sport << 16) | key.dport;
+		words[3] = ((__u32)key.family << 24) |
+			   ((__u32)key.proto << 16);
+	} else {
+		words[8] = ((__u32)key.sport << 16) | key.dport;
+		words[9] = ((__u32)key.family << 24) |
+			   ((__u32)key.proto << 16);
+	}
+
+	hash = hash_words(words);
+	cfg = bpf_map_lookup_elem(&config, &zero);
+	cpu = choose_rfs_cpu(bpf_get_smp_processor_id(), hash, cfg);
+	update_desired_cpu(&key, cpu);
+	count(STAT_RECV_UPDATE);
+
+	return 0;
+}
