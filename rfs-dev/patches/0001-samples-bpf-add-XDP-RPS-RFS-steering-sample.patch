 samples/bpf/xdp_rps_rfs_kern.c | 700 +++++++++++++++++++++++++
 samples/bpf/xdp_rps_rfs_user.c | 900 +++++++++++++++++++++++++++++++++
 3 files changed, 1603 insertions(+)
 create mode 100644 samples/bpf/xdp_rps_rfs_kern.c
 create mode 100644 samples/bpf/xdp_rps_rfs_user.c

