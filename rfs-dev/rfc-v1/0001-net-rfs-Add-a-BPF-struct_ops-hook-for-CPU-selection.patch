diff --git a/net/core/bpf_rfs.c b/net/core/bpf_rfs.c
new file mode 100644
index 000000000000..0fda06e2ae6e
--- /dev/null
+++ b/net/core/bpf_rfs.c
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Programmable desired-CPU selection for native RFS. */
+
+#include <linux/bpf.h>
+#include <linux/bpf_verifier.h>
+#include <linux/btf.h>
+#include <linux/btf_ids.h>
+#include <linux/filter.h>
+#include <linux/init.h>
+#include <linux/netdevice.h>
+#include <linux/nsproxy.h>
+#include <linux/rtnetlink.h>
+#include <linux/slab.h>
+#include <net/bpf_rfs.h>
+#include <net/rps.h>
+
+DEFINE_STATIC_KEY_FALSE(bpf_rfs_enabled);
+
+/*
+ * RTNL protects this list and all binding fields. No device reference is held:
+ * NETDEV_UNREGISTER clears dev before its storage or namespace can change.
+ * An inactive binding lives until link release, without retaining the device.
+ */
+struct bpf_rfs_binding {
+	struct list_head list;
+	struct bpf_link *link;
+	struct bpf_rfs_ops *ops;
+	struct net_device *dev;
+};
+
+static LIST_HEAD(bpf_rfs_bindings);
+
+u32 bpf_rfs_select_cpu(struct net_device *dev, struct sk_buff *skb,
+		       u32 hash, u32 app_cpu, u32 active_cpu)
+{
+	const struct bpf_rfs_ops *ops;
+	struct bpf_rfs_ctx ctx = {
+		.flow_hash = hash,
+		.ifindex = dev->ifindex,
+		.rx_cpu = raw_smp_processor_id(),
+		.app_cpu_hint = app_cpu,
+		.active_cpu = active_cpu < nr_cpu_ids ? active_cpu : -1,
+		.nr_cpu_ids = nr_cpu_ids,
+	};
+	u32 cpu;
+
+	ops = rcu_dereference(dev->bpf_rfs_ops);
+	if (!ops || app_cpu >= nr_cpu_ids || !cpu_possible(app_cpu))
+		return app_cpu;
+
+	if (skb_rx_queue_recorded(skb)) {
+		ctx.rx_queue = skb_get_rx_queue(skb);
+		ctx.flags |= BPF_RFS_RX_QUEUE_RECORDED;
+	}
+	if (cpu_online(app_cpu))
+		ctx.flags |= BPF_RFS_APP_CPU_ONLINE;
+	if (active_cpu < nr_cpu_ids && cpu_online(active_cpu))
+		ctx.flags |= BPF_RFS_ACTIVE_CPU_ONLINE;
+
+	cpu = ops->select_cpu(&ctx);
+	if (!cpu)
+		return app_cpu;
+	cpu--;
+	if (cpu >= nr_cpu_ids || cpu >= RPS_NO_CPU ||
+	    !cpu_possible(cpu) || !cpu_online(cpu))
+		return app_cpu;
+
+	return cpu;
+}
+
+static bool bpf_rfs_in_use(const struct bpf_rfs_ops *ops)
+{
+	struct bpf_rfs_binding *binding;
+
+	list_for_each_entry(binding, &bpf_rfs_bindings, list)
+		if (binding->ops == ops)
+			return true;
+	return false;
+}
+
+static int bpf_rfs_reg(void *kdata, struct bpf_link *link)
+{
+	struct net *net = current->nsproxy->net_ns;
+	struct bpf_rfs_ops *ops = kdata;
+	struct bpf_rfs_binding *binding;
+	struct net_device *dev;
+	int err = 0;
+
+	/* Only link-based attachments have the required lifetime and update API. */
+	if (!link)
+		return -EOPNOTSUPP;
+	if (!ns_capable(net->user_ns, CAP_NET_ADMIN))
+		return -EPERM;
+	binding = kzalloc_obj(*binding);
+	if (!binding)
+		return -ENOMEM;
+
+	rtnl_lock();
+	dev = __dev_get_by_index(net, ops->ifindex);
+	if (!dev || dev->reg_state != NETREG_REGISTERED) {
+		err = -ENODEV;
+		goto out;
+	}
+	if (rcu_access_pointer(dev->bpf_rfs_ops) || bpf_rfs_in_use(ops)) {
+		err = -EBUSY;
+		goto out;
+	}
+	binding->dev = dev;
+	binding->ops = ops;
+	binding->link = link;
+	list_add(&binding->list, &bpf_rfs_bindings);
+	static_branch_inc(&bpf_rfs_enabled);
+	rcu_assign_pointer(dev->bpf_rfs_ops, ops);
+out:
+	rtnl_unlock();
+	if (err)
+		kfree(binding);
+	return err;
+}
+
+static void bpf_rfs_deactivate(struct bpf_rfs_binding *binding)
+{
+	if (!binding->dev)
+		return;
+	rcu_assign_pointer(binding->dev->bpf_rfs_ops, NULL);
+	binding->dev = NULL;
+	static_branch_dec(&bpf_rfs_enabled);
+}
+
+static void bpf_rfs_unreg(void *kdata, struct bpf_link *link)
+{
+	struct bpf_rfs_binding *binding, *found = NULL;
+
+	rtnl_lock();
+	list_for_each_entry(binding, &bpf_rfs_bindings, list) {
+		if (binding->link != link)
+			continue;
+		bpf_rfs_deactivate(binding);
+		list_del(&binding->list);
+		found = binding;
+		break;
+	}
+	rtnl_unlock();
+	/* The struct_ops core may release the trampoline after we return. */
+	synchronize_rcu();
+	kfree(found);
+}
+
+static int bpf_rfs_update(void *kdata, void *old_kdata, struct bpf_link *link)
+{
+	struct bpf_rfs_ops *ops = kdata;
+	struct bpf_rfs_binding *binding;
+	struct net_device *dev;
+	int err = -ENOLINK;
+
+	rtnl_lock();
+	list_for_each_entry(binding, &bpf_rfs_bindings, list) {
+		if (binding->link != link)
+			continue;
+		dev = binding->dev;
+		if (!dev) {
+			err = -ENODEV;
+			break;
+		}
+		if (binding->ops != old_kdata || ops->ifindex != dev->ifindex) {
+			err = -EINVAL;
+			break;
+		}
+		if (!ns_capable(dev_net(dev)->user_ns, CAP_NET_ADMIN)) {
+			err = -EPERM;
+			break;
+		}
+		if (bpf_rfs_in_use(ops)) {
+			err = -EBUSY;
+			break;
+		}
+		binding->ops = ops;
+		rcu_assign_pointer(dev->bpf_rfs_ops, ops);
+		err = 0;
+		break;
+	}
+	rtnl_unlock();
+	if (!err)
+		synchronize_rcu();
+	return err;
+}
+
+static int bpf_rfs_netdev_event(struct notifier_block *nb, unsigned long event,
+				void *ptr)
+{
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+	struct bpf_rfs_binding *binding;
+
+	if (event != NETDEV_UNREGISTER)
+		return NOTIFY_DONE;
+	list_for_each_entry(binding, &bpf_rfs_bindings, list)
+		if (binding->dev == dev)
+			bpf_rfs_deactivate(binding);
+	/* Do not call link detach here: RTNL nests inside struct_ops update_mutex. */
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block bpf_rfs_netdev_notifier = {
+	.notifier_call = bpf_rfs_netdev_event,
+};
+
+static int bpf_rfs_check_member(const struct btf_type *t,
+				const struct btf_member *member,
+				const struct bpf_prog *prog)
+{
+	return prog->sleepable ? -EINVAL : 0;
+}
+
+static int bpf_rfs_init_member(const struct btf_type *t,
+			       const struct btf_member *member,
+			       void *kdata, const void *udata)
+{
+	const struct bpf_rfs_ops *uops = udata;
+	struct bpf_rfs_ops *ops = kdata;
+	u32 off = __btf_member_bit_offset(t, member) / 8;
+
+	switch (off) {
+	case offsetof(struct bpf_rfs_ops, ifindex):
+		if (!uops->ifindex || uops->ifindex > INT_MAX)
+			return -EINVAL;
+		ops->ifindex = uops->ifindex;
+		return 1;
+	case offsetof(struct bpf_rfs_ops, name):
+		if (bpf_obj_name_cpy(ops->name, uops->name, sizeof(ops->name)) <= 0)
+			return -EINVAL;
+		return 1;
+	}
+	/* The core rejects nonzero unsupported fields, including flags. */
+	return 0;
+}
+
+static int bpf_rfs_validate(void *kdata)
+{
+	struct bpf_rfs_ops *ops = kdata;
+
+	return ops->select_cpu ? 0 : -EINVAL;
+}
+
+static u32 bpf_rfs_default(const struct bpf_rfs_ctx *ctx)
+{
+	return BPF_RFS_DEFAULT;
+}
+
+static const struct bpf_verifier_ops bpf_rfs_verifier_ops = {
+	.get_func_proto = bpf_base_func_proto,
+	.is_valid_access = bpf_tracing_btf_ctx_access,
+	/* No btf_struct_access override: kernel BTF objects remain read-only. */
+};
+
+static struct bpf_rfs_ops bpf_rfs_cfi_stubs = {
+	.select_cpu = bpf_rfs_default,
+};
+
+static int bpf_rfs_ops_init(struct btf *btf)
+{
+	return 0;
+}
+
+static struct bpf_struct_ops bpf_rfs_struct_ops = {
+	.init = bpf_rfs_ops_init,
+	.verifier_ops = &bpf_rfs_verifier_ops,
+	.reg = bpf_rfs_reg,
+	.unreg = bpf_rfs_unreg,
+	.update = bpf_rfs_update,
+	.check_member = bpf_rfs_check_member,
+	.init_member = bpf_rfs_init_member,
+	.validate = bpf_rfs_validate,
+	.name = "bpf_rfs_ops",
+	.cfi_stubs = &bpf_rfs_cfi_stubs,
+	.owner = THIS_MODULE,
+};
+
+static int __init bpf_rfs_init(void)
+{
+	int err;
+
+	err = register_netdevice_notifier(&bpf_rfs_netdev_notifier);
+	if (err)
+		return err;
+	err = register_bpf_struct_ops(&bpf_rfs_struct_ops, bpf_rfs_ops);
+	if (err)
+		unregister_netdevice_notifier(&bpf_rfs_netdev_notifier);
+	return err;
+}
+late_initcall(bpf_rfs_init);
