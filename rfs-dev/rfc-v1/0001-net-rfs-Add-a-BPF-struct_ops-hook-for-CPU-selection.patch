diff --git a/include/net/bpf_rfs.h b/include/net/bpf_rfs.h
new file mode 100644
index 000000000000..594df4a9e96f
--- /dev/null
+++ b/include/net/bpf_rfs.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _NET_BPF_RFS_H
+#define _NET_BPF_RFS_H
+
+#include <linux/static_key.h>
+#include <linux/types.h>
+
+struct net_device;
+struct sk_buff;
+
+enum bpf_rfs_ctx_flags {
+	BPF_RFS_RX_QUEUE_RECORDED = 1U << 0,
+	BPF_RFS_APP_CPU_ONLINE = 1U << 1,
+	BPF_RFS_ACTIVE_CPU_ONLINE = 1U << 2,
+};
+
+/* Read-only, advisory snapshots; flow_hash identifies an RFS slot, not a socket. */
+struct bpf_rfs_ctx {
+	u32 flow_hash;
+	u32 ifindex;
+	u32 rx_queue;
+	u32 rx_cpu;
+	s32 app_cpu_hint;
+	s32 active_cpu;
+	u32 nr_cpu_ids;
+	u32 flags;
+};
+
+/* Return DEFAULT or CPU + 1. The native RFS migration check still applies. */
+#define BPF_RFS_DEFAULT 0U
+#define BPF_RFS_CPU(cpu) ((u32)(cpu) + 1U)
+
+struct bpf_rfs_ops {
+	u32 ifindex;
+	u32 flags;
+	char name[16];
+	u32 (*select_cpu)(const struct bpf_rfs_ctx *ctx);
+};
+
+#ifdef CONFIG_BPF_RFS
+DECLARE_STATIC_KEY_FALSE(bpf_rfs_enabled);
+
+u32 bpf_rfs_select_cpu(struct net_device *dev, struct sk_buff *skb,
+		       u32 hash, u32 app_cpu, u32 active_cpu);
+
+static inline u32 bpf_rfs_cpu(struct net_device *dev, struct sk_buff *skb,
+			      u32 hash, u32 app_cpu, u32 active_cpu)
+{
+	if (static_branch_unlikely(&bpf_rfs_enabled))
+		return bpf_rfs_select_cpu(dev, skb, hash, app_cpu, active_cpu);
+	return app_cpu;
+}
+#else
+static inline u32 bpf_rfs_cpu(struct net_device *dev, struct sk_buff *skb,
+			      u32 hash, u32 app_cpu, u32 active_cpu)
+{
+	return app_cpu;
+}
+#endif
+
+#endif /* _NET_BPF_RFS_H */
