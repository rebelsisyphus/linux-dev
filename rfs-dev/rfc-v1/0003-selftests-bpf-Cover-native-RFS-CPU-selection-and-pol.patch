+TEST(cpulist_large_and_sparse)
+{
+	unsigned char *mask;
+	unsigned int size;
+
+	ASSERT_EQ(rfs_parse_cpulist("0-31,64-127,511\n", &mask, &size), 0);
+	ASSERT_EQ(size, 512);
+	EXPECT_EQ(mask[31], 1);
+	EXPECT_EQ(mask[32], 0);
+	EXPECT_EQ(mask[64], 1);
+	EXPECT_EQ(mask[511], 1);
+	free(mask);
+	ASSERT_EQ(rfs_parse_cpulist("4-2", &mask, &size), -EINVAL);
+	ASSERT_EQ(rfs_parse_cpulist("0,", &mask, &size), -EINVAL);
+	ASSERT_EQ(rfs_parse_cpulist("-1", &mask, &size), -EINVAL);
+}
