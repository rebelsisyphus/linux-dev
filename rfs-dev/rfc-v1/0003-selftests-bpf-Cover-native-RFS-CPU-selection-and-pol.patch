+# SPDX-License-Identifier: GPL-2.0
+RFS_TEST_ROOT := $(abspath ../../../../..)
+OUTPUT ?= $(CURDIR)
+ifneq ($(abspath $(OUTPUT)),$(CURDIR))
+building_out_of_srctree := 1
+endif
+TEST_PROGS := test_rfs.sh
+TEST_GEN_PROGS_EXTENDED := test_rfs rfs_policy
+TEST_GEN_FILES := lib
+TEST_FILES := ../../net/lib.sh
+EXTRA_CLEAN := $(addprefix $(OUTPUT)/,test_rfs.bpf.o test_rfs.skel.h sample)
+
+include ../../lib.mk
+
+VMLINUX ?= $(RFS_TEST_ROOT)/vmlinux
+BPFTOOL ?= bpftool
+CLANG ?= clang
+RFS_SAMPLE := $(RFS_TEST_ROOT)/samples/bpf
+RFS_BUILD := $(abspath $(OUTPUT))/sample
+RFS_CFLAGS := -O2 -g -Wall -I$(RFS_BUILD) -I$(OUTPUT) -I$(RFS_SAMPLE) \
+	-I$(RFS_TEST_ROOT)/tools/lib -I$(RFS_TEST_ROOT)/tools/include/uapi
+
+$(RFS_BUILD)/rfs_policy: $(wildcard $(RFS_SAMPLE)/rfs_policy*.c) \
+		       $(RFS_SAMPLE)/rfs_policy.h $(RFS_SAMPLE)/Makefile.rfs $(VMLINUX)
+	$(MAKE) -f $(RFS_SAMPLE)/Makefile.rfs OUTPUT=$(RFS_BUILD) \
+		VMLINUX=$(VMLINUX) BPFTOOL=$(BPFTOOL) CLANG=$(CLANG)
+
+$(OUTPUT)/test_rfs.bpf.o: test_rfs.bpf.c $(RFS_BUILD)/rfs_policy
+	$(CLANG) -target bpf -O2 -g -Wall -Werror -Wno-missing-declarations \
+		-I$(RFS_BUILD) -I$(RFS_BUILD)/libbpf -I$(RFS_SAMPLE) \
+		-I$(RFS_TEST_ROOT)/tools/lib -c $< -o $@
+
+$(OUTPUT)/test_rfs.skel.h: $(OUTPUT)/test_rfs.bpf.o
+	$(BPFTOOL) gen skeleton $< name test_rfs > $@.tmp
+	mv $@.tmp $@
+
+$(OUTPUT)/test_rfs: test_rfs.c $(OUTPUT)/test_rfs.skel.h
+	$(CC) $(RFS_CFLAGS) $< $(RFS_BUILD)/rfs_policy_loader.o \
+		$(RFS_BUILD)/rfs_policy_topology.o $(RFS_BUILD)/libbpf/libbpf.a \
+		-lelf -lz -o $@
+
+$(OUTPUT)/rfs_policy: $(RFS_BUILD)/rfs_policy
+	cp $< $@
+
+$(OUTPUT)/lib: ../../net/lib/sh/defer.sh
+	mkdir -p $@/sh
+	cp $< $@/sh/
