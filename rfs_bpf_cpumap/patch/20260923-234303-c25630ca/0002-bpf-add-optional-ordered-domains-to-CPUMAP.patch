 #define CPUMAP_BATCH 8
 
+/* Keep native frames and generic skbs in ring order, including mixed batches. */
+static void cpu_map_receive_ordered(struct bpf_cpu_map_entry *rcpu, void **frames,
+				    u32 n, u32 sched)
+{
+	struct bpf_net_context __bpf_net_ctx, *bpf_net_ctx = NULL;
+	struct xdp_cpumap_stats stats = {};
+	void *cache[CPUMAP_BATCH], *skbs[CPUMAP_BATCH];
+	u32 i, native = 0, allocated, used = 0, pass = 0;
+
+	if (rcpu->prog) {
+		rcu_read_lock();
+		bpf_net_ctx = bpf_net_ctx_set(&__bpf_net_ctx);
+		xdp_set_return_frame_no_direct();
+	}
+	for (i = 0; i < n; i++) {
+		void *f = frames[i];
+
+		if (__ptr_test_bit(0, &f)) {
+			__ptr_clear_bit(0, &f);
+			if (rcpu->prog &&
+			    !cpu_map_bpf_prog_run_skb(rcpu, &f, 1, &stats)) {
+				frames[i] = NULL;
+				continue;
+			}
+			__ptr_set_bit(0, &f);
+		} else {
+			if (rcpu->prog &&
+			    !cpu_map_bpf_prog_run_xdp(rcpu, &f, 1, &stats)) {
+				frames[i] = NULL;
+				continue;
+			}
+			native++;
+		}
+		frames[i] = f;
+	}
+	if (rcpu->prog) {
+		xdp_clear_return_frame_no_direct();
+		bpf_net_ctx_clear(bpf_net_ctx);
+		rcu_read_unlock();
+	}
+
+	allocated = napi_skb_cache_get_bulk(cache, native);
+	for (i = 0; i < n; i++) {
+		struct xdp_frame *xdpf;
+		void *f = frames[i];
+
+		if (!f)
+			continue;
+		if (__ptr_test_bit(0, &f)) {
+			__ptr_clear_bit(0, &f);
+			skbs[pass++] = f;
+			continue;
+		}
+		xdpf = f;
+		if (used == allocated) {
+			xdp_return_frame(xdpf);
+			continue;
+		}
+		__xdp_build_skb_from_frame(xdpf, cache[used], xdpf->dev_rx);
+		skbs[pass++] = cache[used++];
+	}
+	trace_xdp_cpumap_kthread(rcpu->map_id, n, native - allocated, sched, &stats);
+	for (i = 0; i < pass; i++)
+		gro_receive_skb(&rcpu->gro, skbs[i]);
+}
