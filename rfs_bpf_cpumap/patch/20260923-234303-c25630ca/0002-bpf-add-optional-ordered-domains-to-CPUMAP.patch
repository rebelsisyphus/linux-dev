+static bool cpu_map_domain_busy(struct bpf_cpu_map_domain *domain)
+{
+	struct bpf_cpu_map_entry *rcpu = domain->target;
+
+	return domain->pending ||
+		(s64)(atomic64_read_acquire(&rcpu->progress->completed) -
+		      domain->last_tail) < 0;
+}
+
+/*
+ * Reserve a submission before dropping the domain lock. Pending submissions
+ * pin its target until every source bulk has either published or dropped them.
+ * The caller's RCU section also covers the eventual source bulk flush.
+ */
+static struct bpf_cpu_map_entry *
+cpu_map_reserve(struct bpf_cpu_map_domain *domain, u32 cpu)
+{
+	struct bpf_cpu_map_entry *rcpu, *old, *put = NULL;
+	struct bpf_map *map = &domain->cmap->map;
+	int err = -ENODEV;
+
+	spin_lock_bh(&domain->lock);
+	old = domain->target;
+	rcpu = old;
+	if (!old || (!domain->pending &&
+		     (!cpu_online(old->cpu) || !cpu_map_domain_busy(domain)))) {
+		rcpu = __cpu_map_lookup_elem(map, cpu);
+		if (!rcpu || !cpu_online(rcpu->cpu))
+			rcpu = old;
+	}
+	if (!rcpu || !cpu_online(rcpu->cpu))
+		goto unlock;
+	/*
+	 * A replaced entry is draining. Its progress remains readable, but it
+	 * must not receive submissions that outlive its removal grace period.
+	 */
+	if (__cpu_map_lookup_elem(map, rcpu->cpu) != rcpu) {
+		err = -EAGAIN;
+		goto unlock;
+	}
+	if (domain->pending == U32_MAX) {
+		err = -EOVERFLOW;
+		goto unlock;
+	}
+	if (rcpu != old) {
+		refcount_inc(&rcpu->refs);
+		domain->target = rcpu;
+		domain->last_tail = 0;
+		put = old;
+	}
+	domain->pending++;
+	spin_unlock_bh(&domain->lock);
+	if (put)
+		cpu_map_entry_put(put);
+	return rcpu;
+unlock:
+	spin_unlock_bh(&domain->lock);
+	return ERR_PTR(err);
+}
+
+static void cpu_map_commit(struct bpf_cpu_map_domain *domain,
+			   struct bpf_cpu_map_entry *rcpu, int err)
+{
+	lockdep_assert_held(&rcpu->queue->producer_lock);
+	if (!err)
+		rcpu->progress->submitted++;
+	spin_lock(&domain->lock);
+	if (!err)
+		domain->last_tail = rcpu->progress->submitted;
+	domain->pending--;
+	spin_unlock(&domain->lock);
+}
