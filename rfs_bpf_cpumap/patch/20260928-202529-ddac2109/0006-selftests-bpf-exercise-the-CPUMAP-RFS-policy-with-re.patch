+// SPDX-License-Identifier: GPL-2.0
+#include "../../../../../samples/bpf/xdp_rfs.bpf.c"
+
+__u16 server_port;
+__u32 packets, receive_cpu;
+
+/* Observe the real stack handoff, after CPUMAP has constructed an skb. */
+SEC("tc")
+int rfs_receive(struct __sk_buff *skb)
+{
+	void *data = (void *)(long)skb->data;
+	void *end = (void *)(long)skb->data_end;
+	struct ethhdr *eth = data;
+	__be16 *ports;
+	__u8 protocol;
+
+	if ((void *)(eth + 1) > end)
+		return 0;
+	if (eth->h_proto == bpf_htons(0x0800)) {
+		struct iphdr *ip = (void *)(eth + 1);
+
+		if ((void *)(ip + 1) > end || ip->ihl < 5)
+			return 0;
+		ports = (void *)ip + ip->ihl * 4;
+		protocol = ip->protocol;
+	} else if (eth->h_proto == bpf_htons(0x86dd)) {
+		struct ipv6hdr *ip = (void *)(eth + 1);
+
+		if ((void *)(ip + 1) > end)
+			return 0;
+		ports = (void *)(ip + 1);
+		protocol = ip->nexthdr;
+	} else {
+		return 0;
+	}
+	if ((protocol != IPPROTO_TCP && protocol != IPPROTO_UDP) ||
+	    (void *)(ports + 2) > end || ports[1] != server_port)
+		return 0;
+	receive_cpu = bpf_get_smp_processor_id();
+	__sync_fetch_and_add(&packets, 1);
+	return 0;
+}
