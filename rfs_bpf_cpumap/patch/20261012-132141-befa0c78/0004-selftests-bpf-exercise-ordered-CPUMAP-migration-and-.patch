+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __XDP_CPUMAP_ORDERED_H
+#define __XDP_CPUMAP_ORDERED_H
+
+#define CPUMAP_TEST_DOMAINS 16
+#define CPUMAP_TEST_MAGIC 0x4350554d
+#define CPUMAP_TEST_PROTO 0x88b5
+
+#ifndef __VMLINUX_H__
+struct bpf_cpumap_state {
+	__u64 last_tail;
+	__u64 completed;
+	__u32 cpu;
+	__u32 pending;
+};
+#endif
+
+struct cpumap_test_packet {
+	__u8 dest[6];
+	__u8 source[6];
+	__be16 proto;
+	__u16 reserved;
+	__u32 magic;
+	__u32 domain;
+	__u32 seq;
+	__u8 padding[32];
+};
+
+#endif
