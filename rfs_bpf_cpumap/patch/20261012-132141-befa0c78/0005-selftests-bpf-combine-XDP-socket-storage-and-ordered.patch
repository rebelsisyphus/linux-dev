index 000000000000..642c8d65450a
--- /dev/null
+++ b/tools/testing/selftests/bpf/xdp_rfs.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __XDP_RFS_H
+#define __XDP_RFS_H
+
+#define RFS_MAX_CPUS 128
+#define RFS_DOMAINS 4096
+#define RFS_GRO_PAYLOAD 64
+
+struct rfs_hint {
+	/* Zero means unobserved; updates from concurrent users are advisory. */
+	__u32 cpu_plus_one;
+};
+
+enum rfs_stat {
+	RFS_HINT,
+	RFS_FALLBACK,
+	RFS_PASS,
+	RFS_DROP,
+	RFS_STORAGE_FAILURE,
+	RFS_STAT_MAX,
+};
+
+#endif
