diff --git a/tools/testing/selftests/bpf/prog_tests/xdp_rfs.c b/tools/testing/selftests/bpf/prog_tests/xdp_rfs.c
new file mode 100644
index 000000000000..a0cdef6369ca
--- /dev/null
+++ b/tools/testing/selftests/bpf/prog_tests/xdp_rfs.c
@@ -0,0 +1,610 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <sched.h>
+#include <net/if.h>
+#include <sys/stat.h>
+#include <linux/if_link.h>
+#include <test_progs.h>
+#include <network_helpers.h>
+#include "xdp_rfs.h"
+#include "test_xdp_rfs.skel.h"
+
+static bool generic_frags;
+
+struct rfs_fixture {
+	struct test_xdp_rfs *skel;
+	struct nstoken *ns;
+	struct bpf_tc_hook tc;
+	cpu_set_t affinity;
+	char name[64];
+	int cpus[3], ifindex, listener, server, client;
+	bool attached, affinity_saved;
+};
+
+static int pin_cpu(int cpu)
+{
+	cpu_set_t set;
+
+	CPU_ZERO(&set);
+	CPU_SET(cpu, &set);
+	return sched_setaffinity(0, sizeof(set), &set);
+}
+
+static bool drain(struct rfs_fixture *f)
+{
+	char packet[14] = {};
+
+	LIBBPF_OPTS(bpf_test_run_opts, opts,
+		    .data_in = packet,
+		    .data_size_in = sizeof(packet),
+	);
+	int i, err;
+
+	for (i = 0; i < 1000; i++) {
+		err = bpf_prog_test_run_opts(bpf_program__fd(f->skel->progs.rfs_drain), &opts);
+		if (err || f->skel->bss->query_error)
+			return false;
+		if (!f->skel->bss->busy_domains)
+			return true;
+		usleep(1000);
+	}
+	return false;
+}
+
+static bool hint_is(struct rfs_fixture *f, int cpu)
+{
+	struct rfs_hint hint;
+	int err;
+
+	err = bpf_map_lookup_elem(bpf_map__fd(f->skel->maps.socket_cpu), &f->server, &hint);
+	return ASSERT_OK(err, "read_socket_hint") &&
+	       ASSERT_EQ(hint.cpu_plus_one, cpu + 1, "socket_cpu");
+}
+
+static __u64 stat_sum(struct rfs_fixture *f, __u32 key)
+{
+	int possible = libbpf_num_possible_cpus(), cpu;
+	__u64 *values, total = 0;
+
+	values = calloc(possible, sizeof(*values));
+	if (!ASSERT_OK_PTR(values, "stat_alloc"))
+		return 0;
+	if (ASSERT_OK(bpf_map_lookup_elem(bpf_map__fd(f->skel->maps.stats), &key, values),
+		      "read_stats")) {
+		for (cpu = 0; cpu < possible; cpu++)
+			total += values[cpu];
+	}
+	free(values);
+	return total;
+}
+
+/* Wait for TC before recv(), so recv's new hint cannot decide this packet. */
+static bool transmit(struct rfs_fixture *f, int expected_cpu, char value)
+{
+	__u32 before = __atomic_load_n(&f->skel->bss->packets, __ATOMIC_RELAXED);
+	int i;
+
+	if (!ASSERT_OK(pin_cpu(f->cpus[0]), "pin_sender") ||
+	    !ASSERT_EQ(send(f->client, &value, 1, 0), 1, "send"))
+		return false;
+	for (i = 0; i < 5000; i++) {
+		if (__atomic_load_n(&f->skel->bss->packets, __ATOMIC_RELAXED) > before)
+			break;
+		usleep(1000);
+	}
+	if (!ASSERT_LT(i, 5000, "stack_handoff") || !ASSERT_TRUE(drain(f), "drain"))
+		return false;
+	if (expected_cpu >= 0)
+		return ASSERT_EQ(f->skel->bss->receive_cpu, expected_cpu, "receive_cpu");
+	return true;
+}
+
+static bool consume(struct rfs_fixture *f, int cpu, char expected)
+{
+	char value = 0;
+
+	return ASSERT_OK(pin_cpu(cpu), "pin_reader") &&
+	       ASSERT_EQ(recv(f->server, &value, 1, 0), 1, "recv") &&
+	       ASSERT_EQ(value, expected, "payload_order") && hint_is(f, cpu);
+}
+
+static void cleanup(struct rfs_fixture *f)
+{
+	if (f->client >= 0)
+		close(f->client);
+	if (f->server >= 0)
+		close(f->server);
+	if (f->listener >= 0)
+		close(f->listener);
+	if (f->attached) {
+		/* Closing TCP emits FINs; stop ingress before checking all domains. */
+		SYS_NOFAIL("ip link set lo down");
+		ASSERT_TRUE(drain(f), "cleanup_drain");
+		bpf_xdp_detach(f->ifindex, XDP_FLAGS_SKB_MODE, NULL);
+	}
+	if (f->tc.ifindex)
+		bpf_tc_hook_destroy(&f->tc);
+	test_xdp_rfs__destroy(f->skel);
+	close_netns(f->ns);
+	if (f->name[0])
+		SYS_NOFAIL("ip netns del %s", f->name);
+	if (f->affinity_saved)
+		sched_setaffinity(0, sizeof(f->affinity), &f->affinity);
+}
+
+static bool setup(struct rfs_fixture *f, int family, int type)
+{
+	struct bpf_cpumap_val entry = { .qsize = 2048 };
+	struct sockaddr_storage addr;
+	socklen_t len = sizeof(addr);
+	struct bpf_program *prog;
+	struct stat ns;
+	int cpu, n = 0, possible, i, err;
+	__u32 key, one = 1;
+
+	LIBBPF_OPTS(bpf_tc_opts, tc_opts, .handle = 1, .priority = 1);
+
+	memset(f, 0, sizeof(*f));
+	f->listener = -1;
+	f->server = -1;
+	f->client = -1;
+	if (!ASSERT_OK(sched_getaffinity(0, sizeof(f->affinity), &f->affinity), "affinity"))
+		return false;
+	f->affinity_saved = true;
+	for (cpu = 0; cpu < CPU_SETSIZE && n < 3; cpu++) {
+		if (CPU_ISSET(cpu, &f->affinity))
+			f->cpus[n++] = cpu;
+	}
+	if (n < 3) {
+		test__skip();
+		return false;
+	}
+	snprintf(f->name, sizeof(f->name), "xdp_rfs_%d", getpid());
+	SYS(fail, "ip netns add %s", f->name);
+	f->ns = open_netns(f->name);
+	if (!ASSERT_OK_PTR(f->ns, "netns") ||
+	    !ASSERT_OK(stat("/proc/self/ns/net", &ns), "netns_inode"))
+		goto fail;
+	SYS(fail, "ip link set lo up");
+	f->ifindex = if_nametoindex("lo");
+	f->skel = test_xdp_rfs__open();
+	if (!ASSERT_OK_PTR(f->skel, "open"))
+		goto fail;
+	possible = libbpf_num_possible_cpus();
+	if (!ASSERT_GT(possible, 0, "possible_cpus"))
+		goto fail;
+	bpf_map__set_max_entries(f->skel->maps.cpu_map, possible);
+	bpf_map__set_max_entries(f->skel->maps.allowed, possible);
+	f->skel->rodata->nr_cpus = 2;
+	f->skel->rodata->cpus[0] = f->cpus[1];
+	f->skel->rodata->cpus[1] = f->cpus[2];
+	f->skel->rodata->netns_ino = ns.st_ino;
+	f->skel->rodata->hash_seed = 0x12345678;
+	if (generic_frags) {
+		bpf_object__for_each_program(prog, f->skel->obj) {
+			if (bpf_program__type(prog) == BPF_PROG_TYPE_XDP)
+				bpf_program__set_flags(prog, BPF_F_XDP_HAS_FRAGS);
+		}
+	}
+	if (!ASSERT_OK(test_xdp_rfs__load(f->skel), "load"))
+		goto fail;
+	bpf_object__for_each_program(prog, f->skel->obj) {
+		if (bpf_program__type(prog) != BPF_PROG_TYPE_TRACING)
+			bpf_program__set_autoattach(prog, false);
+	}
+	if (!ASSERT_OK(test_xdp_rfs__attach(f->skel), "attach_observers"))
+		goto fail;
+	for (i = 1; i < 3; i++) {
+		key = f->cpus[i];
+		if (!ASSERT_OK(bpf_map_update_elem(bpf_map__fd(f->skel->maps.cpu_map),
+						   &key, &entry, BPF_ANY), "create_cpu") ||
+		    !ASSERT_OK(bpf_map_update_elem(bpf_map__fd(f->skel->maps.allowed),
+						   &key, &one, BPF_ANY), "allow_cpu"))
+			goto fail;
+	}
+	f->tc.sz = sizeof(f->tc);
+	f->tc.ifindex = f->ifindex;
+	f->tc.attach_point = BPF_TC_INGRESS;
+	if (!ASSERT_OK(bpf_tc_hook_create(&f->tc), "tc_create"))
+		goto fail;
+	tc_opts.prog_fd = bpf_program__fd(f->skel->progs.rfs_receive);
+	if (!ASSERT_OK(bpf_tc_attach(&f->tc, &tc_opts), "tc_attach"))
+		goto fail;
+	err = bpf_xdp_attach(f->ifindex, bpf_program__fd(f->skel->progs.rfs_redirect),
+			     XDP_FLAGS_SKB_MODE | XDP_FLAGS_UPDATE_IF_NOEXIST, NULL);
+	if (!ASSERT_OK(err, "xdp_attach"))
+		goto fail;
+	f->attached = true;
+	if (!ASSERT_OK(pin_cpu(f->cpus[0]), "pin_setup"))
+		goto fail;
+	f->listener = start_server(family, type, family == AF_INET ? "127.0.0.1" : "::1",
+				   0, 3000);
+	if (!ASSERT_OK_FD(f->listener, "listener"))
+		goto fail;
+	if (!ASSERT_OK(getsockname(f->listener, (void *)&addr, &len), "getsockname"))
+		goto fail;
+	f->skel->bss->server_port = family == AF_INET ?
+		((struct sockaddr_in *)&addr)->sin_port : ((struct sockaddr_in6 *)&addr)->sin6_port;
+	f->client = connect_to_fd(f->listener, 3000);
+	if (!ASSERT_OK_FD(f->client, "connect"))
+		goto fail;
+	if (type == SOCK_STREAM) {
+		if (!ASSERT_OK(pin_cpu(f->cpus[1]), "pin_accept"))
+			goto fail;
+		f->server = accept(f->listener, NULL, NULL);
+		if (!ASSERT_OK_FD(f->server, "accept") || !hint_is(f, f->cpus[1]))
+			goto fail;
+	} else {
+		f->server = f->listener;
+		f->listener = -1;
+		if (!ASSERT_OK(connect_fd_to_fd(f->server, f->client, 3000), "connect_udp"))
+			goto fail;
+	}
+	return ASSERT_TRUE(drain(f), "setup_drain");
+fail:
+	return false;
+}
+
+static void test_policy(int family, int type)
+{
+	struct rfs_fixture f;
+	struct rfs_hint hint;
+	struct sockaddr_storage addr;
+	socklen_t addrlen = sizeof(addr);
+	__u64 fallback, hits;
+	int err, fallback_cpu, pipefd[2] = { -1, -1 };
+	char value;
+
+	if (!setup(&f, family, type))
+		goto out;
+	/* Accept already supplies a hint; connected UDP starts without one. */
+	if (!transmit(&f, type == SOCK_STREAM ? f.cpus[1] : -1, 'a') ||
+	    !consume(&f, f.cpus[2], 'a'))
+		goto out;
+	hits = stat_sum(&f, RFS_HINT);
+	if (!transmit(&f, f.cpus[2], 'b') || !consume(&f, f.cpus[1], 'b') ||
+	    !ASSERT_GT(stat_sum(&f, RFS_HINT), hits, "used_socket_hint"))
+		goto out;
+	if (!transmit(&f, f.cpus[1], 'c') || !consume(&f, f.cpus[2], 'c'))
+		goto out;
+
+	/* Error-queue reads must not update the application CPU hint. */
+	if (!ASSERT_OK(pin_cpu(f.cpus[0]), "pin_error_reader"))
+		goto out;
+	recv(f.server, &value, 1, MSG_ERRQUEUE | MSG_DONTWAIT);
+	if (!hint_is(&f, f.cpus[2]))
+		goto out;
+
+	/* A CPU outside the configured set changes only the candidate CPU. */
+	recv(f.server, &value, 1, MSG_DONTWAIT);
+	if (!hint_is(&f, f.cpus[0]))
+		goto out;
+	fallback = stat_sum(&f, RFS_FALLBACK);
+	if (!transmit(&f, -1, 'd'))
+		goto out;
+	fallback_cpu = f.skel->bss->receive_cpu;
+	if (!ASSERT_TRUE(fallback_cpu == f.cpus[1] || fallback_cpu == f.cpus[2],
+			 "fallback_in_cpu_set") ||
+	    !ASSERT_GT(stat_sum(&f, RFS_FALLBACK), fallback, "outside_cpu_fallback") ||
+	    !consume(&f, f.cpus[2], 'd'))
+		goto out;
+
+	/* Missing storage does not pass locally or create storage from XDP. */
+	if (!ASSERT_OK(bpf_map_delete_elem(bpf_map__fd(f.skel->maps.socket_cpu), &f.server),
+		       "delete_hint") || !transmit(&f, fallback_cpu, 'e'))
+		goto out;
+	err = bpf_map_lookup_elem(bpf_map__fd(f.skel->maps.socket_cpu), &f.server, &hint);
+	if (!ASSERT_ERR(err, "xdp_did_not_create_hint") ||
+	    !consume(&f, f.cpus[1], 'e'))
+		goto out;
+
+	/* Send-side use independently updates the receiver's socket hint. */
+	if (!ASSERT_OK(pin_cpu(f.cpus[2]), "pin_server_send") ||
+	    !ASSERT_EQ(send(f.server, "f", 1, 0), 1, "server_send") ||
+	    !hint_is(&f, f.cpus[2]) ||
+	    !ASSERT_EQ(recv(f.client, &value, 1, 0), 1, "client_recv") ||
+	    !ASSERT_TRUE(drain(&f), "reply_drain") ||
+	    !transmit(&f, f.cpus[2], 'g'))
+		goto out;
+	if (type == SOCK_STREAM) {
+		if (!ASSERT_OK(pipe(pipefd), "pipe") ||
+		    !ASSERT_OK(pin_cpu(f.cpus[1]), "pin_splice") ||
+		    !ASSERT_EQ(splice(f.server, NULL, pipefd[1], NULL, 1, 0), 1, "splice") ||
+		    !hint_is(&f, f.cpus[1]) ||
+		    !ASSERT_EQ(read(pipefd[0], &value, 1), 1, "pipe_read") ||
+		    !ASSERT_EQ(value, 'g', "splice_payload") ||
+		    !transmit(&f, f.cpus[1], 'h') || !consume(&f, f.cpus[2], 'h'))
+			goto out;
+		{
+			struct tcp_zerocopy_receive zc = {};
+			socklen_t len = sizeof(zc);
+
+			if (!ASSERT_OK(pin_cpu(f.cpus[1]), "pin_zerocopy") ||
+			    !ASSERT_OK(getsockopt(f.server, SOL_TCP, TCP_ZEROCOPY_RECEIVE,
+					  &zc, &len), "zerocopy_receive") ||
+			    !hint_is(&f, f.cpus[1]))
+				goto out;
+		}
+	} else if (!consume(&f, f.cpus[1], 'g')) {
+		goto out;
+	}
+	if (type == SOCK_DGRAM) {
+		/* Reuse the tuple after close: a new socket must not inherit a hint. */
+		if (!ASSERT_OK(getsockname(f.server, (void *)&addr, &addrlen), "saved_addr"))
+			goto out;
+		close(f.server);
+		f.server = start_server_addr(SOCK_DGRAM, &addr, addrlen, NULL);
+		if (!ASSERT_OK_FD(f.server, "replacement_socket") ||
+		    !ASSERT_OK(connect_fd_to_fd(f.server, f.client, 3000), "replacement_connect") ||
+		    !ASSERT_ERR(bpf_map_lookup_elem(bpf_map__fd(f.skel->maps.socket_cpu),
+						  &f.server, &hint), "no_stale_hint") ||
+		    !transmit(&f, fallback_cpu, 'z') || !consume(&f, f.cpus[2], 'z'))
+			goto out;
+	}
+out:
+	if (pipefd[0] >= 0)
+		close(pipefd[0]);
+	if (pipefd[1] >= 0)
+		close(pipefd[1]);
+	cleanup(&f);
+}
+
+static void test_native_udp(int family)
+{
+	struct {
+		__u16 pad;
+		struct ethhdr eth;
+		struct iphdr ip;
+		struct udphdr udp;
+		char value;
+		char tail;
+	} v4 = {};
+	struct {
+		__u16 pad;
+		struct ethhdr eth;
+		struct ipv6hdr ip;
+		struct udphdr udp;
+		char value;
+		char tail;
+	} v6 = {};
+	size_t size4 = offsetof(typeof(v4), tail) + 1 - offsetof(typeof(v4), eth);
+	size_t size6 = offsetof(typeof(v6), tail) + 1 - offsetof(typeof(v6), eth);
+	struct rfs_fixture f;
+	struct xdp_md ctx = {};
+	__u32 before;
+	int i, n, cpu, err;
+	char value;
+
+	LIBBPF_OPTS(bpf_test_run_opts, opts,
+		    .ctx_in = &ctx,
+		    .ctx_size_in = sizeof(ctx),
+		    .flags = BPF_F_TEST_XDP_LIVE_FRAMES,
+		    .repeat = 1,
+	);
+
+	if (!setup(&f, family, SOCK_DGRAM))
+		goto out;
+	/* Injected loopback frames have no output route attached to the skb. */
+	if (family == AF_INET) {
+		if (!ASSERT_OK(write_sysctl("/proc/sys/net/ipv4/conf/lo/accept_local", "1"),
+			       "accept_injected_local_source") ||
+		    !ASSERT_OK(write_sysctl("/proc/sys/net/ipv4/conf/lo/route_localnet", "1"),
+			       "route_injected_loopback"))
+			goto out;
+	}
+	/* Stop generic ingress before injecting native frames into this device. */
+	if (!ASSERT_OK(bpf_xdp_detach(f.ifindex, XDP_FLAGS_SKB_MODE, NULL), "detach_generic"))
+		goto out;
+	f.attached = false;
+	ctx.ingress_ifindex = f.ifindex;
+	v4.eth.h_proto = htons(ETH_P_IP);
+	v4.ip.version = 4;
+	v4.ip.ihl = 5;
+	v4.ip.ttl = 64;
+	v4.ip.protocol = IPPROTO_UDP;
+	v4.ip.tot_len = htons(size4 - sizeof(v4.eth));
+	v4.ip.saddr = htonl(INADDR_LOOPBACK);
+	v4.ip.daddr = htonl(INADDR_LOOPBACK);
+	v4.ip.check = build_ip_csum(&v4.ip);
+	v4.udp.source = get_socket_local_port(f.client);
+	v4.udp.dest = f.skel->bss->server_port;
+	v4.udp.len = htons(sizeof(v4.udp) + 2);
+	v6.eth.h_proto = htons(ETH_P_IPV6);
+	v6.ip.version = 6;
+	v6.ip.nexthdr = IPPROTO_UDP;
+	v6.ip.hop_limit = 64;
+	v6.ip.payload_len = htons(sizeof(v6.udp) + 2);
+	v6.ip.saddr = in6addr_loopback;
+	v6.ip.daddr = in6addr_loopback;
+	v6.udp = v4.udp;
+	opts.data_in = family == AF_INET ? (void *)&v4.eth : (void *)&v6.eth;
+	opts.data_size_in = family == AF_INET ? size4 : size6;
+	ctx.data_end = opts.data_size_in;
+	for (n = 0; n < 4; n++) {
+		cpu = f.cpus[1 + (n & 1)];
+		if (!ASSERT_OK(pin_cpu(cpu), "pin_native_reader"))
+			goto out;
+		recv(f.server, &value, 1, MSG_DONTWAIT);
+		if (!hint_is(&f, cpu) || !ASSERT_OK(pin_cpu(f.cpus[0]), "pin_injector"))
+			goto out;
+		v4.value = 'a' + n;
+		v6.value = 'a' + n;
+		v6.udp.check = 0;
+		v6.udp.check = build_udp_v6_csum(&v6.ip, &v6.udp);
+		before = __atomic_load_n(&f.skel->bss->packets, __ATOMIC_RELAXED);
+		err = bpf_prog_test_run_opts(bpf_program__fd(f.skel->progs.rfs_redirect), &opts);
+		if (!ASSERT_OK(err, "native_inject"))
+			goto out;
+		for (i = 0; i < 5000; i++) {
+			if (__atomic_load_n(&f.skel->bss->packets, __ATOMIC_RELAXED) > before)
+				break;
+			usleep(1000);
+		}
+		if (!ASSERT_LT(i, 5000, "native_stack_handoff") ||
+		    !ASSERT_TRUE(drain(&f), "native_drain") ||
+		    !ASSERT_EQ(f.skel->bss->receive_cpu, cpu, "native_receive_cpu") ||
+		    !consume(&f, cpu, 'a' + n))
+			goto out;
+	}
+out:
+	cleanup(&f);
+}
+
+static void test_native_tcp_gro(void)
+{
+	struct {
+		__u16 pad;
+		struct ethhdr eth;
+		struct iphdr ip;
+		struct tcphdr tcp;
+		char payload[RFS_GRO_PAYLOAD];
+	} packet = {};
+	struct rfs_fixture f;
+	struct xdp_md ctx = {};
+	char received[32 * RFS_GRO_PAYLOAD];
+	char expected[sizeof(received)];
+	const int count = sizeof(received) / RFS_GRO_PAYLOAD;
+	int round, cpu;
+	size_t size = sizeof(packet) - offsetof(typeof(packet), eth);
+
+	LIBBPF_OPTS(bpf_test_run_opts, opts,
+		    .data_in = &packet.eth,
+		    .data_size_in = size,
+		    .ctx_in = &ctx,
+		    .ctx_size_in = sizeof(ctx),
+		    .flags = BPF_F_TEST_XDP_LIVE_FRAMES,
+		    .repeat = count,
+		    .batch_size = count,
+	);
+
+	if (!setup(&f, AF_INET, SOCK_STREAM))
+		goto out;
+	if (!transmit(&f, f.cpus[1], 'a') || !consume(&f, f.cpus[1], 'a'))
+		goto out;
+	if (!ASSERT_OK(write_sysctl("/proc/sys/net/ipv4/conf/lo/accept_local", "1"),
+		       "accept_local") ||
+	    !ASSERT_OK(write_sysctl("/proc/sys/net/ipv4/conf/lo/route_localnet", "1"),
+		       "route_localnet") ||
+	    !ASSERT_OK(bpf_xdp_detach(f.ifindex, XDP_FLAGS_SKB_MODE, NULL), "detach_generic"))
+		goto out;
+	f.attached = false;
+	ctx.ingress_ifindex = f.ifindex;
+	ctx.data_end = size;
+	packet.eth.h_proto = htons(ETH_P_IP);
+	packet.ip = (struct iphdr) {
+		.version = 4, .ihl = 5, .ttl = 64, .protocol = IPPROTO_TCP,
+		.tot_len = htons(size - sizeof(packet.eth)),
+		.frag_off = htons(0x4000),
+		.saddr = htonl(INADDR_LOOPBACK), .daddr = htonl(INADDR_LOOPBACK),
+	};
+	packet.ip.check = build_ip_csum(&packet.ip);
+	packet.tcp.source = get_socket_local_port(f.client);
+	packet.tcp.dest = f.skel->bss->server_port;
+	packet.tcp.ack_seq = htonl(f.skel->bss->last_tcp_ack);
+	packet.tcp.doff = 5;
+	packet.tcp.ack = 1;
+	packet.tcp.window = htons(65535);
+	memset(packet.payload, 'g', sizeof(packet.payload));
+	memset(expected, 'g', sizeof(expected));
+	f.skel->bss->batch_seq = f.skel->bss->last_tcp_seq + 1;
+	for (round = 0; round < 2; round++) {
+		cpu = f.cpus[1 + round];
+		f.skel->bss->tcp_expected_cpu_plus_one = cpu + 1;
+		if (!ASSERT_OK(pin_cpu(cpu), "pin_gro_reader"))
+			goto out;
+		recv(f.server, received, sizeof(received), MSG_DONTWAIT);
+		if (!hint_is(&f, cpu) || !ASSERT_OK(pin_cpu(f.cpus[0]), "pin_gro_source") ||
+		    !ASSERT_OK(bpf_prog_test_run_opts(bpf_program__fd(f.skel->progs.rfs_tcp_batch),
+						     &opts), "tcp_native_burst") ||
+		    !ASSERT_TRUE(drain(&f), "tcp_gro_drain") ||
+		    /* Pure ACKs can arrive locally after generic XDP is detached. */
+		    !ASSERT_EQ(f.skel->bss->tcp_data_cpu, cpu, "tcp_gro_cpu") ||
+		    !ASSERT_EQ(f.skel->bss->tcp_wrong_cpu, 0, "all_tcp_data_on_target") ||
+		    !ASSERT_OK(pin_cpu(cpu), "pin_tcp_consumer") ||
+		    !ASSERT_EQ(recv(f.server, received, sizeof(received), MSG_WAITALL),
+			       sizeof(received), "tcp_burst_delivered"))
+			goto out;
+		if (!ASSERT_MEMEQ(received, expected, sizeof(received), "tcp_burst_payload"))
+			goto out;
+	}
+	ASSERT_GT(f.skel->bss->gro_packets, 0, "tcp_gro_aggregated");
+	ASSERT_GT(f.skel->bss->gro_segments, f.skel->bss->gro_packets, "tcp_gro_segments");
+out:
+	cleanup(&f);
+}
+
+static void test_classification(void)
+{
+	struct ipv4_packet packet = pkt_v4;
+	struct rfs_fixture f;
+	__u64 before;
+	int fd;
+
+	LIBBPF_OPTS(bpf_test_run_opts, opts,
+		    .data_in = &packet,
+		    .data_size_in = sizeof(packet),
+	);
+
+	if (!setup(&f, AF_INET, SOCK_DGRAM))
+		goto out;
+	fd = bpf_program__fd(f.skel->progs.rfs_redirect);
+	/* This TCP tuple has no socket. It must still request ordered redirect. */
+	packet.iph.version = 4;
+	packet.iph.tot_len = htons(sizeof(packet) - sizeof(packet.eth));
+	before = stat_sum(&f, RFS_FALLBACK);
+	if (!ASSERT_OK(bpf_prog_test_run_opts(fd, &opts), "lookup_miss") ||
+	    !ASSERT_EQ(opts.retval, XDP_REDIRECT, "miss_stays_ordered") ||
+	    !ASSERT_GT(stat_sum(&f, RFS_FALLBACK), before, "lookup_miss_fallback"))
+		goto out;
+	opts.data_size_in = sizeof(packet.eth);
+	if (!ASSERT_OK(bpf_prog_test_run_opts(fd, &opts), "truncated_ip") ||
+	    !ASSERT_EQ(opts.retval, XDP_DROP, "truncated_drop"))
+		goto out;
+	opts.data_size_in = sizeof(packet);
+	opts.data_size_out = 0;
+	packet.iph.frag_off = htons(0x2000);
+	if (!ASSERT_OK(bpf_prog_test_run_opts(fd, &opts), "fragment") ||
+	    !ASSERT_EQ(opts.retval, XDP_PASS, "fragment_outside_scope"))
+		goto out;
+	packet.iph.frag_off = 0;
+	opts.data_size_out = 0;
+	packet.eth.h_proto = htons(ETH_P_ARP);
+	if (!ASSERT_OK(bpf_prog_test_run_opts(fd, &opts), "arp") ||
+	    !ASSERT_EQ(opts.retval, XDP_PASS, "arp_pass"))
+		goto out;
+	packet.eth.h_proto = htons(ETH_P_IP);
+	opts.data_size_out = 0;
+	packet.eth.h_dest[0] = 1;
+	if (!ASSERT_OK(bpf_prog_test_run_opts(fd, &opts), "multicast") ||
+	    !ASSERT_EQ(opts.retval, XDP_PASS, "multicast_pass"))
+		goto out;
+out:
+	cleanup(&f);
+}
+
+void test_xdp_rfs(void)
+{
+	if (test__start_subtest("native_tcp_gro"))
+		test_native_tcp_gro();
+	if (test__start_subtest("tcp_ipv4"))
+		test_policy(AF_INET, SOCK_STREAM);
+	if (test__start_subtest("tcp_ipv6"))
+		test_policy(AF_INET6, SOCK_STREAM);
+	if (test__start_subtest("udp_ipv4"))
+		test_policy(AF_INET, SOCK_DGRAM);
+	if (test__start_subtest("udp_ipv6"))
+		test_policy(AF_INET6, SOCK_DGRAM);
+	if (test__start_subtest("native_udp_ipv4"))
+		test_native_udp(AF_INET);
+	if (test__start_subtest("native_udp_ipv6"))
+		test_native_udp(AF_INET6);
+	if (test__start_subtest("classification"))
+		test_classification();
+	/* Force page-pool skb copying in generic XDP before CPUMAP redirect. */
+	generic_frags = true;
+	if (test__start_subtest("generic_frags_udp_ipv4"))
+		test_policy(AF_INET, SOCK_DGRAM);
+	if (test__start_subtest("generic_frags_udp_ipv6"))
+		test_policy(AF_INET6, SOCK_DGRAM);
+	generic_frags = false;
+}
diff --git a/tools/testing/selftests/bpf/progs/test_xdp_rfs.c b/tools/testing/selftests/bpf/progs/test_xdp_rfs.c
new file mode 100644
index 000000000000..ada6e6515e3b
--- /dev/null
+++ b/tools/testing/selftests/bpf/progs/test_xdp_rfs.c
@@ -0,0 +1,392 @@
+// SPDX-License-Identifier: GPL-2.0
+#include "vmlinux.h"
+#include <bpf/bpf_endian.h>
+#include <bpf/bpf_helpers.h>
+#include <bpf/bpf_tracing.h>
+#include "xdp_rfs.h"
+
+#define MSG_ERRQUEUE 0x2000
+
+extern int bpf_cpumap_redirect(void *map, __u32 cpu, __u32 domain) __ksym;
+extern int bpf_cpumap_get_state(void *map, __u32 domain, void *state,
+				__u32 size) __ksym;
+
+struct {
+	__uint(type, BPF_MAP_TYPE_CPUMAP);
+	__uint(max_entries, 1);
+	__uint(map_extra, RFS_DOMAINS);
+	__type(key, __u32);
+	__type(value, struct bpf_cpumap_val);
+} cpu_map SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__uint(max_entries, 1);
+	__type(key, __u32);
+	__type(value, __u32);
+} allowed SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_SK_STORAGE);
+	__uint(map_flags, BPF_F_NO_PREALLOC);
+	__type(key, int);
+	__type(value, struct rfs_hint);
+} socket_cpu SEC(".maps");
+
+struct {
+	__uint(type, BPF_MAP_TYPE_PERCPU_ARRAY);
+	__uint(max_entries, RFS_STAT_MAX);
+	__type(key, __u32);
+	__type(value, __u64);
+} stats SEC(".maps");
+
+const volatile __u32 nr_cpus;
+const volatile __u32 cpus[RFS_MAX_CPUS];
+const volatile __u32 netns_ino;
+const volatile __u32 hash_seed;
+
+/* Only the unattached control program writes these fields. */
+__u32 busy_domains;
+int query_error;
+
+static __always_inline void count(__u32 key)
+{
+	__u64 *value = bpf_map_lookup_elem(&stats, &key);
+
+	if (value)
+		__sync_fetch_and_add(value, 1);
+}
+
+static __always_inline void record_cpu(struct sock *sk)
+{
+	struct rfs_hint *hint;
+	__u32 cpu;
+	__u16 protocol;
+
+	if (!sk || sk->__sk_common.skc_state != BPF_TCP_ESTABLISHED ||
+	    sk->__sk_common.skc_net.net->ns.inum != netns_ino)
+		return;
+	protocol = sk->sk_protocol;
+	if (protocol != IPPROTO_TCP && protocol != IPPROTO_UDP)
+		return;
+	hint = bpf_sk_storage_get(&socket_cpu, sk, 0, BPF_SK_STORAGE_GET_F_CREATE);
+	if (!hint) {
+		count(RFS_STORAGE_FAILURE);
+		return;
+	}
+	cpu = bpf_get_smp_processor_id() + 1;
+	if (*(volatile __u32 *)&hint->cpu_plus_one != cpu)
+		*(volatile __u32 *)&hint->cpu_plus_one = cpu;
+}
+
+SEC("fentry/inet_sendmsg")
+int BPF_PROG(rfs_send4, struct socket *sock)
+{
+	record_cpu(sock->sk);
+	return 0;
+}
+
+SEC("fentry/inet6_sendmsg")
+int BPF_PROG(rfs_send6, struct socket *sock)
+{
+	record_cpu(sock->sk);
+	return 0;
+}
+
+SEC("fentry/inet_splice_eof")
+int BPF_PROG(rfs_splice_eof, struct socket *sock)
+{
+	record_cpu(sock->sk);
+	return 0;
+}
+
+SEC("fentry/inet_recvmsg")
+int BPF_PROG(rfs_recv4, struct socket *sock, struct msghdr *msg,
+	     size_t size, int flags)
+{
+	if (!(flags & MSG_ERRQUEUE))
+		record_cpu(sock->sk);
+	return 0;
+}
+
+SEC("fentry/inet6_recvmsg")
+int BPF_PROG(rfs_recv6, struct socket *sock, struct msghdr *msg,
+	     size_t size, int flags)
+{
+	if (!(flags & MSG_ERRQUEUE))
+		record_cpu(sock->sk);
+	return 0;
+}
+
+SEC("fexit/inet_accept")
+int BPF_PROG(rfs_accept, struct socket *sock, struct socket *newsock,
+	     struct proto_accept_arg *arg, int ret)
+{
+	if (!ret)
+		record_cpu(newsock->sk);
+	return 0;
+}
+
+SEC("fentry/tcp_splice_read")
+int BPF_PROG(rfs_splice, struct socket *sock)
+{
+	record_cpu(sock->sk);
+	return 0;
+}
+
+SEC("fentry/tcp_zerocopy_receive")
+int BPF_PROG(rfs_zerocopy, struct sock *sk)
+{
+	record_cpu(sk);
+	return 0;
+}
+
+static __always_inline __u32 mix(__u32 hash, __u32 word)
+{
+	hash ^= word;
+	hash *= 0x9e3779b1;
+	return (hash << 13) | (hash >> 19);
+}
+
+/* Zero-initialized tuple padding makes the domain independent of lookup. */
+static __always_inline __u32 tuple_hash(struct bpf_sock_tuple *tuple,
+					__u32 size, __u8 protocol)
+{
+	__u32 hash = mix(hash_seed, size ^ protocol);
+	__u32 word;
+	int i;
+
+#pragma unroll
+	for (i = 0; i < sizeof(*tuple) / sizeof(word); i++) {
+		__builtin_memcpy(&word, (char *)tuple + i * sizeof(word), sizeof(word));
+		hash = mix(hash, word);
+	}
+	hash ^= hash >> 16;
+	hash *= 0x85ebca6b;
+	hash ^= hash >> 13;
+	return hash;
+}
+
+static __always_inline bool cpu_allowed(__u32 cpu)
+{
+	__u32 *value = bpf_map_lookup_elem(&allowed, &cpu);
+
+	return value && *value;
+}
+
+static __always_inline int rfs_select(struct xdp_md *ctx)
+{
+	void *data = (void *)(long)ctx->data;
+	void *end = (void *)(long)ctx->data_end;
+	struct bpf_sock_tuple tuple = {};
+	struct ethhdr *eth = data;
+	struct rfs_hint *hint;
+	struct bpf_sock *sk;
+	__u32 size, hash, cpu, observed = 0;
+	__u8 protocol;
+	void *transport;
+
+	if ((void *)(eth + 1) > end)
+		goto drop;
+	if (eth->h_dest[0] & 1)
+		goto pass;
+	if (eth->h_proto == bpf_htons(0x0800)) {
+		struct iphdr *ip = (void *)(eth + 1);
+		__u32 len;
+
+		if ((void *)(ip + 1) > end || ip->version != 4 || ip->ihl < 5)
+			goto drop;
+		len = ip->ihl * 4;
+		if ((void *)ip + len > end || bpf_ntohs(ip->tot_len) < len)
+			goto drop;
+		if (ip->frag_off & bpf_htons(0x3fff))
+			goto pass;
+		protocol = ip->protocol;
+		tuple.ipv4.saddr = ip->saddr;
+		tuple.ipv4.daddr = ip->daddr;
+		size = sizeof(tuple.ipv4);
+		transport = (void *)ip + len;
+		if (protocol != IPPROTO_TCP && protocol != IPPROTO_UDP)
+			goto pass;
+		if (bpf_ntohs(ip->tot_len) < len + 4 || transport + 4 > end)
+			goto drop;
+		__builtin_memcpy(&tuple.ipv4.sport, transport, 4);
+	} else if (eth->h_proto == bpf_htons(0x86dd)) {
+		struct ipv6hdr *ip = (void *)(eth + 1);
+
+		if ((void *)(ip + 1) > end || ip->version != 6)
+			goto drop;
+		protocol = ip->nexthdr;
+		if (protocol != IPPROTO_TCP && protocol != IPPROTO_UDP)
+			goto pass;
+		transport = ip + 1;
+		if (bpf_ntohs(ip->payload_len) < 4 || transport + 4 > end)
+			goto drop;
+		__builtin_memcpy(tuple.ipv6.saddr, &ip->saddr, sizeof(ip->saddr));
+		__builtin_memcpy(tuple.ipv6.daddr, &ip->daddr, sizeof(ip->daddr));
+		__builtin_memcpy(&tuple.ipv6.sport, transport, 4);
+		size = sizeof(tuple.ipv6);
+	} else {
+		goto pass;
+	}
+
+	if (!nr_cpus || nr_cpus > RFS_MAX_CPUS)
+		goto drop;
+	hash = tuple_hash(&tuple, size, protocol);
+	cpu = cpus[hash % nr_cpus];
+	if (protocol == IPPROTO_TCP)
+		sk = bpf_sk_lookup_tcp(ctx, &tuple, size, BPF_F_CURRENT_NETNS, 0);
+	else
+		sk = bpf_sk_lookup_udp(ctx, &tuple, size, BPF_F_CURRENT_NETNS, 0);
+	if (sk) {
+		if (sk->state == BPF_TCP_ESTABLISHED) {
+			hint = bpf_sk_storage_get(&socket_cpu, sk, 0, 0);
+			if (hint)
+				observed = *(volatile __u32 *)&hint->cpu_plus_one;
+		}
+		bpf_sk_release(sk);
+	}
+	if (observed && cpu_allowed(observed - 1)) {
+		cpu = observed - 1;
+		count(RFS_HINT);
+	} else {
+		count(RFS_FALLBACK);
+	}
+	/* A lookup miss changes only the candidate, never the ordering domain. */
+	return bpf_cpumap_redirect(&cpu_map, cpu, hash & (RFS_DOMAINS - 1));
+pass:
+	count(RFS_PASS);
+	return XDP_PASS;
+drop:
+	count(RFS_DROP);
+	return XDP_DROP;
+}
+
+SEC("xdp")
+int rfs_redirect(struct xdp_md *ctx)
+{
+	return rfs_select(ctx);
+}
+
+static int check_domain(__u32 domain, void *ctx)
+{
+	struct bpf_cpumap_state state = {};
+	int err;
+
+	err = bpf_cpumap_get_state(&cpu_map, domain, &state, sizeof(state));
+	if (err) {
+		query_error = err;
+		return 1;
+	}
+	if (state.pending || (__s64)(state.completed - state.last_tail) < 0)
+		busy_domains++;
+	return 0;
+}
+
+/* Run with BPF_PROG_TEST_RUN only after ingress has been quiesced. */
+SEC("xdp")
+int rfs_drain(struct xdp_md *ctx)
+{
+	busy_domains = 0;
+	query_error = 0;
+	bpf_loop(RFS_DOMAINS, check_domain, NULL, 0);
+	return XDP_PASS;
+}
+
+__u16 server_port;
+__u32 packets, receive_cpu;
+__u32 last_tcp_seq, last_tcp_ack, gro_packets, gro_segments;
+__u32 tcp_data_cpu, tcp_expected_cpu_plus_one, tcp_wrong_cpu;
+__u32 batch_seq, batch_index;
+
+/* Synthesize a sequential TCP burst, then run the same steering policy. */
+SEC("xdp")
+int rfs_tcp_batch(struct xdp_md *ctx)
+{
+	void *data = (void *)(long)ctx->data;
+	void *end = (void *)(long)ctx->data_end;
+	struct ethhdr *eth = data;
+	struct iphdr *ip = (void *)(eth + 1);
+	struct tcphdr *tcp = (void *)(ip + 1);
+	struct {
+		__be32 saddr, daddr;
+		__u8 zero, protocol;
+		__be16 len;
+	} pseudo = {};
+	__u32 sum, index;
+
+	if ((void *)(tcp + 1) + RFS_GRO_PAYLOAD > end)
+		return XDP_DROP;
+	/* This unattached generator has one test-run producer. */
+	index = batch_index++;
+	tcp->seq = bpf_htonl(batch_seq + index * RFS_GRO_PAYLOAD);
+	tcp->check = 0;
+	pseudo.saddr = ip->saddr;
+	pseudo.daddr = ip->daddr;
+	pseudo.protocol = IPPROTO_TCP;
+	pseudo.len = bpf_htons(sizeof(*tcp) + RFS_GRO_PAYLOAD);
+	sum = bpf_csum_diff(NULL, 0, (void *)&pseudo, sizeof(pseudo), 0);
+	sum = bpf_csum_diff(NULL, 0, (void *)tcp, sizeof(*tcp) + RFS_GRO_PAYLOAD, sum);
+	sum = (sum & 0xffff) + (sum >> 16);
+	sum = (sum & 0xffff) + (sum >> 16);
+	tcp->check = ~sum;
+	return rfs_select(ctx);
+}
+
+/* Observe the real stack handoff, after CPUMAP has constructed an skb. */
+SEC("tc")
+int rfs_receive(struct __sk_buff *skb)
+{
+	void *data = (void *)(long)skb->data;
+	void *end = (void *)(long)skb->data_end;
+	struct ethhdr *eth = data;
+	__be16 *ports;
+	__u8 protocol;
+
+	if ((void *)(eth + 1) > end)
+		return 0;
+	if (eth->h_proto == bpf_htons(0x0800)) {
+		struct iphdr *ip = (void *)(eth + 1);
+
+		if ((void *)(ip + 1) > end || ip->ihl < 5)
+			return 0;
+		ports = (void *)ip + ip->ihl * 4;
+		protocol = ip->protocol;
+	} else if (eth->h_proto == bpf_htons(0x86dd)) {
+		struct ipv6hdr *ip = (void *)(eth + 1);
+
+		if ((void *)(ip + 1) > end)
+			return 0;
+		ports = (void *)(ip + 1);
+		protocol = ip->nexthdr;
+	} else {
+		return 0;
+	}
+	if ((protocol != IPPROTO_TCP && protocol != IPPROTO_UDP) ||
+	    (void *)(ports + 2) > end || ports[1] != server_port)
+		return 0;
+	if (protocol == IPPROTO_TCP) {
+		struct tcphdr *tcp = (void *)ports;
+
+		if ((void *)(tcp + 1) <= end &&
+		    skb->len > (void *)tcp - data + tcp->doff * 4) {
+			__u32 cpu = bpf_get_smp_processor_id();
+
+			last_tcp_seq = bpf_ntohl(tcp->seq);
+			last_tcp_ack = bpf_ntohl(tcp->ack_seq);
+			tcp_data_cpu = cpu;
+			if (tcp_expected_cpu_plus_one &&
+			    cpu + 1 != tcp_expected_cpu_plus_one)
+				__sync_fetch_and_add(&tcp_wrong_cpu, 1);
+		}
+		if (skb->gso_segs > 1) {
+			__sync_fetch_and_add(&gro_packets, 1);
+			__sync_fetch_and_add(&gro_segments, skb->gso_segs);
+		}
+	}
+	receive_cpu = bpf_get_smp_processor_id();
+	__sync_fetch_and_add(&packets, 1);
+	return 0;
+}
+
