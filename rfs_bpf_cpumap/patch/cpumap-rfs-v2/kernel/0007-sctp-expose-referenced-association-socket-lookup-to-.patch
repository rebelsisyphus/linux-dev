diff --git a/net/sctp/bpf.c b/net/sctp/bpf.c
new file mode 100644
index 000000000000..e4e5656fdaec
--- /dev/null
+++ b/net/sctp/bpf.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/bpf.h>
+#include <linux/btf.h>
+#include <linux/btf_ids.h>
+#include <linux/filter.h>
+#include <linux/module.h>
+#include <net/sctp/sctp.h>
+#include <net/xdp.h>
+
+__bpf_kfunc_start_defs();
+
+/**
+ * bpf_xdp_sctp_lookup - Find an SCTP association's socket in the ingress netns
+ * @ctx: XDP context
+ * @tuple: Incoming IPv4 or IPv6 tuple, in network byte order
+ * @tuple__sz: sizeof(tuple->ipv4) or sizeof(tuple->ipv6)
+ *
+ * Only existing associations are looked up. This is an advisory pre-routing
+ * lookup, not SCTP packet validation or final socket demultiplexing. In
+ * particular, accept/peeloff can move the association after this snapshot.
+ * The returned reference must be released with bpf_sctp_release().
+ *
+ * Return: A referenced socket, or NULL if the tuple is invalid or no
+ * association matches in the ingress device's network namespace.
+ */
+__bpf_kfunc struct sock *
+bpf_xdp_sctp_lookup(struct xdp_md *ctx, struct bpf_sock_tuple *tuple,
+		    u32 tuple__sz)
+{
+	struct xdp_buff *xdp = (struct xdp_buff *)ctx;
+	struct net_device *dev = xdp->rxq->dev;
+	union sctp_addr local = {}, peer = {};
+	struct sctp_transport *transport;
+	struct sock *sk = NULL;
+
+	if (tuple__sz == sizeof(tuple->ipv4)) {
+		local.v4.sin_family = AF_INET;
+		local.v4.sin_addr.s_addr = tuple->ipv4.daddr;
+		local.v4.sin_port = tuple->ipv4.dport;
+		peer.v4.sin_family = AF_INET;
+		peer.v4.sin_addr.s_addr = tuple->ipv4.saddr;
+		peer.v4.sin_port = tuple->ipv4.sport;
+	} else if (IS_ENABLED(CONFIG_IPV6) &&
+		   tuple__sz == sizeof(tuple->ipv6)) {
+		local.v6.sin6_family = AF_INET6;
+		memcpy(&local.v6.sin6_addr, tuple->ipv6.daddr, sizeof(struct in6_addr));
+		local.v6.sin6_port = tuple->ipv6.dport;
+		local.v6.sin6_scope_id = dev->ifindex;
+		peer.v6.sin6_family = AF_INET6;
+		memcpy(&peer.v6.sin6_addr, tuple->ipv6.saddr, sizeof(struct in6_addr));
+		peer.v6.sin6_port = tuple->ipv6.sport;
+		peer.v6.sin6_scope_id = dev->ifindex;
+	} else {
+		return NULL;
+	}
+
+	rcu_read_lock();
+	transport = sctp_addrs_lookup_transport(dev_net(dev), &local, &peer,
+						dev->ifindex, dev_sdif(dev));
+	if (transport) {
+		/*
+		 * The transport pins the association. Its socket may change during
+		 * accept/peeloff, but each endpoint retains its socket reference
+		 * through sctp_endpoint_destroy_rcu(). Thus even the old socket
+		 * stays alive until we can take our own reference under RCU.
+		 */
+		sk = READ_ONCE(transport->asoc->base.sk);
+		sock_hold(sk);
+		sctp_transport_put(transport);
+	}
+	rcu_read_unlock();
+	return sk;
+}
+
+__bpf_kfunc void bpf_sctp_release(struct sock *sk)
+{
+	sock_put(sk);
+}
+
+__bpf_kfunc_end_defs();
+
+BTF_KFUNCS_START(sctp_kfunc_ids)
+BTF_ID_FLAGS(func, bpf_xdp_sctp_lookup, KF_ACQUIRE | KF_RET_NULL)
+BTF_ID_FLAGS(func, bpf_sctp_release, KF_RELEASE)
+BTF_KFUNCS_END(sctp_kfunc_ids)
+
+static const struct btf_kfunc_id_set sctp_kfunc_set = {
+	.owner = THIS_MODULE,
+	.set = &sctp_kfunc_ids,
+};
+
+int __init sctp_bpf_register(void)
+{
+	return register_btf_kfunc_id_set(BPF_PROG_TYPE_XDP, &sctp_kfunc_set);
+}
diff --git a/net/sctp/protocol.c b/net/sctp/protocol.c
index 27c26e12f95d..862fc9e94a5c 100644
--- a/net/sctp/protocol.c
+++ b/net/sctp/protocol.c
@@ -1636,11 +1636,17 @@ static __init int sctp_init(void)
 	if (status)
 		goto err_v6_add_protocol;
 
+	status = sctp_bpf_register();
+	if (status)
+		goto err_bpf_register;
+
 	if (sctp_offload_init() < 0)
 		pr_crit("%s: Cannot add SCTP protocol offload\n", __func__);
 
 out:
 	return status;
+err_bpf_register:
+	sctp_v6_del_protocol();
 err_v6_add_protocol:
 	sctp_v4_del_protocol();
 err_add_protocol:
