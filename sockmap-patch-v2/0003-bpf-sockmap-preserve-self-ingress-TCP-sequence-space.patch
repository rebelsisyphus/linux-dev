 			kfree_sk_msg(msg_rx);
 		}
@@ -500,7 +505,7 @@ int __sk_msg_recvmsg(struct sock *sk, struct sk_psock *psock, struct msghdr *msg
 int sk_msg_recvmsg(struct sock *sk, struct sk_psock *psock, struct msghdr *msg,
 		   int len, int flags)
 {
-	return __sk_msg_recvmsg(sk, psock, msg, len, flags, NULL);
+	return __sk_msg_recvmsg(sk, psock, msg, len, flags, NULL, NULL);
 }
 EXPORT_SYMBOL_GPL(sk_msg_recvmsg);
 
@@ -1027,6 +1032,9 @@ int sk_psock_tls_strp_read(struct sk_psock *psock, struct sk_buff *skb)
 }
 EXPORT_SYMBOL_GPL(sk_psock_tls_strp_read);
 
+static bool sk_psock_defer_tcp_eat(struct sk_psock *psock,
+				   struct sk_buff *skb);
+
 static int sk_psock_verdict_apply(struct sk_psock *psock, struct sk_buff *skb,
 				  int verdict)
 {
@@ -1058,6 +1066,13 @@ static int sk_psock_verdict_apply(struct sk_psock *psock, struct sk_buff *skb,
 
 				off = stm->offset;
 				len = stm->full_len;
+			} else if (sk_is_tcp(psock->sk) &&
+				   after(tcp_sk(psock->sk)->copied_seq,
+					 TCP_SKB_CB(skb)->seq)) {
+				off = min_t(u32, skb->len,
+					    tcp_sk(psock->sk)->copied_seq -
+					    TCP_SKB_CB(skb)->seq);
+				len -= off;
 			}
 			err = sk_psock_skb_ingress_self(psock, skb, off, len, false);
 		}
@@ -1074,20 +1089,55 @@ static int sk_psock_verdict_apply(struct sk_psock *psock, struct sk_buff *skb,
 		}
 		break;
 	case __SK_REDIRECT:
-		tcp_eat_skb(psock->sk, skb);
+		if (!sk_psock_defer_tcp_eat(psock, skb))
+			tcp_eat_skb(psock->sk, skb);
 		err = sk_psock_skb_redirect(psock, skb);
 		break;
 	case __SK_DROP:
 	default:
 out_free:
 		skb_bpf_redirect_clear(skb);
-		tcp_eat_skb(psock->sk, skb);
+		if (!sk_psock_defer_tcp_eat(psock, skb))
+			tcp_eat_skb(psock->sk, skb);
 		sock_drop(psock->sk, skb);
 	}
 
 	return err;
 }
 
+static bool sk_psock_defer_tcp_eat(struct sk_psock *psock,
+				   struct sk_buff *skb)
+{
+	struct sk_msg *msg;
+	struct tcp_sock *tcp;
+	u32 copied, seq;
+	bool deferred = false;
+
+	if (!skb || !skb->len || !sk_is_tcp(psock->sk) ||
+	    skb_bpf_strparser(skb))
+		return false;
+
+	tcp = tcp_sk(psock->sk);
+	seq = TCP_SKB_CB(skb)->seq;
+	if (after(tcp->copied_seq, seq))
+		seq = tcp->copied_seq;
+	if (!before(seq, TCP_SKB_CB(skb)->end_seq))
+		return true;
+	copied = TCP_SKB_CB(skb)->end_seq - seq;
+
+	spin_lock_bh(&psock->ingress_lock);
+	list_for_each_entry_reverse(msg, &psock->ingress_msg, list) {
+		if (msg->sk == psock->sk) {
+			msg->tcp_drops += copied;
+			deferred = true;
+			break;
+		}
+	}
+	spin_unlock_bh(&psock->ingress_lock);
+
+	return deferred;
+}
+
 static void sk_psock_write_space(struct sock *sk)
 {
 	struct sk_psock *psock;
diff --git a/net/ipv4/tcp_bpf.c b/net/ipv4/tcp_bpf.c
index 8612a90eb7e0..638f349b595b 100644
--- a/net/ipv4/tcp_bpf.c
+++ b/net/ipv4/tcp_bpf.c
@@ -15,7 +15,7 @@
 void tcp_eat_skb(struct sock *sk, struct sk_buff *skb)
 {
 	struct tcp_sock *tcp;
-	u32 copied, end_seq;
+	u32 copied, end_seq, seq;
 
 	if (!skb || !skb->len || !sk_is_tcp(sk))
 		return;
@@ -24,8 +24,13 @@ void tcp_eat_skb(struct sock *sk, struct sk_buff *skb)
 		return;
 
 	tcp = tcp_sk(sk);
+	seq = TCP_SKB_CB(skb)->seq;
 	end_seq = TCP_SKB_CB(skb)->end_seq;
-	copied = end_seq - tcp->copied_seq;
+	if (after(tcp->copied_seq, seq))
+		seq = tcp->copied_seq;
+	if (!before(seq, end_seq))
+		return;
+	copied = end_seq - seq;
 	WRITE_ONCE(tcp->copied_seq, end_seq);
 	tcp_rcv_space_adjust(sk);
 	__tcp_cleanup_rbuf(sk, copied);
@@ -228,6 +233,7 @@ static int tcp_bpf_recvmsg_parser(struct sock *sk,
 	struct sk_psock *psock;
 	struct tcp_sock *tcp;
 	int copied_from_self = 0;
+	int dropped_from_self = 0;
 	int copied = 0;
 	u32 seq;
 
@@ -264,7 +270,8 @@ static int tcp_bpf_recvmsg_parser(struct sock *sk,
 	}
 
 msg_bytes_ready:
-	copied = __sk_msg_recvmsg(sk, psock, msg, len, flags, &copied_from_self);
+	copied = __sk_msg_recvmsg(sk, psock, msg, len, flags,
+				  &copied_from_self, &dropped_from_self);
 	/* The typical case for EFAULT is the socket was gracefully
 	 * shutdown with a FIN pkt. So check here the other case is
 	 * some error on copy_page_to_iter which would be unexpected.
@@ -279,7 +286,7 @@ static int tcp_bpf_recvmsg_parser(struct sock *sk,
 			goto out;
 		}
 	}
-	seq += copied_from_self;
+	seq += copied_from_self + dropped_from_self;
 	if (!copied) {
 		long timeo;
 		int data;
@@ -325,7 +332,7 @@ static int tcp_bpf_recvmsg_parser(struct sock *sk,
 		WRITE_ONCE(tcp->copied_seq, seq);
 	tcp_rcv_space_adjust(sk);
 	if (copied > 0)
-		__tcp_cleanup_rbuf(sk, copied);
+		__tcp_cleanup_rbuf(sk, copied + dropped_from_self);
 
 unlock:
 	release_sock(sk);
diff --git a/tools/testing/selftests/bpf/prog_tests/sockmap_basic.c b/tools/testing/selftests/bpf/prog_tests/sockmap_basic.c
index 590a168e5230..7d67ca43e5b2 100644
--- a/tools/testing/selftests/bpf/prog_tests/sockmap_basic.c
+++ b/tools/testing/selftests/bpf/prog_tests/sockmap_basic.c
@@ -1229,6 +1229,19 @@ static void test_sockmap_copied_seq(bool strp)
 	test_sockmap_pass_prog__destroy(skel);
 }
 
+static bool wait_for_verdict(struct test_sockmap_drop_prog *skel, int count)
+{
+	int i;
+
+	for (i = 0; i < 1000; i++) {
+		if (skel->bss->verdict_calls >= count)
+			return true;
+		usleep(1000);
+	}
+
+	return false;
+}
+
 static void test_sockmap_drop_after_partial_read(void)
 {
 	int map, err, sent, recvd, zero = 0, on = 1;
@@ -1268,6 +1281,8 @@ static void test_sockmap_drop_after_partial_read(void)
 	sent = xsend(c0, buf, 1, 0);
 	if (!ASSERT_EQ(sent, 1, "xsend(drop)"))
 		goto end;
+	if (!ASSERT_TRUE(wait_for_verdict(skel, 1), "wait_for_drop"))
+		goto end;
 
 	err = bpf_map_delete_elem(map, &zero);
 	if (!ASSERT_OK(err, "bpf_map_delete_elem"))
@@ -1300,6 +1315,138 @@ static void test_sockmap_drop_after_partial_read(void)
 	test_sockmap_drop_prog__destroy(skel);
 }
 
+static void test_sockmap_pass_then_verdict(bool redirect)
+{
+	int map, err, sent, recvd, zero = 0, one = 1, on = 1;
+	struct test_sockmap_drop_prog *skel;
+	int c0 = -1, p0 = -1, c1 = -1, p1 = -1;
+	struct tcp_zerocopy_receive zc = {};
+	socklen_t zc_len = sizeof(zc);
+	char buf[10] = {}, rcv[10], addr[100];
+	struct bpf_program *prog;
+
+	skel = test_sockmap_drop_prog__open_and_load();
+	if (!ASSERT_OK_PTR(skel, "open_and_load"))
+		return;
+
+	skel->bss->pass_then_redirect = redirect;
+	if (create_socket_pairs(AF_INET, SOCK_STREAM, &c0, &c1, &p0, &p1))
+		goto end;
+
+	prog = skel->progs.prog_pass_then_drop_or_redirect;
+	map = bpf_map__fd(skel->maps.sock_map_rx);
+	err = bpf_prog_attach(bpf_program__fd(prog), map,
+			      BPF_SK_SKB_STREAM_VERDICT, 0);
+	if (!ASSERT_OK(err, "bpf_prog_attach"))
+		goto end;
+
+	err = bpf_map_update_elem(map, &zero, &p0, BPF_NOEXIST);
+	if (!ASSERT_OK(err, "bpf_map_update_elem(p0)"))
+		goto end;
+	if (redirect) {
+		err = bpf_map_update_elem(map, &one, &p1, BPF_NOEXIST);
+		if (!ASSERT_OK(err, "bpf_map_update_elem(p1)"))
+			goto end;
+	}
+
+	sent = xsend(c0, buf, sizeof(buf), 0);
+	if (!ASSERT_EQ(sent, sizeof(buf), "xsend(pass)") ||
+	    !ASSERT_TRUE(wait_for_verdict(skel, 1), "wait_for_pass"))
+		goto end;
+
+	sent = xsend(c0, buf, sizeof(buf) - 1, 0);
+	if (!ASSERT_EQ(sent, sizeof(buf) - 1, "xsend(second verdict)") ||
+	    !ASSERT_TRUE(wait_for_verdict(skel, 2), "wait_for_second_verdict"))
+		goto end;
+
+	recvd = recv_timeout(p0, rcv, sizeof(rcv), MSG_DONTWAIT, 1);
+	if (!ASSERT_EQ(recvd, sizeof(buf), "recv(pass)"))
+		goto end;
+
+	err = bpf_map_delete_elem(map, &zero);
+	if (!ASSERT_OK(err, "bpf_map_delete_elem(p0)"))
+		goto end;
+
+	sent = xsend(c0, buf, 1, 0);
+	if (!ASSERT_EQ(sent, 1, "xsend(native)"))
+		goto end;
+
+	err = setsockopt(p0, SOL_SOCKET, SO_ZEROCOPY, &on, sizeof(on));
+	if (!ASSERT_OK(err, "setsockopt(SO_ZEROCOPY)"))
+		goto end;
+
+	zc.copybuf_address = (__u64)(unsigned long)addr;
+	zc.copybuf_len = sizeof(addr);
+	err = getsockopt(p0, IPPROTO_TCP, TCP_ZEROCOPY_RECEIVE, &zc, &zc_len);
+	if (!ASSERT_OK(err, "getsockopt(TCP_ZEROCOPY_RECEIVE)"))
+		goto end;
+
+	ASSERT_EQ(zc.copybuf_len, 1, "TCP_ZEROCOPY_RECEIVE copied");
+end:
+	if (c0 >= 0)
+		close(c0);
+	if (p0 >= 0)
+		close(p0);
+	if (c1 >= 0)
+		close(c1);
+	if (p1 >= 0)
+		close(p1);
+	test_sockmap_drop_prog__destroy(skel);
+}
+
+static void test_sockmap_pass_after_partial_read(void)
+{
+	int map, err, sent, recvd, zero = 0;
+	struct test_sockmap_drop_prog *skel;
+	int c0 = -1, p0 = -1, c1 = -1, p1 = -1;
+	char buf[200] = {}, rcv[200];
+	struct bpf_program *prog;
+
+	skel = test_sockmap_drop_prog__open_and_load();
+	if (!ASSERT_OK_PTR(skel, "open_and_load"))
+		return;
+
+	if (create_socket_pairs(AF_INET, SOCK_STREAM, &c0, &c1, &p0, &p1))
+		goto end;
+
+	sent = xsend(c0, buf, sizeof(buf), 0);
+	if (!ASSERT_EQ(sent, sizeof(buf), "xsend(native)"))
+		goto end;
+
+	recvd = recv_timeout(p0, rcv, 50, MSG_DONTWAIT, 1);
+	if (!ASSERT_EQ(recvd, 50, "recv(partial)"))
+		goto end;
+
+	prog = skel->progs.prog_pass_then_drop_or_redirect;
+	map = bpf_map__fd(skel->maps.sock_map_rx);
+	err = bpf_prog_attach(bpf_program__fd(prog), map,
+			      BPF_SK_SKB_STREAM_VERDICT, 0);
+	if (!ASSERT_OK(err, "bpf_prog_attach"))
+		goto end;
+
+	err = bpf_map_update_elem(map, &zero, &p0, BPF_NOEXIST);
+	if (!ASSERT_OK(err, "bpf_map_update_elem"))
+		goto end;
+
+	sent = xsend(c0, buf, 1, 0);
+	if (!ASSERT_EQ(sent, 1, "xsend(pass)") ||
+	    !ASSERT_TRUE(wait_for_verdict(skel, 1), "wait_for_pass"))
+		goto end;
+
+	recvd = recv_timeout(p0, rcv, sizeof(rcv), MSG_DONTWAIT, 1);
+	ASSERT_EQ(recvd, 151, "recv(unread)");
+end:
+	if (c0 >= 0)
+		close(c0);
+	if (p0 >= 0)
+		close(p0);
+	if (c1 >= 0)
+		close(c1);
+	if (p1 >= 0)
+		close(p1);
+	test_sockmap_drop_prog__destroy(skel);
+}
+
 /* Wait until FIONREAD returns the expected value or timeout */
 static int wait_for_fionread(int fd, int expected, unsigned int timeout_ms)
 {
@@ -1472,6 +1619,12 @@ void test_sockmap_basic(void)
 		test_sockmap_copied_seq(true);
 	if (test__start_subtest("sockmap drop after partial read"))
 		test_sockmap_drop_after_partial_read();
+	if (test__start_subtest("sockmap pass then drop"))
+		test_sockmap_pass_then_verdict(false);
+	if (test__start_subtest("sockmap pass then redirect"))
+		test_sockmap_pass_then_verdict(true);
+	if (test__start_subtest("sockmap pass after partial read"))
+		test_sockmap_pass_after_partial_read();
 	if (test__start_subtest("sockmap tcp multi channels"))
 		test_sockmap_multi_channels(SOCK_STREAM);
 	if (test__start_subtest("sockmap udp multi channels"))
diff --git a/tools/testing/selftests/bpf/progs/test_sockmap_drop_prog.c b/tools/testing/selftests/bpf/progs/test_sockmap_drop_prog.c
index 29314805ce42..ed22c1b9c8c1 100644
--- a/tools/testing/selftests/bpf/progs/test_sockmap_drop_prog.c
+++ b/tools/testing/selftests/bpf/progs/test_sockmap_drop_prog.c
@@ -23,9 +23,27 @@ struct {
 	__type(value, int);
 } sock_map_msg SEC(".maps");
 
+int verdict_calls;
+int pass_then_redirect;
+
 SEC("sk_skb")
 int prog_skb_verdict(struct __sk_buff *skb)
 {
+	__sync_fetch_and_add(&verdict_calls, 1);
+
+	return SK_DROP;
+}
+
+SEC("sk_skb/stream_verdict")
+int prog_pass_then_drop_or_redirect(struct __sk_buff *skb)
+{
+	int call = __sync_fetch_and_add(&verdict_calls, 1);
+
+	if (!call)
+		return SK_PASS;
+	if (pass_then_redirect)
+		return bpf_sk_redirect_map(skb, &sock_map_rx, 1,
+					   BPF_F_INGRESS);
 	return SK_DROP;
 }
 
