@@ -421,6 +422,8 @@ int __sk_msg_recvmsg(struct sock *sk, struct sk_psock *psock, struct msghdr *msg
 	msg_rx = sk_psock_peek_msg(psock);
 	if (copied_from_self)
 		*copied_from_self = 0;
+	if (dropped_from_self)
+		*dropped_from_self = 0;
 
 	while (copied != len) {
 		struct scatterlist *sge;
@@ -487,6 +490,8 @@ int __sk_msg_recvmsg(struct sock *sk, struct sk_psock *psock, struct msghdr *msg
 
 		msg_rx->sg.start = i;
 		if (!sge->length && (i == msg_rx->sg.end || sg_is_last(sge))) {
+			if (from_self && dropped_from_self)
+				*dropped_from_self += msg_rx->tcp_drops;
