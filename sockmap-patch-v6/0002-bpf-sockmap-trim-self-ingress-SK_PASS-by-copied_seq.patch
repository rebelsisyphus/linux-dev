From e5b99e62fecb9c2daf842fe7e64060d02fb5ab3e Mon Sep 17 00:00:00 2001
From: Dong Chenchen <superdcc97@163.com>
Date: Mon, 13 Jul 2026 23:12:56 +0800
Subject: [PATCH net v6 2/5] bpf, sockmap: trim self-ingress SK_PASS by
 copied_seq

Sockmap SK_PASS can enqueue data into psock->ingress_msg after
userspace has already consumed part of the same TCP skb through the
native receive path. If the skb is queued with offset zero, the
already-consumed prefix is delivered again through sockmap recvmsg.

Mark local SK_PASS skbs with a sockmap-private self-ingress bit before
queueing them. Use that bit, rather than skb->sk ownership, to compute
the ingress range from copied_seq before the skb is converted into an
sk_msg. Apply the same range calculation to both the direct ingress
path and the queued backlog path so SK_PASS behaves consistently when
direct enqueue is not possible.

Do not trim redirected ingress skbs, because their target socket
copied_seq is unrelated to the skb sequence space.

Fixes: e5c6de5fa025 ("bpf, sockmap: Incorrectly handling copied_seq")
Signed-off-by: Dong Chenchen <superdcc97@163.com>
---
 include/linux/skmsg.h | 16 +++++++-
 net/core/skmsg.c      | 90 +++++++++++++++++++++++++++++++------------
 2 files changed, 79 insertions(+), 27 deletions(-)

diff --git a/include/linux/skmsg.h b/include/linux/skmsg.h
index 19f4f253b4f9..faaaa1c8428f 100644
--- a/include/linux/skmsg.h
+++ b/include/linux/skmsg.h
@@ -589,9 +589,9 @@ static inline ssize_t sk_msg_first_len(struct sock *sk)
 #if IS_ENABLED(CONFIG_NET_SOCK_MSG)
 
 #define BPF_F_STRPARSER	(1UL << 1)
+#define BPF_F_SELF_INGRESS	BIT(2)
 
-/* We only have two bits so far. */
-#define BPF_F_PTR_MASK ~(BPF_F_INGRESS | BPF_F_STRPARSER)
+#define BPF_F_PTR_MASK ~(BPF_F_INGRESS | BPF_F_STRPARSER | BPF_F_SELF_INGRESS)
 
 static inline bool skb_bpf_strparser(const struct sk_buff *skb)
 {
@@ -617,6 +617,18 @@ static inline void skb_bpf_set_ingress(struct sk_buff *skb)
 	skb->_sk_redir |= BPF_F_INGRESS;
 }
 
+static inline bool skb_bpf_self_ingress(const struct sk_buff *skb)
+{
+	unsigned long sk_redir = skb->_sk_redir;
+
+	return sk_redir & BPF_F_SELF_INGRESS;
+}
+
+static inline void skb_bpf_set_self_ingress(struct sk_buff *skb)
+{
+	skb->_sk_redir |= BPF_F_SELF_INGRESS;
+}
+
 static inline void skb_bpf_set_redir(struct sk_buff *skb, struct sock *sk_redir,
 				     bool ingress)
 {
diff --git a/net/core/skmsg.c b/net/core/skmsg.c
index e1850caf1a71..ea87381b042c 100644
--- a/net/core/skmsg.c
+++ b/net/core/skmsg.c
@@ -588,17 +588,16 @@ static int sk_psock_skb_ingress_self(struct sk_psock *psock, struct sk_buff *skb
 				     u32 off, u32 len, bool take_ref);
 
 static int sk_psock_skb_ingress(struct sk_psock *psock, struct sk_buff *skb,
-				u32 off, u32 len)
+				u32 off, u32 len, bool self_ingress)
 {
 	struct sock *sk = psock->sk;
 	struct sk_msg *msg;
 	int err;
 
-	/* If we are receiving on the same sock skb->sk is already assigned,
-	 * skip memory accounting and owner transition seeing it already set
-	 * correctly.
+	/* If we are receiving on the same sock, skip memory accounting and
+	 * owner transition seeing it already set correctly.
 	 */
-	if (unlikely(skb->sk == sk))
+	if (unlikely(self_ingress || skb->sk == sk))
 		return sk_psock_skb_ingress_self(psock, skb, off, len, true);
 	msg = sk_psock_create_ingress_msg(sk, skb);
 	if (!msg)
@@ -644,7 +643,8 @@ static int sk_psock_skb_ingress_self(struct sk_psock *psock, struct sk_buff *skb
 }
 
 static int sk_psock_handle_skb(struct sk_psock *psock, struct sk_buff *skb,
-			       u32 off, u32 len, bool ingress)
+			       u32 off, u32 len, bool ingress,
+			       bool self_ingress)
 {
 	if (!ingress) {
 		if (!sock_writeable(psock->sk))
@@ -652,7 +652,41 @@ static int sk_psock_handle_skb(struct sk_psock *psock, struct sk_buff *skb,
 		return skb_send_sock(psock->sk, skb, off, len);
 	}
 
-	return sk_psock_skb_ingress(psock, skb, off, len);
+	return sk_psock_skb_ingress(psock, skb, off, len, self_ingress);
+}
+
+static bool sk_psock_skb_ingress_range(struct sk_psock *psock,
+				       struct sk_buff *skb,
+				       u32 *off, u32 *len)
+{
+	*off = 0;
+	*len = skb->len;
+
+	if (skb_bpf_strparser(skb)) {
+		struct strp_msg *stm = strp_msg(skb);
+
+		*off = stm->offset;
+		*len = stm->full_len;
+		return !!*len;
+	}
+
+	/* Only trim self-ingress TCP skbs. Redirected ingress skbs must keep
+	 * their original range because the target socket copied_seq is
+	 * unrelated.
+	 */
+	if (skb_bpf_self_ingress(skb) && sk_is_tcp(psock->sk)) {
+		u32 seq, copied;
+
+		copied = tcp_skb_readable_len(psock->sk, skb, &seq);
+		if (!copied)
+			return false;
+		*off = seq - TCP_SKB_CB(skb)->seq;
+		if (*off >= skb->len)
+			return false;
+		*len = skb->len - *off;
+	}
+
+	return true;
 }
 
 static void sk_psock_skb_state(struct sk_psock *psock,
@@ -674,7 +708,7 @@ static void sk_psock_backlog(struct work_struct *work)
 	struct sk_psock_work_state *state = &psock->work_state;
 	struct sk_buff *skb = NULL;
 	u32 len = 0, off = 0;
-	bool ingress;
+	bool ingress, self_ingress;
 	int ret;
 
 	/* If sk is quickly removed from the map and then added back, the old
@@ -693,33 +727,40 @@ static void sk_psock_backlog(struct work_struct *work)
 		return;
 	mutex_lock(&psock->work_mutex);
 	while ((skb = skb_peek(&psock->ingress_skb))) {
-		len = skb->len;
-		off = 0;
-		if (skb_bpf_strparser(skb)) {
-			struct strp_msg *stm = strp_msg(skb);
-
-			off = stm->offset;
-			len = stm->full_len;
-		}
+		ingress = skb_bpf_ingress(skb);
+		self_ingress = skb_bpf_self_ingress(skb);
 
 		/* Resume processing from previous partial state */
 		if (unlikely(state->len)) {
 			len = state->len;
 			off = state->off;
+		} else if (ingress) {
+			if (!sk_psock_skb_ingress_range(psock, skb,
+							&off, &len)) {
+				skb = skb_dequeue(&psock->ingress_skb);
+				skb_bpf_redirect_clear(skb);
+				kfree_skb(skb);
+				continue;
+			}
+		} else {
+			len = skb->len;
+			off = 0;
 		}
 
-		ingress = skb_bpf_ingress(skb);
 		skb_bpf_redirect_clear(skb);
 		do {
 			ret = -EIO;
 			if (!sock_flag(psock->sk, SOCK_DEAD))
 				ret = sk_psock_handle_skb(psock, skb, off,
-							  len, ingress);
+							  len, ingress,
+							  self_ingress);
 			if (ret <= 0) {
 				if (ret == -EAGAIN) {
 					sk_psock_skb_state(psock, state, len, off);
 					/* Restore redir info we cleared before */
 					skb_bpf_set_redir(skb, psock->sk, ingress);
+					if (self_ingress)
+						skb_bpf_set_self_ingress(skb);
 					/* Delay slightly to prioritize any
 					 * other work that might be here.
 					 */
@@ -1043,6 +1084,7 @@ static int sk_psock_verdict_apply(struct sk_psock *psock, struct sk_buff *skb,
 			goto out_free;
 
 		skb_bpf_set_ingress(skb);
+		skb_bpf_set_self_ingress(skb);
 
 		/* If the queue is empty then we can submit directly
 		 * into the msg queue. If its not empty we have to
@@ -1051,13 +1093,11 @@ static int sk_psock_verdict_apply(struct sk_psock *psock, struct sk_buff *skb,
 		 * retrying later from workqueue.
 		 */
 		if (skb_queue_empty(&psock->ingress_skb)) {
-			len = skb->len;
-			off = 0;
-			if (skb_bpf_strparser(skb)) {
-				struct strp_msg *stm = strp_msg(skb);
-
-				off = stm->offset;
-				len = stm->full_len;
+			if (!sk_psock_skb_ingress_range(psock, skb,
+							&off, &len)) {
+				consume_skb(skb);
+				err = 0;
+				break;
 			}
 			err = sk_psock_skb_ingress_self(psock, skb, off, len, false);
 		}
-- 
2.43.0

