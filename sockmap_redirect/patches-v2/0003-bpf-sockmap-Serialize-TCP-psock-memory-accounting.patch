From cb790fcb3216ebd802885b34f269b847d49d15e3 Mon Sep 17 00:00:00 2001
From: Dong Chenchen <superdcc97@163.com>
Date: Tue, 15 Sep 2026 21:00:39 +0800
Subject: [RFC PATCH 3/3] bpf, sockmap: Serialize TCP psock memory accounting

The psock backlog worker processes TCP ingress under work_mutex, which
does not exclude native TCP receive or socket operations on the target.
Ingress scheduling, skb ownership changes and the final skb release can
race on sk_forward_alloc. After map detachment, purging the old psock's
messages or cork can race with accounting on the same live socket too.

Hold the target TCP socket lock for each ingress skb, through message
publication and the worker's kfree_skb(). Locking just owner assignment
is insufficient: recvmsg can drop the message reference first, leaving
the worker to run sock_rfree() on the last reference. Cover self and
cross-socket ingress, and release the lock on success, retry and error.

Use the same socket lock for ingress and cork reclamation in destroy
work, after synchronously stopping parser and backlog work. Defer TCP
cork cleanup from sk_psock_stop(), whose map callers can hold spinlocks.
Preserve non-TCP cork cleanup in stop.

Keep immediate TCP cork cleanup in sock_map_close(), under its existing
socket lock and before unlocking to wait for backlog work. Otherwise an
in-flight egress worker could append to the old cork during that wait.
sock_map_destroy() does not establish socket exclusion itself, so leave
its remaining TCP cork to destroy work. Keep the psock's socket reference
until reclamation ends. Cork cleanup uses pages, skb references and socket
accounting; it does not depend on the subsequent program or link cleanup.

Keep work_mutex and leave egress unlocked at the worker level, since the
send path takes the socket lock internally. Do not add a sleeping lock
to the synchronous SK_PASS helper.

This requires commit 8bbabb3fddcd ("bpf, sock_map: Move cancel_work_sync()
out of sock lock") or equivalent ordering. Close releases the socket lock
before cancel; destroy work cancels before taking it. Neither waits while
holding the lock needed by the worker, avoiding the close/work wait cycle
associated with commit 799aa7f98d53 ("skmsg: Avoid lock_sock() in
sk_psock_backlog()"). The ingress-only outer lock also avoids recursive
socket locking on egress.

Native TCP teardown of an owned, unaccepted child remains an independent
race: inet_csk_listen_stop() can continue to tcp_disconnect() and
sk_stream_kill_queues() despite socket ownership. This change serializes
psock accounting against paths that obey that ownership protocol; it
does not fix the native child teardown path.

Fixes: 799aa7f98d53 ("skmsg: Avoid lock_sock() in sk_psock_backlog()")
Assisted-by: LLM
Signed-off-by: Dong Chenchen <superdcc97@163.com>
---
 net/core/skmsg.c    | 24 ++++++++++++++++++++++--
 net/core/sock_map.c |  2 ++
 2 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/net/core/skmsg.c b/net/core/skmsg.c
index 26b0a84332fb..028bb6a32aab 100644
--- a/net/core/skmsg.c
+++ b/net/core/skmsg.c
@@ -682,6 +682,7 @@ static void sk_psock_backlog(struct work_struct *work)
 	struct sk_psock_work_state *state = &psock->work_state;
 	struct sk_buff *skb = NULL;
 	u32 len = 0, off = 0;
+	bool locked = false;
 	bool ingress;
 	int ret;
 
@@ -719,6 +720,10 @@ static void sk_psock_backlog(struct work_struct *work)
 		}
 
 		ingress = skb_bpf_ingress(skb);
+		/* Egress acquires the socket lock in the send path. */
+		locked = ingress && sk_is_tcp(psock->sk);
+		if (locked)
+			lock_sock(psock->sk);
 		skb_bpf_redirect_clear(skb);
 		do {
 			ret = -EIO;
@@ -749,9 +754,16 @@ static void sk_psock_backlog(struct work_struct *work)
 		/* The entire skb sent, clear state */
 		sk_psock_skb_state(psock, state, 0, 0);
 		skb = skb_dequeue(&psock->ingress_skb);
+		/* The last reference can run sock_rfree(), which also needs the lock. */
 		kfree_skb(skb);
+		if (locked) {
+			release_sock(psock->sk);
+			locked = false;
+		}
 	}
 end:
+	if (locked)
+		release_sock(psock->sk);
 	mutex_unlock(&psock->work_mutex);
 	sk_psock_put(psock->sk, psock);
 }
@@ -864,7 +876,9 @@ void sk_psock_stop(struct sk_psock *psock)
 {
 	spin_lock_bh(&psock->ingress_lock);
 	sk_psock_clear_state(psock, SK_PSOCK_TX_ENABLED);
-	sk_psock_cork_free(psock);
+	/* TCP cork is reclaimed under the socket lock in close or destroy work. */
+	if (!sk_is_tcp(psock->sk))
+		sk_psock_cork_free(psock);
 	spin_unlock_bh(&psock->ingress_lock);
 }
 
@@ -878,14 +892,20 @@ static void sk_psock_destroy(struct work_struct *work)
 
 	sk_psock_done_strp(psock);
 
+	/* The backlog worker may need the socket lock, so cancel it first. */
 	cancel_delayed_work_sync(&psock->work);
+	/* A detached psock can still own memory charged to a live socket. */
+	if (sk_is_tcp(psock->sk))
+		lock_sock(psock->sk);
 	__sk_psock_zap_ingress(psock);
+	sk_psock_cork_free(psock);
+	if (sk_is_tcp(psock->sk))
+		release_sock(psock->sk);
 	mutex_destroy(&psock->work_mutex);
 
 	psock_progs_drop(&psock->progs);
 
 	sk_psock_link_destroy(psock);
-	sk_psock_cork_free(psock);
 
 	if (psock->sk_redir)
 		sock_put(psock->sk_redir);
diff --git a/net/core/sock_map.c b/net/core/sock_map.c
index ca49bc7f8687..fca836baee34 100644
--- a/net/core/sock_map.c
+++ b/net/core/sock_map.c
@@ -1712,6 +1712,8 @@ void sock_map_close(struct sock *sk, long timeout)
 		sock_map_remove_links(sk, psock);
 		rcu_read_unlock();
 		sk_psock_stop(psock);
+		if (sk_is_tcp(sk))
+			sk_psock_cork_free(psock);
 		release_sock(sk);
 		cancel_delayed_work_sync(&psock->work);
 		sk_psock_put(sk, psock);
-- 
