From: Codex <codex@local>
Subject: [PATCH net 2/2] selftests/bpf: cover concurrent UDP sockmap recvmsg

Add sockmap_basic coverage for concurrent recvmsg() on a UDP socket
inserted into a sockmap with an SK_PASS verdict program.

The test starts multiple reader threads on the same UDP sockmap socket
while the peer sends large datagrams.  The unfixed kernel can race while
consuming the same sk_msg and report copy_page_to_iter()/sk_msg_recvmsg
warnings or return unexpected recv errors.  The test asserts that the
concurrent readers make progress without non-EAGAIN recv errors.

This test intentionally does not include the separate UDP forward_alloc
accounting fix, which is covered by the existing community patch series.

Signed-off-by: YOUR NAME <YOUR.EMAIL@example.com>
---
 .../selftests/bpf/prog_tests/sockmap_basic.c       | 158 +++++++++++++++++++++
 1 file changed, 158 insertions(+)
diff --git a/tools/testing/selftests/bpf/prog_tests/sockmap_basic.c b/tools/testing/selftests/bpf/prog_tests/sockmap_basic.c
index d2846579285f..18d6808a4ffd 100644
--- a/tools/testing/selftests/bpf/prog_tests/sockmap_basic.c
+++ b/tools/testing/selftests/bpf/prog_tests/sockmap_basic.c
@@ -4,6 +4,8 @@
 #include <linux/tcp.h>
 #include <linux/socket.h>
 #include <sys/epoll.h>
+#include <sched.h>
+#include <stdatomic.h>
 
 #include "test_progs.h"
 #include "test_skmsg_load_helpers.skel.h"
@@ -23,6 +25,10 @@
 #define TCP_REPAIR_ON		1
 #define TCP_REPAIR_OFF_NO_WP	-1	/* Turn off without window probes */
 
+#define UDP_CONCURRENT_RECV_THREADS	16
+#define UDP_CONCURRENT_RECV_ITERS	100
+#define UDP_CONCURRENT_RECV_DGRAM_SIZE	32768
+
 /**
  * SOL_TCP is defined in <netinet/tcp.h> (glibc), but the copybuf_address
  * field of tcp_zerocopy_receive is not yet included in older versions.
@@ -1327,6 +1333,156 @@ static void test_sockmap_multi_channels(int sotype)
 	test_sockmap_pass_prog__destroy(skel);
 }
 
+struct udp_concurrent_recv_ctx {
+	int fd;
+	atomic_int *go;
+	atomic_long *ops;
+	atomic_long *bytes;
+	atomic_long *errs;
+	int id;
+};
+
+static void *udp_concurrent_recv_thread(void *arg)
+{
+	struct udp_concurrent_recv_ctx *ctx = arg;
+	char buf[UDP_CONCURRENT_RECV_DGRAM_SIZE];
+	unsigned int seed = (unsigned long)pthread_self() ^ ctx->id;
+
+	while (!atomic_load_explicit(ctx->go, memory_order_relaxed))
+		sched_yield();
+
+	while (atomic_load_explicit(ctx->go, memory_order_relaxed) == 1) {
+		size_t len = 1 + (rand_r(&seed) % sizeof(buf));
+		int flags = MSG_DONTWAIT;
+		ssize_t ret;
+
+		if ((rand_r(&seed) & 31) == 0)
+			flags |= MSG_PEEK;
+
+		ret = recv(ctx->fd, buf, len, flags);
+		if (ret > 0) {
+			atomic_fetch_add_explicit(ctx->ops, 1, memory_order_relaxed);
+			atomic_fetch_add_explicit(ctx->bytes, ret, memory_order_relaxed);
+		} else if (ret < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+			atomic_fetch_add_explicit(ctx->errs, 1, memory_order_relaxed);
+		}
+	}
+
+	return NULL;
+}
+
+static int sockmap_udp_send_batch(int fd, const char *payload, int nr)
+{
+	int i, sent = 0;
+
+	for (i = 0; i < nr; i++) {
+		ssize_t ret;
+
+		ret = send(fd, payload, UDP_CONCURRENT_RECV_DGRAM_SIZE,
+			   MSG_DONTWAIT);
+		if (ret < 0) {
+			if (errno == EAGAIN || errno == EWOULDBLOCK)
+				continue;
+			FAIL_ERRNO("send");
+			return -1;
+		}
+		sent++;
+	}
+
+	return sent;
+}
+
+static int sockmap_udp_concurrent_recv_once(struct test_sockmap_pass_prog *skel,
+					    int iter)
+{
+	pthread_t tids[UDP_CONCURRENT_RECV_THREADS];
+	struct udp_concurrent_recv_ctx ctx[UDP_CONCURRENT_RECV_THREADS];
+	atomic_long ops = 0, bytes = 0, errs = 0;
+	atomic_int go = 0;
+	char payload[UDP_CONCURRENT_RECV_DGRAM_SIZE];
+	int err, map, rx = -1, tx = -1, zero = 0;
+	int i, created = 0, buf = 4 << 20;
+
+	err = create_pair(AF_INET, SOCK_DGRAM, &rx, &tx);
+	if (!ASSERT_OK(err, "create_pair"))
+		return -1;
+
+	xsetsockopt(rx, SOL_SOCKET, SO_RCVBUF, &buf, sizeof(buf));
+	xsetsockopt(tx, SOL_SOCKET, SO_SNDBUF, &buf, sizeof(buf));
+
+	map = bpf_map__fd(skel->maps.sock_map_rx);
+
+	err = bpf_map_update_elem(map, &zero, &rx, BPF_ANY);
+	if (!ASSERT_OK(err, "bpf_map_update_elem"))
+		goto out;
+
+	memset(payload, 'A' + (iter % 26), sizeof(payload));
+	if (sockmap_udp_send_batch(tx, payload, 64) <= 0)
+		goto out_delete;
+
+	for (i = 0; i < UDP_CONCURRENT_RECV_THREADS; i++) {
+		ctx[i].fd = rx;
+		ctx[i].go = &go;
+		ctx[i].ops = &ops;
+		ctx[i].bytes = &bytes;
+		ctx[i].errs = &errs;
+		ctx[i].id = i;
+		err = pthread_create(&tids[i], NULL,
+				     udp_concurrent_recv_thread, &ctx[i]);
+		if (!ASSERT_OK(err, "pthread_create"))
+			goto stop_threads;
+		created++;
+	}
+
+	atomic_store(&go, 1);
+	sockmap_udp_send_batch(tx, payload, 128);
+	usleep(20000);
+
+stop_threads:
+	atomic_store(&go, 2);
+	for (i = 0; i < created; i++)
+		pthread_join(tids[i], NULL);
+
+	ASSERT_GT(atomic_load(&ops), 0, "recv ops");
+	ASSERT_GT(atomic_load(&bytes), 0, "recv bytes");
+	if (!ASSERT_EQ(atomic_load(&errs), 0, "recv errors"))
+		err = -EIO;
+
+out_delete:
+	bpf_map_delete_elem(map, &zero);
+out:
+	if (rx >= 0)
+		close(rx);
+	if (tx >= 0)
+		close(tx);
+	return err;
+}
+
+static void test_sockmap_udp_concurrent_recv(void)
+{
+	struct test_sockmap_pass_prog *skel;
+	int err, map, prog, i;
+
+	skel = test_sockmap_pass_prog__open_and_load();
+	if (!ASSERT_OK_PTR(skel, "open_and_load"))
+		return;
+
+	map = bpf_map__fd(skel->maps.sock_map_rx);
+	prog = bpf_program__fd(skel->progs.prog_skb_verdict);
+
+	err = bpf_prog_attach(prog, map, BPF_SK_SKB_STREAM_VERDICT, 0);
+	if (!ASSERT_OK(err, "bpf_prog_attach"))
+		goto out;
+
+	for (i = 0; i < UDP_CONCURRENT_RECV_ITERS; i++) {
+		if (sockmap_udp_concurrent_recv_once(skel, i))
+			break;
+	}
+
+out:
+	test_sockmap_pass_prog__destroy(skel);
+}
+
 void test_sockmap_basic(void)
 {
 	if (test__start_subtest("sockmap create_update_free"))
@@ -1403,4 +1559,6 @@ void test_sockmap_basic(void)
 		test_sockmap_multi_channels(SOCK_STREAM);
 	if (test__start_subtest("sockmap udp multi channels"))
 		test_sockmap_multi_channels(SOCK_DGRAM);
+	if (test__start_subtest("sockmap udp concurrent recv"))
+		test_sockmap_udp_concurrent_recv();
 }
