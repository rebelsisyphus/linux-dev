diff --git a/kernel/tasklist.c b/kernel/tasklist.c
new file mode 100644
index 000000000000..258094297364
--- /dev/null
+++ b/kernel/tasklist.c
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/debugfs.h>
+#include <linux/init.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+
+struct task_domain **task_domains __read_mostly;
+
+/*
+ * Shards are permanent, including those belonging to offline nodes. A task
+ * keeps its home shard after migration, and every thread shares its leader's
+ * shard so that release_task() can also serialize the last-thread notification.
+ */
+void __init init_task_domains(void)
+{
+	struct task_domain **domains;
+	int nid;
+
+	domains = kcalloc(nr_node_ids, sizeof(*domains), GFP_KERNEL);
+	if (!domains)
+		panic("fork_init: failed to allocate task domains\n");
+
+	for (nid = 0; nid < nr_node_ids; nid++) {
+		int alloc_nid = node_state(nid, N_MEMORY) ? nid : NUMA_NO_NODE;
+		struct task_domain *td;
+
+		td = kzalloc_node(sizeof(*td), GFP_KERNEL, alloc_nid);
+		if (!td)
+			panic("fork_init: failed to allocate task domain %d\n", nid);
+		INIT_LIST_HEAD(&td->tasks);
+		rwlock_init(&td->lock);
+		domains[nid] = td;
+	}
+
+	/* Publish only after every slot is ready for interrupt-side readers. */
+	task_domains = domains;
+}
+
+struct task_struct *next_task(struct task_struct *p)
+{
+	struct list_head *next;
+	int nid;
+
+	if (!task_domains)
+		return &init_task;
+	if (p == &init_task) {
+		nid = 0;
+		next = rcu_dereference_check(task_domains[nid]->tasks.next,
+					     lockdep_tasklist_lock_is_held());
+	} else {
+		nid = p->task_domain_nid;
+		next = rcu_dereference_check(p->tasks.next,
+					     lockdep_tasklist_lock_is_held());
+	}
+
+	while (next == &task_domains[nid]->tasks) {
+		if (++nid == nr_node_ids)
+			return &init_task;
+		next = rcu_dereference_check(task_domains[nid]->tasks.next,
+					     lockdep_tasklist_lock_is_held());
+	}
+	return list_entry(next, struct task_struct, tasks);
+}
+EXPORT_SYMBOL(next_task);
+
+bool tasklist_empty(void)
+{
+	int nid;
+
+	if (!task_domains)
+		return list_empty(&init_task.tasks);
+	for (nid = 0; nid < nr_node_ids; nid++)
+		if (!list_empty(&task_domains[nid]->tasks))
+			return false;
+	return true;
+}
+EXPORT_SYMBOL(tasklist_empty);
+
+/*
+ * Model the complete set of shards as one lockdep lock, using the historic
+ * tasklist_lock map. This retains the external lock ordering and assertions
+ * without consuming one held-lock entry per NUMA node. Single-shard writers
+ * use the same map; none of these helpers may be nested. Raw operations below
+ * retain rwlock debugging, while preemption and lockdep are handled once for
+ * the entire operation. Readers/writers acquire shards in ascending order.
+ *
+ * UP and PREEMPT_RT retain the ordinary tasklist rwlock. The latter must not
+ * use raw rwlock operations on its sleeping rwlock implementation.
+ */
+#if defined(CONFIG_SMP) && !defined(CONFIG_PREEMPT_RT)
+#define TASKLIST_SHARDS 1
+#else
+#define TASKLIST_SHARDS 0
+#endif
+
+void read_lock_tasklist_all(void)
+{
+#if TASKLIST_SHARDS
+	int nid;
+
+	if (task_domains) {
+		preempt_disable();
+		rwlock_acquire_read(&tasklist_lock.dep_map, 0, 0, _RET_IP_);
+		for (nid = 0; nid < nr_node_ids; nid++)
+			do_raw_read_lock(&task_domains[nid]->lock);
+		return;
+	}
+#endif
+	read_lock(&tasklist_lock);
+}
+EXPORT_SYMBOL(read_lock_tasklist_all);
+
+int read_trylock_tasklist_all(void)
+{
+#if TASKLIST_SHARDS
+	int nid;
+
+	if (task_domains) {
+		preempt_disable();
+		for (nid = 0; nid < nr_node_ids; nid++) {
+			if (!do_raw_read_trylock(&task_domains[nid]->lock))
+				goto undo;
+		}
+		rwlock_acquire_read(&tasklist_lock.dep_map, 0, 1, _RET_IP_);
+		return 1;
+undo:
+		while (nid--)
+			do_raw_read_unlock(&task_domains[nid]->lock);
+		preempt_enable();
+		return 0;
+	}
+#endif
+	return read_trylock(&tasklist_lock);
+}
+EXPORT_SYMBOL(read_trylock_tasklist_all);
+
+void read_unlock_tasklist_all(void)
+{
+#if TASKLIST_SHARDS
+	int nid;
+
+	if (task_domains) {
+		rwlock_release(&tasklist_lock.dep_map, _RET_IP_);
+		for (nid = nr_node_ids - 1; nid >= 0; nid--)
+			do_raw_read_unlock(&task_domains[nid]->lock);
+		preempt_enable();
+		return;
+	}
+#endif
+	read_unlock(&tasklist_lock);
+}
+EXPORT_SYMBOL(read_unlock_tasklist_all);
+
+void write_lock_tasklist_all(void)
+{
+#if TASKLIST_SHARDS
+	int nid;
+
+	if (task_domains) {
+		preempt_disable();
+		rwlock_acquire(&tasklist_lock.dep_map, 0, 0, _RET_IP_);
+		for (nid = 0; nid < nr_node_ids; nid++)
+			do_raw_write_lock(&task_domains[nid]->lock);
+		return;
+	}
+#endif
+	write_lock(&tasklist_lock);
+}
+EXPORT_SYMBOL(write_lock_tasklist_all);
+
+void write_unlock_tasklist_all(void)
+{
+#if TASKLIST_SHARDS
+	int nid;
+
+	if (task_domains) {
+		rwlock_release(&tasklist_lock.dep_map, _RET_IP_);
+		for (nid = nr_node_ids - 1; nid >= 0; nid--)
+			do_raw_write_unlock(&task_domains[nid]->lock);
+		preempt_enable();
+		return;
+	}
+#endif
+	write_unlock(&tasklist_lock);
+}
+EXPORT_SYMBOL(write_unlock_tasklist_all);
+
+void write_lock_irq_tasklist_all(void)
+{
+#if TASKLIST_SHARDS
+	local_irq_disable();
+	preempt_disable();
+	write_lock_tasklist_all();
+#else
+	write_lock_irq(&tasklist_lock);
+#endif
+}
+EXPORT_SYMBOL(write_lock_irq_tasklist_all);
+
+void write_unlock_irq_tasklist_all(void)
+{
+#if TASKLIST_SHARDS
+	write_unlock_tasklist_all();
+	local_irq_enable();
+	preempt_enable();
+#else
+	write_unlock_irq(&tasklist_lock);
+#endif
+}
+EXPORT_SYMBOL(write_unlock_irq_tasklist_all);
+
+void write_lock_irq_task_domain(int nid)
+{
+#if TASKLIST_SHARDS
+	local_irq_disable();
+	preempt_disable();
+	rwlock_acquire(&tasklist_lock.dep_map, 0, 0, _RET_IP_);
+	do_raw_write_lock(&task_domains[nid]->lock);
+#else
+	write_lock_irq(&tasklist_lock);
+#endif
+}
+
+void write_unlock_irq_task_domain(int nid)
+{
+#if TASKLIST_SHARDS
+	rwlock_release(&tasklist_lock.dep_map, _RET_IP_);
+	do_raw_write_unlock(&task_domains[nid]->lock);
+	local_irq_enable();
+	preempt_enable();
+#else
+	write_unlock_irq(&tasklist_lock);
+#endif
+}
+
+#ifdef CONFIG_DEBUG_FS
+static int task_domain_nr_tasks_show(struct seq_file *m, void *v)
+{
+	struct task_domain *td = m->private;
+
+	seq_printf(m, "%lu\n", READ_ONCE(td->nr_tasks));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(task_domain_nr_tasks);
+
+static int __init task_domains_debugfs_init(void)
+{
+	struct dentry *root;
+	int nid;
+
+	root = debugfs_create_dir("task_domains", NULL);
+	if (IS_ERR(root))
+		return 0;
+	for (nid = 0; nid < nr_node_ids; nid++) {
+		struct dentry *dir;
+		char name[16];
+
+		snprintf(name, sizeof(name), "%d", nid);
+		dir = debugfs_create_dir(name, root);
+		if (IS_ERR(dir))
+			continue;
+		debugfs_create_file("nr_tasks", 0444, dir, task_domains[nid],
+				    &task_domain_nr_tasks_fops);
+	}
+	return 0;
+}
+late_initcall(task_domains_debugfs_init);
+#endif
