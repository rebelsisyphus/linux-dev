From 5f37000dd960b165a7ca2f6969e9cdd3fa556b8b Mon Sep 17 00:00:00 2001
From: Dong Chenchen <dongchenchen2@huawei.com>
Date: Tue, 27 Oct 2026 16:39:43 +0800
Subject: [PATCH 2/2] fork: cache per-CPU RSS backing by originating NUMA node

Adapt patches 26 and 27 from numa-domain-v2-patches, originally by
robin <robin800601@gmail.com>, to this tree's atomic RSS initialization.

Acquire cached storage only when an mm switches to per-CPU RSS accounting
on CLONE_THREAD. Preserve its existing count values and allocation flags.
Remember the source cache node so teardown returns storage there after
migration. Limit each node to 64 entries, with normal allocation/free
fallback when cache setup fails or the cache is full.

Split per-CPU counter storage allocation, initialization, detachment and
freeing. Detachment removes debug-object and CPU-hotplug registrations,
clears counter pointers and zeroes every possible CPU before reuse.
Ordinary destruction still frees directly without unnecessary zeroing.

Expose per-node cache occupancy and reuse statistics in debugfs. Retain
the existing counter helpers on UP configurations.

Signed-off-by: Dong Chenchen <dongchenchen2@huawei.com>
---
 include/linux/mm_types.h       |   3 +
 include/linux/percpu_counter.h |  11 +++
 kernel/fork.c                  | 168 ++++++++++++++++++++++++++++++++-
 lib/percpu_counter.c           |  80 +++++++++++++---
 4 files changed, 246 insertions(+), 16 deletions(-)

diff --git a/include/linux/mm_types.h b/include/linux/mm_types.h
index 20c62bc70558..5a04c6ec357b 100644
--- a/include/linux/mm_types.h
+++ b/include/linux/mm_types.h
@@ -898,6 +898,9 @@ struct mm_struct {
 		unsigned long saved_auxv[AT_VECTOR_SIZE]; /* for /proc/PID/auxv */
 
 		struct percpu_counter rss_stat[NR_MM_COUNTERS];
+#ifdef CONFIG_SMP
+		int rss_stat_backing_nid;
+#endif
 
 		struct linux_binfmt *binfmt;
 
diff --git a/include/linux/percpu_counter.h b/include/linux/percpu_counter.h
index c50716df9fa3..4b42df4a01dc 100644
--- a/include/linux/percpu_counter.h
+++ b/include/linux/percpu_counter.h
@@ -45,6 +45,17 @@ int __percpu_counter_init_many(struct percpu_counter *fbc, s64 amount,
 			       gfp_t gfp, u32 nr_counters,
 			       struct lock_class_key *key, bool switch_mode);
 
+/* Reusable storage must be zeroed and detached from CPU-hotplug tracking. */
+void __percpu *percpu_counter_alloc_many_backing(u32 nr_counters, gfp_t gfp);
+int __percpu_counter_init_many_from_backing(struct percpu_counter *fbc,
+					    s64 amount, void __percpu *backing,
+					    u32 nr_counters,
+					    struct lock_class_key *key,
+					    bool switch_mode);
+void __percpu *percpu_counter_detach_many(struct percpu_counter *fbc,
+					  u32 nr_counters);
+void percpu_counter_free_many_backing(void __percpu *backing);
+
 #define percpu_counter_init_many(fbc, value, gfp, nr_counters)		\
 	({								\
 		static struct lock_class_key __key;			\
diff --git a/kernel/fork.c b/kernel/fork.c
index 90cabe33d98d..b939e9478362 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -13,6 +13,8 @@
  */
 
 #include <linux/anon_inodes.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
 #include <linux/slab.h>
 #include <linux/sched/autogroup.h>
 #include <linux/sched/mm.h>
@@ -157,6 +159,164 @@ DEFINE_PER_CPU(unsigned long, process_counts) = 0;
 
 __cacheline_aligned DEFINE_RWLOCK(tasklist_lock);  /* outer */
 
+#ifdef CONFIG_SMP
+#define MM_RSS_STAT_BACKING_CACHE_DEPTH 64
+
+struct mm_rss_stat_backing_cache {
+	raw_spinlock_t lock;
+	unsigned int nr;
+	unsigned long hits, misses, pushes, full;
+	void __percpu *entries[MM_RSS_STAT_BACKING_CACHE_DEPTH];
+} ____cacheline_aligned_in_smp;
+
+static struct mm_rss_stat_backing_cache *mm_rss_stat_backing_caches;
+
+static void __init init_mm_rss_stat_backing_cache(void)
+{
+	int nid;
+
+	mm_rss_stat_backing_caches =
+		kcalloc(nr_node_ids, sizeof(*mm_rss_stat_backing_caches),
+			GFP_KERNEL);
+	if (!mm_rss_stat_backing_caches)
+		return;
+	for (nid = 0; nid < nr_node_ids; nid++)
+		raw_spin_lock_init(&mm_rss_stat_backing_caches[nid].lock);
+}
+
+static void __percpu *mm_rss_stat_backing_cache_pop(int *nidp)
+{
+	struct mm_rss_stat_backing_cache *cache;
+	void __percpu *backing = NULL;
+	unsigned long flags;
+	int nid = numa_node_id();
+
+	if (!mm_rss_stat_backing_caches)
+		return NULL;
+	if (nid == NUMA_NO_NODE || nid >= nr_node_ids)
+		nid = 0;
+	*nidp = nid;
+	cache = &mm_rss_stat_backing_caches[nid];
+	raw_spin_lock_irqsave(&cache->lock, flags);
+	if (cache->nr) {
+		backing = cache->entries[--cache->nr];
+		cache->entries[cache->nr] = NULL;
+		cache->hits++;
+	} else {
+		cache->misses++;
+	}
+	raw_spin_unlock_irqrestore(&cache->lock, flags);
+	return backing;
+}
+
+static void mm_rss_stat_backing_cache_push(void __percpu *backing, int nid)
+{
+	struct mm_rss_stat_backing_cache *cache;
+	unsigned long flags;
+
+	if (!backing)
+		return;
+	if (!mm_rss_stat_backing_caches || nid == NUMA_NO_NODE)
+		goto free;
+
+	cache = &mm_rss_stat_backing_caches[nid];
+	raw_spin_lock_irqsave(&cache->lock, flags);
+	cache->pushes++;
+	if (cache->nr < MM_RSS_STAT_BACKING_CACHE_DEPTH) {
+		cache->entries[cache->nr++] = backing;
+		backing = NULL;
+	} else {
+		cache->full++;
+	}
+	raw_spin_unlock_irqrestore(&cache->lock, flags);
+free:
+	percpu_counter_free_many_backing(backing);
+}
+
+static int mm_rss_stat_switch_to_pcpu(struct mm_struct *mm)
+{
+	static struct lock_class_key key;
+	const gfp_t gfp = GFP_ATOMIC | __GFP_NOWARN | __GFP_ZERO;
+	void __percpu *backing;
+	unsigned long flags;
+	int nid = NUMA_NO_NODE;
+	int ret = 0;
+
+	if (percpu_counter_initialized(mm->rss_stat))
+		return 0;
+
+	/* Preserve this tree's atomic-to-percpu transition and count values. */
+	preempt_disable();
+	local_irq_save(flags);
+	if (!percpu_counter_initialized(mm->rss_stat)) {
+		backing = mm_rss_stat_backing_cache_pop(&nid);
+		if (!backing)
+			backing = percpu_counter_alloc_many_backing(NR_MM_COUNTERS,
+								    gfp);
+		ret = __percpu_counter_init_many_from_backing(mm->rss_stat, 0,
+							      backing, NR_MM_COUNTERS,
+							      &key, true);
+		if (!ret)
+			mm->rss_stat_backing_nid = nid;
+	}
+	local_irq_restore(flags);
+	preempt_enable();
+	return ret;
+}
+
+static void mm_rss_stat_destroy(struct mm_struct *mm)
+{
+	void __percpu *backing;
+	int nid = mm->rss_stat_backing_nid;
+
+	mm->rss_stat_backing_nid = NUMA_NO_NODE;
+	backing = percpu_counter_detach_many(mm->rss_stat, NR_MM_COUNTERS);
+	mm_rss_stat_backing_cache_push(backing, nid);
+}
+
+#ifdef CONFIG_DEBUG_FS
+static int mm_rss_stat_backing_cache_show(struct seq_file *m, void *v)
+{
+	int nid;
+
+	seq_puts(m, "nid nr hits misses pushes full frees\n");
+	if (!mm_rss_stat_backing_caches)
+		return 0;
+	for (nid = 0; nid < nr_node_ids; nid++) {
+		struct mm_rss_stat_backing_cache *cache;
+
+		cache = &mm_rss_stat_backing_caches[nid];
+		seq_printf(m, "%d %u %lu %lu %lu %lu %lu\n", nid,
+			   READ_ONCE(cache->nr), READ_ONCE(cache->hits),
+			   READ_ONCE(cache->misses), READ_ONCE(cache->pushes),
+			   READ_ONCE(cache->full), READ_ONCE(cache->full));
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mm_rss_stat_backing_cache);
+
+static int __init mm_rss_stat_backing_cache_debugfs_init(void)
+{
+	debugfs_create_file("mm_rss_stat_backing_cache", 0444, NULL, NULL,
+			    &mm_rss_stat_backing_cache_fops);
+	return 0;
+}
+late_initcall(mm_rss_stat_backing_cache_debugfs_init);
+#endif
+#else
+static void __init init_mm_rss_stat_backing_cache(void) { }
+
+static int mm_rss_stat_switch_to_pcpu(struct mm_struct *mm)
+{
+	return mm_counter_switch_to_pcpu(mm);
+}
+
+static void mm_rss_stat_destroy(struct mm_struct *mm)
+{
+	mm_counter_destroy(mm);
+}
+#endif
+
 #ifdef CONFIG_PROVE_RCU
 int lockdep_tasklist_lock_is_held(void)
 {
@@ -1124,7 +1284,7 @@ void __mmdrop(struct mm_struct *mm)
 	put_user_ns(mm->user_ns);
 	mm_pasid_drop(mm);
 	mm_destroy_cid(mm);
-	mm_counter_destroy(mm);
+	mm_rss_stat_destroy(mm);
 
 	free_mm(mm);
 }
@@ -1286,6 +1446,7 @@ void __init fork_init(void)
 	lockdep_init_task(&init_task);
 	uprobes_init();
 	init_task_domains();
+	init_mm_rss_stat_backing_cache();
 }
 
 int __weak arch_dup_task_struct(struct task_struct *dst,
@@ -1508,6 +1669,9 @@ static struct mm_struct *mm_init(struct mm_struct *mm, struct task_struct *p,
 	mm->locked_vm = 0;
 	atomic64_set(&mm->pinned_vm, 0);
 	memset(&mm->rss_stat, 0, sizeof(mm->rss_stat));
+#ifdef CONFIG_SMP
+	mm->rss_stat_backing_nid = NUMA_NO_NODE;
+#endif
 #ifdef CONFIG_I_MMAP_SHARDS
 	if (i_mmap_opt_enabled()) {
 		mm->i_mmap_home_nid = numa_node_id();
@@ -1990,7 +2154,7 @@ static int copy_mm(unsigned long clone_flags, struct task_struct *tsk)
 	 * the percpu mode to reduce the error margin.
 	 */
 	if (clone_flags & CLONE_THREAD)
-		if (mm_counter_switch_to_pcpu(oldmm))
+		if (mm_rss_stat_switch_to_pcpu(oldmm))
 			return -ENOMEM;
 
 	if (clone_flags & CLONE_VM) {
diff --git a/lib/percpu_counter.c b/lib/percpu_counter.c
index fb30d739f4b5..e4e311539287 100644
--- a/lib/percpu_counter.c
+++ b/lib/percpu_counter.c
@@ -151,19 +151,28 @@ s64 __percpu_counter_sum(struct percpu_counter *fbc)
 }
 EXPORT_SYMBOL(__percpu_counter_sum);
 
-int __percpu_counter_init_many(struct percpu_counter *fbc, s64 amount,
-			       gfp_t gfp, u32 nr_counters,
-			       struct lock_class_key *key, bool switch_mode)
+static size_t percpu_counter_many_size(u32 nr_counters)
+{
+	return nr_counters * ALIGN(sizeof(s32), __alignof__(s32));
+}
+
+void __percpu *percpu_counter_alloc_many_backing(u32 nr_counters, gfp_t gfp)
+{
+	return __alloc_percpu_gfp(percpu_counter_many_size(nr_counters),
+				 __alignof__(s32), gfp);
+}
+
+int __percpu_counter_init_many_from_backing(struct percpu_counter *fbc,
+					    s64 amount, void __percpu *backing,
+					    u32 nr_counters,
+					    struct lock_class_key *key,
+					    bool switch_mode)
 {
 	unsigned long flags __maybe_unused;
-	size_t counter_size;
-	s32 __percpu *counters;
+	size_t counter_size = ALIGN(sizeof(s32), __alignof__(s32));
 	u32 i;
 
-	counter_size = ALIGN(sizeof(*counters), __alignof__(*counters));
-	counters = __alloc_percpu_gfp(nr_counters * counter_size,
-				      __alignof__(*counters), gfp);
-	if (!counters) {
+	if (!backing) {
 		fbc[0].counters = NULL;
 		return -ENOMEM;
 	}
@@ -176,7 +185,7 @@ int __percpu_counter_init_many(struct percpu_counter *fbc, s64 amount,
 #endif
 		if (likely(!switch_mode))
 			fbc[i].count = amount;
-		fbc[i].counters = (void *)counters + (i * counter_size);
+		fbc[i].counters = backing + i * counter_size;
 
 		debug_percpu_counter_activate(&fbc[i]);
 	}
@@ -189,18 +198,31 @@ int __percpu_counter_init_many(struct percpu_counter *fbc, s64 amount,
 #endif
 	return 0;
 }
+
+int __percpu_counter_init_many(struct percpu_counter *fbc, s64 amount,
+			       gfp_t gfp, u32 nr_counters,
+			       struct lock_class_key *key, bool switch_mode)
+{
+	void __percpu *backing;
+
+	backing = percpu_counter_alloc_many_backing(nr_counters, gfp);
+	return __percpu_counter_init_many_from_backing(fbc, amount, backing,
+						 nr_counters, key, switch_mode);
+}
 EXPORT_SYMBOL(__percpu_counter_init_many);
 
-void percpu_counter_destroy_many(struct percpu_counter *fbc, u32 nr_counters)
+static void __percpu *percpu_counter_detach_storage(struct percpu_counter *fbc,
+						    u32 nr_counters)
 {
 	unsigned long flags __maybe_unused;
+	void __percpu *backing;
 	u32 i;
 
 	if (WARN_ON_ONCE(!fbc))
-		return;
+		return NULL;
 
 	if (!fbc[0].counters)
-		return;
+		return NULL;
 
 	for (i = 0; i < nr_counters; i++)
 		debug_percpu_counter_deactivate(&fbc[i]);
@@ -212,10 +234,40 @@ void percpu_counter_destroy_many(struct percpu_counter *fbc, u32 nr_counters)
 	spin_unlock_irqrestore(&percpu_counters_lock, flags);
 #endif
 
-	free_percpu(fbc[0].counters);
+	backing = fbc[0].counters;
 
 	for (i = 0; i < nr_counters; i++)
 		fbc[i].counters = NULL;
+
+	return backing;
+}
+
+void __percpu *percpu_counter_detach_many(struct percpu_counter *fbc,
+					  u32 nr_counters)
+{
+	void __percpu *backing = percpu_counter_detach_storage(fbc, nr_counters);
+	int cpu;
+
+	/* CPU-hotplug callbacks can no longer access these counters. */
+	if (backing)
+		for_each_possible_cpu(cpu)
+			memset(per_cpu_ptr(backing, cpu), 0,
+			       percpu_counter_many_size(nr_counters));
+	return backing;
+}
+
+void percpu_counter_free_many_backing(void __percpu *backing)
+{
+	free_percpu(backing);
+}
+
+void percpu_counter_destroy_many(struct percpu_counter *fbc, u32 nr_counters)
+{
+	void __percpu *backing;
+
+	/* Ordinary destruction need not zero storage that will be freed. */
+	backing = percpu_counter_detach_storage(fbc, nr_counters);
+	percpu_counter_free_many_backing(backing);
 }
 EXPORT_SYMBOL(percpu_counter_destroy_many);
 
