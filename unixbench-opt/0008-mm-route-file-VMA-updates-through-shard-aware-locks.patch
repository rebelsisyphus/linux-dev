 	switch (entry) {
 	case NORMAL_PMD:
@@ -523,7 +584,11 @@ static bool move_pgt_entry(enum pgt_entry entry, struct vm_area_struct *vma,
 	}
 
 	if (need_rmap_locks)
+#ifdef CONFIG_I_MMAP_SHARDS
+		drop_rmap_locks(vma, &i_mmap_lock);
