+#ifdef CONFIG_I_MMAP_SHARDS
+	struct i_mmap_write_lock i_mmap_lock;
+#endif
 	bool moved = false;
 
 	/* See comment in move_ptes() */
 	if (need_rmap_locks)
+#ifdef CONFIG_I_MMAP_SHARDS
+		take_rmap_locks(vma, &i_mmap_lock);
+#else
 		take_rmap_locks(vma);
