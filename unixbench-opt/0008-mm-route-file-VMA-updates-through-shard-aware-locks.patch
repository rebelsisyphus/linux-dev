 		/*
 		 * split_vma has split insert from vma, and needs
@@ -717,7 +830,11 @@ static inline void vma_complete(struct vma_prepare *vp,
 	}
 
 	if (vp->file) {
+#ifdef CONFIG_I_MMAP_SHARDS
+		i_mmap_unlock_write_vma(vp->mapping, &vp->i_mmap_lock);
+#else
