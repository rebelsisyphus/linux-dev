 arch/arm/mm/flush.c        | 78 +++++++++++++++++--------------
 arch/nios2/mm/cacheflush.c | 46 ++++++++++++-------
 arch/parisc/kernel/cache.c | 94 +++++++++++++++++++++-----------------
 include/linux/fs.h         |  2 +
 mm/mmap.c                  | 14 ++++++
