From 59dbb575db0f5b882f0ac55511034a7782bb68b5 Mon Sep 17 00:00:00 2001
Message-ID: <59dbb575db0f5b882f0ac55511034a7782bb68b5.1786678766.git.dongchenchen2@huawei.com>
In-Reply-To: <cover.1786678766.git.dongchenchen2@huawei.com>
References: <cover.1786678766.git.dongchenchen2@huawei.com>
From: Dong Chenchen <dongchenchen2@huawei.com>
Date: Fri, 24 Jul 2026 16:24:48 +0800
Subject: [PATCH openEuler-26.09 17/22] mm: hold all i_mmap shards for locked file rmap

hulk inclusion
category: feature
bugzilla: https://atomgit.com/openeuler/kernel/issues/9771

--------------------------------

File folio splitting passes TTU_RMAP_LOCKED into try_to_unmap(), so the
caller must keep the complete file reverse-mapping lock set held across the
operation. A central read lock does not exclude sharded VMA updates.

Add an explicit all-root read-lock context with publication rechecking and
reverse-order release. Use it around file folio splitting so the existing
rmap_walk_locked() contract remains valid after sharding.

Signed-off-by: Dong Chenchen <dongchenchen2@huawei.com>
---
 include/linux/fs.h | 11 +++++++++++
 mm/huge_memory.c   |  5 +++--
 mm/mmap.c          | 40 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/include/linux/fs.h b/include/linux/fs.h
index 235bb8cb455d..a135c440c56d 100644
--- a/include/linux/fs.h
+++ b/include/linux/fs.h
@@ -507,6 +507,13 @@ struct i_mmap_write_lock {
 #endif
 };
 
+struct i_mmap_read_lock {
+	bool central;
+#ifdef CONFIG_I_MMAP_SHARDS
+	struct i_mmap_shards *shards;
+#endif
+};
+
 typedef int (*i_mmap_walk_fn)(struct vm_area_struct *vma, void *arg);
 
 int i_mmap_read_walk(struct address_space *mapping, pgoff_t first,
@@ -516,6 +523,10 @@ int i_mmap_walk_locked(struct address_space *mapping, pgoff_t first,
 		       pgoff_t last, i_mmap_walk_fn fn, void *arg);
 int i_mmap_walk_dcache_locked(struct address_space *mapping, pgoff_t first,
 			      pgoff_t last, i_mmap_walk_fn fn, void *arg);
+void i_mmap_lock_read_all(struct address_space *mapping,
+			  struct i_mmap_read_lock *lock);
+void i_mmap_unlock_read_all(struct address_space *mapping,
+			    struct i_mmap_read_lock *lock);
 
 /**
  * struct address_space - Contents of a cacheable, mappable object.
diff --git a/mm/huge_memory.c b/mm/huge_memory.c
index 2bd84157869e..c67e2a12d033 100644
--- a/mm/huge_memory.c
+++ b/mm/huge_memory.c
@@ -3591,6 +3591,7 @@ int split_huge_page_to_list_to_order(struct page *page, struct list_head *list,
 	bool is_anon = folio_test_anon(folio);
 	struct address_space *mapping = NULL;
 	struct anon_vma *anon_vma = NULL;
+	struct i_mmap_read_lock i_mmap_lock;
 	int order = folio_order(folio);
 	int extra_pins, ret;
 	pgoff_t end;
@@ -3685,7 +3686,7 @@ int split_huge_page_to_list_to_order(struct page *page, struct list_head *list,
 		}
 
 		anon_vma = NULL;
-		i_mmap_lock_read(mapping);
+		i_mmap_lock_read_all(mapping, &i_mmap_lock);
 
 		/*
 		 *__split_huge_page() may need to trim off pages beyond EOF:
@@ -3777,7 +3778,7 @@ int split_huge_page_to_list_to_order(struct page *page, struct list_head *list,
 		put_anon_vma(anon_vma);
 	}
 	if (mapping)
-		i_mmap_unlock_read(mapping);
+		i_mmap_unlock_read_all(mapping, &i_mmap_lock);
 out:
 	xas_destroy(&xas);
 	if (order == HPAGE_PMD_ORDER)
diff --git a/mm/mmap.c b/mm/mmap.c
index 7e5421159278..7391751a8629 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -290,6 +290,46 @@ static int i_mmap_walk_shards_locked(struct i_mmap_shards *shards,
 }
 #endif
 
+void i_mmap_lock_read_all(struct address_space *mapping,
+			  struct i_mmap_read_lock *lock)
+{
+#ifdef CONFIG_I_MMAP_SHARDS
+	struct i_mmap_shards *shards;
+
+	lock->central = false;
+	lock->shards = NULL;
+	shards = i_mmap_shards_load(mapping);
+	if (!shards) {
+		i_mmap_lock_read(mapping);
+		shards = i_mmap_shards_load(mapping);
+		if (!shards) {
+			lock->central = true;
+			return;
+		}
+		i_mmap_unlock_read(mapping);
+	}
+
+	i_mmap_lock_shards_read(shards, false);
+	lock->shards = shards;
+#else
+	i_mmap_lock_read(mapping);
+	lock->central = true;
+#endif
+}
+
+void i_mmap_unlock_read_all(struct address_space *mapping,
+			    struct i_mmap_read_lock *lock)
+{
+#ifdef CONFIG_I_MMAP_SHARDS
+	if (lock->shards) {
+		i_mmap_unlock_shards_read(lock->shards);
+		return;
+	}
+#endif
+	VM_WARN_ON_ONCE(!lock->central);
+	i_mmap_unlock_read(mapping);
+}
+
 int i_mmap_read_walk(struct address_space *mapping, pgoff_t first,
 		     pgoff_t last, bool try_lock, i_mmap_walk_fn fn,
 		     void *arg)
-- 
