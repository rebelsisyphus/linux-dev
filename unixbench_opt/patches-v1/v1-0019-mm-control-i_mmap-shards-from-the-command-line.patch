diff --git a/Documentation/admin-guide/kernel-parameters.txt b/Documentation/admin-guide/kernel-parameters.txt
index 90aae84c850a..d7ceb876cb3a 100644
--- a/Documentation/admin-guide/kernel-parameters.txt
+++ b/Documentation/admin-guide/kernel-parameters.txt
@@ -1914,6 +1914,13 @@
 
 	i810=		[HW,DRM]
 
+	i_mmap_shards=	[KNL]
+			Format: <bool>
+			Control NUMA-local sharding of regular-file reverse
+			mapping trees. This option is available when
+			CONFIG_I_MMAP_SHARDS=y and defaults to off. Specify on
+			to enable dynamic sharding after lock contention.
+
 	i915.invert_brightness=
 			[DRM] Invert the sense of the variable that is used to
 			set the brightness of the panel backlight. Normally a
diff --git a/fs/inode.c b/fs/inode.c
index 7f6a23549e38..605d3042ff67 100644
--- a/fs/inode.c
+++ b/fs/inode.c
@@ -284,8 +284,10 @@ void __destroy_inode(struct inode *inode)
 #ifdef CONFIG_I_MMAP_SHARDS
 	struct address_space *mapping = inode->i_mapping;
 
-	i_mmap_shards_free(mapping->i_mmap_shards);
-	mapping->i_mmap_shards = NULL;
+	if (i_mmap_shards_enabled()) {
+		i_mmap_shards_free(mapping->i_mmap_shards);
+		mapping->i_mmap_shards = NULL;
+	}
 #endif
 	BUG_ON(inode_has_buffers(inode));
 	inode_detach_wb(inode);
@@ -408,9 +410,11 @@ static void __address_space_init_once(struct address_space *mapping)
 	spin_lock_init(&mapping->private_lock);
 	mapping->i_mmap = RB_ROOT_CACHED;
 #ifdef CONFIG_I_MMAP_SHARDS
-	mapping->i_mmap_shards = NULL;
-	atomic_set(&mapping->i_mmap_nr_vmas, 0);
-	atomic_set(&mapping->i_mmap_lock_contention, 0);
+	if (i_mmap_shards_enabled()) {
+		mapping->i_mmap_shards = NULL;
+		atomic_set(&mapping->i_mmap_nr_vmas, 0);
+		atomic_set(&mapping->i_mmap_lock_contention, 0);
+	}
 #endif
 }
 
diff --git a/include/linux/fs.h b/include/linux/fs.h
index a135c440c56d..ce490946deca 100644
--- a/include/linux/fs.h
+++ b/include/linux/fs.h
@@ -16,6 +16,7 @@
 #include <linux/xarray.h>
 #include <linux/rbtree.h>
 #include <linux/init.h>
+#include <linux/jump_label.h>
 #include <linux/pid.h>
 #include <linux/bug.h>
 #include <linux/mutex.h>
@@ -492,6 +493,13 @@ struct i_mmap_shards {
 	struct i_mmap_domain_shards *domain[I_MMAP_MAX_DOMAINS];
 };
 
+DECLARE_STATIC_KEY_FALSE(i_mmap_shards_enabled_key);
+
+static inline bool i_mmap_shards_enabled(void)
+{
+	return static_branch_unlikely(&i_mmap_shards_enabled_key);
+}
+
 struct i_mmap_shards *i_mmap_shards_alloc(gfp_t gfp);
 void i_mmap_shards_free(struct i_mmap_shards *shards);
 struct i_mmap_shard *i_mmap_shard_for_vma(struct i_mmap_shards *shards,
@@ -502,9 +510,6 @@ bool i_mmap_shards_install_locked(struct address_space *mapping,
 
 struct i_mmap_write_lock {
 	struct rb_root_cached	*root;
-#ifdef CONFIG_I_MMAP_SHARDS
-	struct i_mmap_shard	*shard;
-#endif
 };
 
 struct i_mmap_read_lock {
@@ -648,33 +653,64 @@ static inline void i_mmap_assert_write_locked(struct address_space *mapping)
 }
 
 #ifdef CONFIG_I_MMAP_SHARDS
-void i_mmap_lock_write_vma(struct address_space *mapping,
-			   struct vm_area_struct *vma,
-			   struct i_mmap_write_lock *lock);
-void i_mmap_unlock_write_vma(struct address_space *mapping,
+void __i_mmap_lock_write_vma(struct address_space *mapping,
+			     struct vm_area_struct *vma,
 			     struct i_mmap_write_lock *lock);
+void __i_mmap_unlock_write_vma(struct address_space *mapping,
+			       struct i_mmap_write_lock *lock);
+
+static inline void i_mmap_lock_write_vma(struct address_space *mapping,
+					 struct vm_area_struct *vma,
+					 struct i_mmap_write_lock *lock)
+{
+	if (i_mmap_shards_enabled()) {
+		__i_mmap_lock_write_vma(mapping, vma, lock);
+		return;
+	}
+
+	i_mmap_lock_write(mapping);
+	lock->root = &mapping->i_mmap;
+}
+
+static inline void i_mmap_unlock_write_vma(struct address_space *mapping,
+					   struct i_mmap_write_lock *lock)
+{
+	if (i_mmap_shards_enabled()) {
+		__i_mmap_unlock_write_vma(mapping, lock);
+		return;
+	}
+
+	i_mmap_unlock_write(mapping);
+}
 
 static inline bool
-i_mmap_write_lock_is_sharded(struct i_mmap_write_lock *lock)
+i_mmap_write_lock_is_sharded(struct address_space *mapping,
+			     struct i_mmap_write_lock *lock)
 {
-	return lock->shard;
+	return i_mmap_shards_enabled() &&
+		lock->root != &mapping->i_mmap;
 }
 
 static inline struct i_mmap_shards *
 i_mmap_shards_load(struct address_space *mapping)
 {
+	if (!i_mmap_shards_enabled())
+		return NULL;
+
 	/* Pairs with release publication after all roots are initialized. */
 	return smp_load_acquire(&mapping->i_mmap_shards);
 }
 
 static inline void i_mmap_vma_count_add(struct address_space *mapping)
 {
-	atomic_inc(&mapping->i_mmap_nr_vmas);
+	if (i_mmap_shards_enabled())
+		atomic_inc(&mapping->i_mmap_nr_vmas);
 }
 
 static inline void i_mmap_vma_count_sub(struct address_space *mapping)
 {
-	atomic_dec(&mapping->i_mmap_nr_vmas);
+	if (i_mmap_shards_enabled())
+		atomic_dec(&mapping->i_mmap_nr_vmas);
 }
 #else
 static inline void i_mmap_lock_write_vma(struct address_space *mapping,
@@ -692,7 +728,8 @@ static inline void i_mmap_unlock_write_vma(struct address_space *mapping,
 }
 
 static inline bool
-i_mmap_write_lock_is_sharded(struct i_mmap_write_lock *lock)
+i_mmap_write_lock_is_sharded(struct address_space *mapping,
+			     struct i_mmap_write_lock *lock)
 {
 	return false;
 }
@@ -712,7 +749,8 @@ static inline void i_mmap_vma_count_sub(struct address_space *mapping)
 static inline int mapping_mapped(struct address_space *mapping)
 {
 #ifdef CONFIG_I_MMAP_SHARDS
-	if (atomic_read(&mapping->i_mmap_nr_vmas) > 0)
+	if (i_mmap_shards_enabled() &&
+	    atomic_read(&mapping->i_mmap_nr_vmas) > 0)
 		return true;
 #endif
 	return	!RB_EMPTY_ROOT(&mapping->i_mmap.rb_root);
diff --git a/kernel/fork.c b/kernel/fork.c
index a3d6749fb74e..cfebc427fa09 100644
--- a/kernel/fork.c
+++ b/kernel/fork.c
@@ -700,7 +700,7 @@ static void dup_mmap_file_batch_flush(struct dup_mmap_file_batch *batch)
 	for (i = 0; i < batch->count; i++) {
 		if (batch->vmas[i]->vm_flags & VM_SHARED)
 			mapping_allow_writable(mapping);
-		if (i_mmap_write_lock_is_sharded(&lock))
+		if (i_mmap_write_lock_is_sharded(mapping, &lock))
 			vma_interval_tree_insert(batch->vmas[i], lock.root);
 		else
 			vma_interval_tree_insert_after(batch->vmas[i],
@@ -1469,7 +1469,8 @@ static struct mm_struct *mm_init(struct mm_struct *mm, struct task_struct *p,
 	atomic64_set(&mm->pinned_vm, 0);
 	memset(&mm->rss_stat, 0, sizeof(mm->rss_stat));
 #ifdef CONFIG_I_MMAP_SHARDS
-	mm->i_mmap_home_nid = numa_node_id();
+	if (i_mmap_shards_enabled())
+		mm->i_mmap_home_nid = numa_node_id();
 #endif
 	reliable_clear_page_counter(mm);
 	spin_lock_init(&mm->page_table_lock);
diff --git a/mm/Kconfig b/mm/Kconfig
index 29c7df3f2dc2..c04abce55547 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -3,15 +3,16 @@
 menu "Memory Management options"
 
 config I_MMAP_SHARDS
-	bool "Experimental sharded file reverse mappings"
-	depends on MMU && SMP && NUMA && EXPERT
-	default n
+	bool
+	depends on MMU && SMP && NUMA
+	default y
 	help
-	  Split contended regular-file reverse mapping interval trees into
-	  NUMA-local shards. This is intended for machines with highly
-	  concurrent fork, exec, mmap, and exit workloads.
+	  Build support for splitting contended regular-file reverse mapping
+	  interval trees into NUMA-local shards. This is an internal platform
+	  capability rather than a user-selectable feature switch.
 
-	  This feature is experimental. If unsure, say N.
+	  Sharding is disabled by default and can only be enabled with
+	  i_mmap_shards=on on the kernel command line.
 
 #
 # For some reason microblaze and nios2 hard code SWAP=n.  Hopefully we can
diff --git a/mm/mmap.c b/mm/mmap.c
index a0bfcaf31abe..0086fee62cce 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -37,6 +37,7 @@
 #include <linux/perf_event.h>
 #include <linux/audit.h>
 #include <linux/khugepaged.h>
+#include <linux/kstrtox.h>
 #include <linux/uprobes.h>
 #include <linux/notifier.h>
 #include <linux/memory.h>
@@ -69,6 +70,25 @@
 #ifdef CONFIG_I_MMAP_SHARDS
 #define I_MMAP_SHARD_CONTENTION_THRESHOLD	4
 
+DEFINE_STATIC_KEY_FALSE_RO(i_mmap_shards_enabled_key);
+EXPORT_SYMBOL_GPL(i_mmap_shards_enabled_key);
+
+static int __init i_mmap_shards_setup(char *str)
+{
+	bool enabled;
+	int ret;
+
+	ret = kstrtobool(str, &enabled);
+	if (ret)
+		return ret;
+	if (enabled)
+		static_branch_enable(&i_mmap_shards_enabled_key);
+	else
+		static_branch_disable(&i_mmap_shards_enabled_key);
+	return 0;
+}
+early_param("i_mmap_shards", i_mmap_shards_setup);
+
 static struct lock_class_key i_mmap_shard_lock_keys[I_MMAP_MAX_SHARDS];
 
 struct i_mmap_shards *i_mmap_shards_alloc(gfp_t gfp)
@@ -201,14 +221,14 @@ static void i_mmap_install_shards(struct address_space *mapping)
 	i_mmap_shards_free(shards);
 }
 
-void i_mmap_lock_write_vma(struct address_space *mapping,
-			   struct vm_area_struct *vma,
-			   struct i_mmap_write_lock *lock)
+void __i_mmap_lock_write_vma(struct address_space *mapping,
+			     struct vm_area_struct *vma,
+			     struct i_mmap_write_lock *lock)
 {
 	struct i_mmap_shards *shards;
+	struct i_mmap_shard *shard;
 
 retry:
-	lock->shard = NULL;
 	lock->root = &mapping->i_mmap;
 	shards = i_mmap_shards_load(mapping);
 	if (!shards) {
@@ -234,18 +254,23 @@ void i_mmap_lock_write_vma(struct address_space *mapping,
 	}
 
 lock_shard:
-	lock->shard = i_mmap_shard_for_vma(shards, vma);
-	lock->root = &lock->shard->root;
-	down_write(&lock->shard->rwsem);
+	shard = i_mmap_shard_for_vma(shards, vma);
+	lock->root = &shard->root;
+	down_write(&shard->rwsem);
 }
 
-void i_mmap_unlock_write_vma(struct address_space *mapping,
-			     struct i_mmap_write_lock *lock)
+void __i_mmap_unlock_write_vma(struct address_space *mapping,
+			       struct i_mmap_write_lock *lock)
 {
-	if (lock->shard)
-		up_write(&lock->shard->rwsem);
-	else
+	struct i_mmap_shard *shard;
+
+	if (lock->root == &mapping->i_mmap) {
 		i_mmap_unlock_write(mapping);
+		return;
+	}
+
+	shard = container_of(lock->root, struct i_mmap_shard, root);
+	up_write(&shard->rwsem);
 }
 
 bool i_mmap_shards_install_locked(struct address_space *mapping,
@@ -255,7 +280,7 @@ bool i_mmap_shards_install_locked(struct address_space *mapping,
 	struct i_mmap_shard *shard;
 
 	i_mmap_assert_write_locked(mapping);
-	if (i_mmap_shards_load(mapping))
+	if (!i_mmap_shards_enabled() || i_mmap_shards_load(mapping))
 		return false;
 
 	flush_dcache_mmap_lock(mapping);
